@model GymManagement.Models.MembershipPackage
@{
    ViewData["Title"] = "Chỉnh sửa gói dịch vụ";
    Layout = "_OwnerAdminLayout";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" asp-route-gymId="@Model.GymId" class="btn-owner-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="content-card">
            <div class="content-card-header">
                <h5><i class="bi bi-pencil-square me-2" style="color:#6366f1;"></i>Chỉnh sửa gói</h5>
            </div>
            <div class="content-card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="owner-form-group">
                        <label>Phòng Gym</label>
                        <input type="text" class="form-control" value="@Model.Gym?.Name" disabled style="background:#f8f9fa;color:#888;" />
                    </div>

                    <div class="owner-form-group">
                        <label asp-for="Name">Tên gói <span style="color:#ef4444;">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="owner-form-group">
                        <label asp-for="PackageType">Loại gói</label>
                        <select asp-for="PackageType" class="form-control" id="packageTypeSelect" onchange="toggleDuration()">
                            <option value="Daily">Daily (Theo ngày)</option>
                            <option value="Monthly">Monthly (Theo tháng)</option>
                        </select>
                    </div>

                    <div class="owner-form-group" id="durationGroup">
                        <label asp-for="DurationInMonths">Số tháng</label>
                        <input asp-for="DurationInMonths" type="number" min="1" max="120" class="form-control" />
                        <span asp-validation-for="DurationInMonths" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="owner-form-group">
                        <label asp-for="Price">Giá (VNĐ) <span style="color:#ef4444;">*</span></label>
                        <input type="text" id="priceDisplayInput" class="form-control" autocomplete="off" />
                        <input type="hidden" asp-for="Price" id="priceRealInput" />
                        <span asp-validation-for="Price" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="owner-form-group">
                        <label class="d-flex align-items-center gap-2" style="cursor:pointer;user-select:none;">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" style="width:18px;height:18px;margin:0;" />
                            <span style="font-weight:600;color:#374151;">Đang hoạt động</span>
                        </label>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn-owner-primary flex-grow-1">
                            <i class="bi bi-floppy"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Index" asp-route-gymId="@Model.GymId" class="btn-owner-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function toggleDuration() {
            const type = document.getElementById('packageTypeSelect').value;
            document.getElementById('durationGroup').style.display = type === 'Monthly' ? '' : 'none';
        }
        toggleDuration();

        const displayInput = document.getElementById('priceDisplayInput');
        const realInput = document.getElementById('priceRealInput');

        if (realInput.value) {
            displayInput.value = Number(realInput.value).toLocaleString('en-US');
        }

        displayInput.addEventListener('input', function (e) {
            let rawValue = e.target.value.replace(/,/g, '').replace(/\D/g, '');
            if (rawValue) {
                realInput.value = rawValue;
                e.target.value = Number(rawValue).toLocaleString('en-US');
            } else {
                realInput.value = '';
                e.target.value = '';
            }
        });
    </script>
}
