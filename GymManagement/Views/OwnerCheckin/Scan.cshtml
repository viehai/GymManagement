@model GymManagement.ViewModels.CheckinScanViewModel

@{
    ViewData["Title"] = "Quầy Check-in & Điểm Danh Vào Tập";
    Layout = "_OwnerAdminLayout";
}

@Html.AntiForgeryToken()

<style>
    /* ═══════════════════════════════════════════════
       OWNER CHECK-IN DESK — NIKE BRUTAL MINIMALISM
    ═══════════════════════════════════════════════ */
    .crowd-meter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .crowd-bar-track {
        height: 12px;
        background: #f1f5f9;
        border-radius: 999px;
        overflow: hidden;
        position: relative;
    }
    .crowd-bar-fill {
        height: 100%;
        border-radius: 999px;
        transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.5s ease;
    }

    .scanner-box {
        background: #0f172a;
        border: 2px dashed #334155;
        border-radius: 10px;
        position: relative;
        overflow: hidden;
        min-height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
    }
    .scanner-box video {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
    }

    .member-result-card {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: 1.25rem;
        transition: all 0.25s ease;
        background: #fafafa;
    }
    .member-result-card.valid {
        border-color: #10b981;
        background: #f0fdf4;
    }
    .member-result-card.invalid {
        border-color: #ef4444;
        background: #fef2f2;
    }
    .member-result-card.warning {
        border-color: #f59e0b;
        background: #fffbeb;
    }

    .btn-checkin-confirm {
        background: #10b981;
        color: #fff;
        border: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 1rem;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        width: 100%;
        letter-spacing: 0.5px;
        transition: all 0.2s;
    }
    .btn-checkin-confirm:hover {
        background: #059669;
        box-shadow: 0 8px 20px -4px rgba(16, 185, 129, 0.35);
        color: #fff;
    }

    .live-member-item {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        transition: background-color 0.15s;
    }
    .live-member-item:hover {
        background: #f8fafc;
    }
</style>

<div class="container-fluid py-2">
    <!-- Header & Gym Selector -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1 style="font-family:'Montserrat',sans-serif; font-size:1.35rem; font-weight:900; color:#111; margin:0 0 4px; letter-spacing:-0.5px;">
                QUẦY CHECK-IN VÀO TẬP & ĐIỂM DANH
            </h1>
            <p style="margin:0; font-size:0.85rem; color:#6b7280;">
                Quét mã QR qua Camera / Súng quét USB hoặc nhập Số điện thoại để xác nhận hội viên vào phòng tập.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Chọn cơ sở -->
            <form method="get" class="d-flex align-items-center gap-2">
                <label style="font-size:0.78rem; font-weight:700; color:#4b5563; white-space:nowrap;">
                    <i class="bi bi-building me-1"></i> Cơ sở:
                </label>
                <select name="gymId" class="form-select form-select-sm fw-bold" style="min-width:210px;" onchange="this.form.submit()">
                    @foreach (var g in Model.MyGyms)
                    {
                        <option value="@g.Id" selected="@(Model.SelectedGymId == g.Id)">@g.Name</option>
                    }
                </select>
            </form>

            <a asp-action="Kiosk" asp-route-gymId="@Model.SelectedGymId" target="_blank" class="btn btn-dark btn-sm fw-bold px-3" style="background:#0f172a; border-color:#0f172a;" title="Mở chế độ Kiosk toàn màn hình đặt tại cửa">
                <i class="bi bi-display me-1 text-info"></i> Mở Kiosk Face ID (V3)
            </a>
            <a asp-action="History" asp-route-gymId="@Model.SelectedGymId" class="btn btn-outline-dark btn-sm fw-bold px-3">
                <i class="bi bi-clock-history me-1"></i> Xem lịch sử check-in
            </a>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         THƯỚC ĐO ĐỘ ĐÔNG ĐÚC REAL-TIME (CROWD METER)
    ═══════════════════════════════════════════════ -->
    <div class="crowd-meter-card mb-4" id="crowdMeterCard">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div>
                <span style="font-family:'Montserrat',sans-serif; font-size:0.75rem; font-weight:800; text-transform:uppercase; color:#64748b; letter-spacing:1px;">
                    MỨC ĐỘ ĐÔNG ĐÚC HIỆN TẠI (SESSION TIMEOUT 2 GIỜ)
                </span>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span id="crowdStatusBadge" class="badge" style="background:@Model.CrowdStatusColor; font-size:0.82rem; font-weight:800; padding:6px 12px; border-radius:6px;">
                        <i id="crowdStatusIcon" class="bi @Model.CrowdStatusIcon me-1"></i>
                        <span id="crowdStatusText">@Model.CrowdStatusText</span>
                    </span>
                    <span style="font-size:0.85rem; color:#475569;" id="crowdRecommendation">
                        @Model.CrowdRecommendation
                    </span>
                </div>
            </div>

            <div class="text-end">
                <div style="font-family:'Montserrat',sans-serif; font-weight:900; font-size:1.5rem; color:#111;">
                    <span id="activeCountDisplay">@Model.ActiveCheckinsCount</span> / <span id="maxCapacityDisplay">@Model.MaxCapacity</span>
                    <span style="font-size:0.82rem; font-weight:600; color:#6b7280;">người (<span id="crowdPctDisplay">@Model.CrowdPercentage%</span>)</span>
                </div>
                <div style="font-size:0.72rem; color:#94a3b8;">
                    Tự động bốc hơi sau 120 phút tập
                </div>
            </div>
        </div>

        <!-- Progress Bar -->
        <div class="crowd-bar-track mt-3">
            <div id="crowdProgressBar" class="crowd-bar-fill" style="width: @Model.CrowdPercentage%; background: @Model.CrowdStatusColor;"></div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         BÀN CHECK-IN: CỘT QUÉT / TRA CỨU & CỘT KẾT QUẢ
    ═══════════════════════════════════════════════ -->
    <div class="row g-4">
        <!-- Cột 1: Phương thức quét QR / SĐT -->
        <div class="col-12 col-lg-6">
            <div class="content-card h-100 p-4">
                <!-- Nav Tabs các chế độ -->
                <ul class="nav nav-pills nav-fill mb-3" id="checkinTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" id="camera-tab" data-bs-toggle="pill" data-bs-target="#cameraTabContent" type="button" style="font-size:0.82rem;">
                            <i class="bi bi-camera-fill me-1"></i> Quét Camera
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="scanner-tab" data-bs-toggle="pill" data-bs-target="#scannerTabContent" type="button" style="font-size:0.82rem;">
                            <i class="bi bi-upc-scan me-1"></i> Súng quét USB
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="phone-tab" data-bs-toggle="pill" data-bs-target="#phoneTabContent" type="button" style="font-size:0.82rem;">
                            <i class="bi bi-telephone-fill me-1"></i> Tra cứu SĐT
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="facenet-tab" data-bs-toggle="pill" data-bs-target="#facenetTabContent" type="button" style="font-size:0.82rem; background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0;">
                            <i class="bi bi-person-bounding-box me-1"></i> Quét Face ID (V3)
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Tab 1: Camera Scanner -->
                    <div class="tab-pane fade show active" id="cameraTabContent">
                        <div class="scanner-box" id="qrReaderContainer">
                            <div id="qrReader" style="width:100%;"></div>
                        </div>

                        <!-- Lựa chọn Camera nếu có nhiều thiết bị -->
                        <div id="cameraSelectWrap" class="d-none mt-2">
                            <label class="small text-muted fw-bold mb-1" style="font-size:0.75rem;">
                                <i class="bi bi-camera-video me-1"></i>Chọn thiết bị Camera:
                            </label>
                            <select id="cameraSelect" class="form-select form-select-sm" style="font-size:0.8rem;"></select>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
                            <div class="d-flex gap-2">
                                <button type="button" id="btnToggleCamera" class="btn btn-dark btn-sm fw-bold px-3" style="border-radius:6px;">
                                    <i class="bi bi-camera-video me-1"></i> Bật Camera quét
                                </button>
                                <button type="button" id="btnUploadQr" class="btn btn-outline-secondary btn-sm fw-bold px-3" style="border-radius:6px;" title="Tải ảnh mã QR để quét thử hoặc giải mã khi camera bị lóa">
                                    <i class="bi bi-image me-1"></i> Tải ảnh QR
                                </button>
                                <input type="file" id="qrFileInput" accept="image/*" class="d-none" />
                            </div>
                            <span class="text-muted small">
                                <i class="bi bi-info-circle me-1"></i> Hướng camera vào mã QR của hội viên
                            </span>
                        </div>

                        <!-- Mẹo quét nhạy -->
                        <div class="alert alert-light border mt-3 p-2 small text-muted d-flex align-items-start gap-2" style="font-size:0.78rem; border-radius:6px; background:#f8fafc;">
                            <i class="bi bi-lightbulb-fill text-warning fs-6 mt-1 flex-shrink-0"></i>
                            <div>
                                <strong class="text-dark">Mẹo để camera quét nhanh và nhạy nhất:</strong>
                                <ul class="ps-3 mb-0 mt-1" style="line-height:1.4;">
                                    <li><strong>Khoảng cách:</strong> Giữ điện thoại cách camera <strong>25 - 35 cm</strong> (không dí quá sát tránh webcam laptop bị mờ out-nét).</li>
                                    <li><strong>Độ sáng màn hình:</strong> Giảm độ sáng điện thoại xuống khoảng <strong>50% - 70%</strong> hoặc nghiêng nhẹ để tránh màn hình bị lóa trắng vào camera.</li>
                                    <li>Mã QR chỉ cần nằm gọn trong khung hình là hệ thống tự nhận diện ngay!</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Súng quét mã QR / Barcode USB -->
                    <div class="tab-pane fade" id="scannerTabContent">
                        <div class="p-4 bg-light rounded text-center border">
                            <i class="bi bi-upc-scan fs-1 text-primary mb-2 d-block"></i>
                            <h6 class="fw-bold text-dark">Chế độ Súng quét USB Barcode/QR</h6>
                            <p class="small text-muted mb-3">
                                Cắm máy quét mã QR vào cổng USB máy tính. Khi máy quét tít vào mã QR của hội viên, hệ thống sẽ tự động xác thực ngay lập tức.
                            </p>
                            <input type="text" id="usbScannerInput" class="form-control text-center fw-bold" placeholder="Nhấp chuột vào đây rồi bóp cò súng quét..." style="font-size:1rem; letter-spacing:1px; border-radius:8px;" />
                        </div>
                    </div>

                    <!-- Tab 3: Tra cứu Số điện thoại thủ công -->
                    <div class="tab-pane fade" id="phoneTabContent">
                        <div class="p-3 bg-light rounded border">
                            <label class="fw-bold text-dark mb-1" style="font-size:0.85rem;">
                                Số điện thoại hoặc Tên hội viên:
                            </label>
                            <div class="input-group">
                                <input type="text" id="manualPhoneInput" class="form-control" placeholder="VD: 0912345678 hoặc Nguyễn Văn A..." />
                                <button type="button" id="btnSearchManual" class="btn btn-dark fw-bold px-3">
                                    <i class="bi bi-search me-1"></i> Tìm kiếm
                                </button>
                            </div>
                            <div class="form-text mt-1" style="font-size:0.75rem;">
                                Áp dụng cho hội viên quên điện thoại, hết pin hoặc không dùng smartphone.
                            </div>
                        </div>
                    </div>

                    <!-- Tab 4: FaceNet Face Recognition -->
                    <div class="tab-pane fade" id="facenetTabContent">
                        <div class="scanner-box position-relative" id="faceNetContainer" style="min-height:300px; background:#020617; overflow:hidden;">
                            <video id="ownerFaceVideo" autoplay playsinline muted style="width:100%; height:100%; object-fit:cover; transform:scaleX(-1);"></video>
                            <canvas id="ownerFaceCanvas" style="position:absolute; top:0; left:0; width:100%; height:100%; transform:scaleX(-1);"></canvas>
                            <div class="face-oval-guide" id="ownerFaceOval" style="position:absolute; width:190px; height:250px; border:3px dashed rgba(56,189,248,0.5); border-radius:50%/60% 60% 40% 40%; pointer-events:none; box-shadow:0 0 0 9999px rgba(0,0,0,0.35);"></div>
                            <div id="facePlaceholder" class="d-flex flex-column align-items-center justify-content-center text-secondary">
                                <i class="bi bi-person-bounding-box fs-1 mb-2 text-info"></i>
                                <span class="small fw-bold">Camera Face ID chưa bật</span>
                                <span class="text-muted" style="font-size:0.7rem;">Sử dụng webcam laptop để nhận diện hội viên</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
                            <div class="d-flex gap-2">
                                <button type="button" id="btnToggleFaceNet" class="btn btn-dark btn-sm fw-bold px-3" style="border-radius:6px; background:#0f172a; border-color:#334155;">
                                    <i class="bi bi-camera-video me-1 text-info"></i> Bật Camera Face ID
                                </button>
                            </div>
                            <span id="faceNetStatus" class="small text-muted fw-bold">
                                Sẵn sàng
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Tùy chọn: Tự động xác nhận vào tập sau khi quét thành công -->
                <div class="form-check form-switch mt-4 pt-3 border-top">
                    <input class="form-check-input" type="checkbox" id="autoConfirmCheck" checked>
                    <label class="form-check-label fw-bold text-dark" for="autoConfirmCheck" style="font-size:0.82rem;">
                        Tự động xác nhận cho vào tập ngay khi quét QR hợp lệ (Fast Pass)
                    </label>
                </div>
            </div>
        </div>

        <!-- Cột 2: Thẻ hiển thị Kết quả xác thực Hội viên -->
        <div class="col-12 col-lg-6">
            <div class="content-card h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                    <h5 style="font-family:'Montserrat',sans-serif; font-weight:800; font-size:1.05rem; color:#111; margin-bottom:1rem;">
                        <i class="bi bi-person-badge-fill text-primary me-2"></i>Thông tin Hội viên
                    </h5>

                    <!-- Placeholder khi chưa quét -->
                    <div id="verifyPlaceholder" class="text-center py-5 text-muted">
                        <i class="bi bi-qr-code-scan fs-1 d-block mb-2 text-secondary"></i>
                        <h6 class="fw-bold text-dark">Chưa có dữ liệu quét</h6>
                        <p class="small text-muted mb-0">Hãy quét mã QR hoặc nhập số điện thoại của hội viên để kiểm tra gói tập.</p>
                    </div>

                    <!-- Card kết quả sau khi quét -->
                    <div id="verifyResultCard" class="member-result-card d-none">
                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h4 id="resFullName" style="font-family:'Montserrat',sans-serif; font-weight:900; margin:0; color:#111; font-size:1.25rem;">
                                        —
                                    </h4>
                                    <span id="resVipBadge" class="badge" style="background:#64748b; font-size:0.7rem; font-weight:800;">
                                        Standard
                                    </span>
                                </div>
                                <div style="font-size:0.82rem; color:#475569; margin-top:2px;">
                                    <i class="bi bi-telephone-fill me-1"></i> <span id="resPhone">—</span> &bull; 
                                    <i class="bi bi-envelope me-1"></i> <span id="resEmail">—</span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span id="resStatusBadge" class="badge bg-success" style="font-size:0.75rem; padding:5px 10px;">
                                    Hợp lệ
                                </span>
                            </div>
                        </div>

                        <!-- Thông tin gói tập -->
                        <div class="p-3 bg-white rounded border mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span style="font-size:0.75rem; font-weight:700; color:#64748b; text-transform:uppercase;">Gói tập áp dụng</span>
                                <span id="resDaysRemaining" class="badge bg-light text-dark border fw-bold" style="font-size:0.72rem;">
                                    Còn — ngày
                                </span>
                            </div>

                            <!-- 1 Gói duy nhất -->
                            <div id="resSinglePackageWrap">
                                <div id="resPackageName" style="font-weight:800; font-size:1rem; color:#111;">
                                    —
                                </div>
                                <div style="font-size:0.75rem; color:#64748b;" id="resPackageValidity">
                                    Hạn sử dụng: —
                                </div>
                            </div>

                            <!-- Nhiều hơn 1 gói: Hiển thị Dropdown cho Lễ tân chọn -->
                            <div id="resMultiPackageWrap" class="d-none mt-1">
                                <label class="small fw-bold text-dark mb-1" style="font-size:0.78rem;">
                                    <i class="bi bi-ui-checks me-1 text-primary"></i>Hội viên có <span id="resMultiPackageCount">2</span> gói còn hạn — Chọn gói điểm danh:
                                </label>
                                <select id="resPackageSelect" class="form-select form-select-sm fw-bold border-primary" style="font-size:0.85rem;" onchange="onPackageSelectChange(this)">
                                </select>
                                <div style="font-size:0.72rem; color:#64748b; margin-top:4px;" id="resMultiPackageValidity">
                                </div>
                            </div>
                        </div>

                        <!-- Thông báo / Cảnh báo -->
                        <div id="resAlertBox" class="alert p-2 mb-3 small d-flex align-items-center gap-2" style="border-radius:6px;">
                            <i id="resAlertIcon" class="bi bi-check-circle-fill fs-5"></i>
                            <span id="resAlertMessage">Sẵn sàng vào tập!</span>
                        </div>
                    </div>
                </div>

                <!-- Nút Xác nhận Check-in -->
                <div class="mt-3">
                    <button type="button" id="btnConfirmCheckin" class="btn-checkin-confirm d-none">
                        <i class="bi bi-box-arrow-in-right me-1"></i> XÁC NHẬN CHO VÀO TẬP
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         DANH SÁCH HỘI VIÊN ĐANG TRONG PHÒNG TẬP (LIVE)
    ═══════════════════════════════════════════════ -->
    <div class="content-card mt-4 p-0">
        <div class="content-card-header d-flex align-items-center justify-content-between p-3 border-bottom flex-wrap gap-2">
            <div>
                <h5 class="content-card-title mb-0" style="font-size:0.95rem; font-weight:800;">
                    <i class="bi bi-people-fill text-success me-2"></i>Hội viên đang trong phòng tập (<span id="liveTableCount">@Model.ActiveMembersInGym.Count</span> người)
                </h5>
                <div style="font-size:0.74rem; color:#64748b;">
                    Danh sách các lượt check-in trong vòng 2 giờ qua chưa check-out.
                </div>
            </div>
            <span class="badge bg-light text-dark border">Cập nhật tự động</span>
        </div>

        <div id="liveMembersContainer" style="max-height:360px; overflow-y:auto;">
            @if (!Model.ActiveMembersInGym.Any())
            {
                <div id="emptyLiveMembers" class="text-center py-4 text-muted small">
                    Chưa có hội viên nào check-in vào tập trong 2 tiếng vừa qua.
                </div>
            }
            else
            {
                <div id="liveMembersList">
                    @foreach (var m in Model.ActiveMembersInGym)
                    {
                        <div class="live-member-item" id="checkin-row-@m.CheckinId">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:38px; height:38px; border-radius:50%; background:#f1f5f9; display:flex; align-items:center; justify-content:center; font-weight:800; color:#111; font-size:0.85rem;">
                                    @m.MemberName.Substring(0, Math.Min(1, m.MemberName.Length)).ToUpper()
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size:0.88rem;">
                                        @m.MemberName
                                        <span class="badge ms-1" style="background:@m.VipBadgeColor; font-size:0.65rem;">@m.VipTierName</span>
                                    </div>
                                    <div style="font-size:0.74rem; color:#64748b;">
                                        @m.PackageName &bull; Vào lúc <strong>@m.CheckinTime.ToString("HH:mm")</strong> (@(m.MinutesAgo == 0 ? "Vừa xong" : $"{m.MinutesAgo} phút trước"))
                                    </div>
                                </div>
                            </div>

                            <div>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" style="font-size:0.72rem; border-radius:4px;" onclick="checkoutEarly(@m.CheckinId, '@Html.Raw(m.MemberName.Replace("'", "\\'"))')">
                                    <i class="bi bi-box-arrow-right me-1"></i> Check-out sớm
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- HTML5 QR Code Library CDN -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<!-- Face-api.js Library CDN -->
<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>

<script>
    var currentGymId = @Model.SelectedGymId;
    var html5QrCode = null;
    var isCameraRunning = false;
    var currentVerifyData = null;
    var lastScannedCode = "";
    var lastScannedTime = 0;

    // Web Audio Beep generator
    function playBeep(success) {
        try {
            var ctx = new (window.AudioContext || window.webkitAudioContext)();
            var osc = ctx.createOscillator();
            var gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);

            if (success) {
                osc.frequency.setValueAtTime(880, ctx.currentTime); // A5 (High pleasant beep)
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                osc.start();
                osc.stop(ctx.currentTime + 0.15);
            } else {
                osc.frequency.setValueAtTime(220, ctx.currentTime); // A3 (Low alert buzz)
                gain.gain.setValueAtTime(0.25, ctx.currentTime);
                osc.start();
                osc.stop(ctx.currentTime + 0.35);
            }
        } catch(e) {
            console.log('Audio not supported or blocked');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

        // ── 1. Camera Initialization & Toggle ──
        var btnToggleCam = document.getElementById('btnToggleCamera');
        var cameraSelect = document.getElementById('cameraSelect');
        var cameraSelectWrap = document.getElementById('cameraSelectWrap');
        var selectedCameraId = null;

        // Tự động kiểm tra danh sách Camera trên máy
        Html5Qrcode.getCameras().then(function(cameras) {
            if (cameras && cameras.length > 1) {
                cameraSelect.innerHTML = '';
                cameras.forEach(function(cam, idx) {
                    var opt = document.createElement('option');
                    opt.value = cam.id;
                    opt.text = cam.label || ('Camera ' + (idx + 1));
                    cameraSelect.appendChild(opt);
                });
                cameraSelectWrap.classList.remove('d-none');
                selectedCameraId = cameras[0].id;

                cameraSelect.addEventListener('change', function() {
                    selectedCameraId = cameraSelect.value;
                    if (isCameraRunning) {
                        stopCamera().then(function() {
                            startCamera();
                        });
                    }
                });
            }
        }).catch(function(err) {
            console.log('Không thể liệt kê danh sách camera:', err);
        });

        btnToggleCam.addEventListener('click', function() {
            if (!isCameraRunning) {
                startCamera();
            } else {
                stopCamera();
            }
        });

        // Tải ảnh QR quét trực tiếp (Hỗ trợ khi camera bị chói lóa màn hình)
        var btnUploadQr = document.getElementById('btnUploadQr');
        var qrFileInput = document.getElementById('qrFileInput');
        btnUploadQr.addEventListener('click', function() {
            qrFileInput.click();
        });

        qrFileInput.addEventListener('change', async function(e) {
            if (!e.target.files || e.target.files.length === 0) return;
            var file = e.target.files[0];

            btnUploadQr.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang đọc...';
            btnUploadQr.disabled = true;

            try {
                var decodedText = await decodeQrImageSmart(file);
                if (decodedText) {
                    onQrScanSuccess(decodedText);
                } else {
                    alert('Không tìm thấy mã QR trong ảnh này. Vui lòng thử chọn một ảnh có mã QR rõ nét hơn.');
                }
            } catch (err) {
                console.error('Lỗi nhận diện ảnh QR:', err);
                alert('Không nhận diện được mã QR từ file ảnh này: ' + (err.message || err));
            } finally {
                btnUploadQr.innerHTML = '<i class="bi bi-image me-1"></i> Tải ảnh QR';
                btnUploadQr.disabled = false;
                qrFileInput.value = '';
            }
        });

        // Giải mã thông minh: Kết hợp BarcodeDetector gốc của Chrome/Edge + Tự động bồi lề trắng Quiet Zone cho ZXing
        async function decodeQrImageSmart(file) {
            // Bước 1: Thử BarcodeDetector gốc của Chromium (Siêu nhanh, nhận diện tốt ảnh lớn, góc nghiêng)
            if ('BarcodeDetector' in window) {
                try {
                    var detector = new BarcodeDetector({ formats: ['qr_code'] });
                    var bitmap = await createImageBitmap(file);
                    var results = await detector.detect(bitmap);
                    if (results && results.length > 0 && results[0].rawValue) {
                        return results[0].rawValue;
                    }
                } catch (e1) {
                    console.log('Native BarcodeDetector pass 1:', e1);
                }
            }

            // Bước 2: Tự động bồi lề trắng Quiet Zone (40px) & chuẩn hóa kích thước qua Canvas
            // (Giải quyết 100% lỗi 'No MultiFormat Readers were able to detect the code' khi ảnh QR bị cắt sát mép hoặc 0-padding)
            var paddedFile = await createPaddedImageFile(file);

            // Bước 3: Thử lại Native BarcodeDetector với ảnh đã có viền trắng
            if ('BarcodeDetector' in window) {
                try {
                    var detector = new BarcodeDetector({ formats: ['qr_code'] });
                    var bitmapPadded = await createImageBitmap(paddedFile);
                    var results2 = await detector.detect(bitmapPadded);
                    if (results2 && results2.length > 0 && results2[0].rawValue) {
                        return results2[0].rawValue;
                    }
                } catch (e2) {}
            }

            // Bước 4: Fallback dùng ZXing của html5QrCode với ảnh đã có viền trắng chuẩn
            if (!html5QrCode) {
                html5QrCode = new Html5Qrcode("qrReader", {
                    experimentalFeatures: { useBarCodeDetectorIfSupported: true },
                    verbose: false
                });
            }

            try {
                return await html5QrCode.scanFile(paddedFile, false);
            } catch (errPaddedZxing) {
                // Bước 5: Thử quét ảnh gốc bằng ZXing
                return await html5QrCode.scanFile(file, false);
            }
        }

        function createPaddedImageFile(file) {
            return new Promise(function(resolve) {
                var img = new Image();
                img.onload = function() {
                    var maxDim = 1200;
                    var scale = 1;
                    if (img.width > maxDim || img.height > maxDim) {
                        scale = maxDim / Math.max(img.width, img.height);
                    }
                    var sw = Math.max(1, Math.floor(img.width * scale));
                    var sh = Math.max(1, Math.floor(img.height * scale));

                    var pad = 40; // Viền trắng 40px chuẩn ISO Quiet Zone
                    var canvas = document.createElement('canvas');
                    canvas.width = sw + (pad * 2);
                    canvas.height = sh + (pad * 2);
                    var ctx = canvas.getContext('2d');

                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.drawImage(img, pad, pad, sw, sh);

                    canvas.toBlob(function(blob) {
                        if (blob) {
                            var newFile = new File([blob], "qr_padded.png", { type: "image/png" });
                            resolve(newFile);
                        } else {
                            resolve(file);
                        }
                    }, 'image/png');
                };
                img.onerror = function() { resolve(file); };
                img.src = URL.createObjectURL(file);
            });
        }

        function startCamera() {
            if (!html5QrCode) {
                html5QrCode = new Html5Qrcode("qrReader", {
                    experimentalFeatures: {
                        useBarCodeDetectorIfSupported: true // Tận dụng BarcodeDetector gốc của Chrome/Edge (nhanh và nhạy gấp 10 lần)
                    },
                    verbose: false
                });
            }

            // Khung quét động: chiếm 85% diện tích để không bao giờ bị cắt lẹm mép mã QR
            var qrboxFunction = function(viewfinderWidth, viewfinderHeight) {
                var minEdge = Math.min(viewfinderWidth, viewfinderHeight);
                var qrboxSize = Math.max(260, Math.floor(minEdge * 0.85));
                return {
                    width: Math.min(viewfinderWidth - 10, qrboxSize),
                    height: Math.min(viewfinderHeight - 10, qrboxSize)
                };
            };

            var cameraSource = selectedCameraId ? { deviceId: { exact: selectedCameraId } } : { facingMode: "environment" };

            var scanConfig = {
                fps: 20, // Tăng lên 20 fps để nhận diện tức thì không bị lag giật
                qrbox: qrboxFunction,
                aspectRatio: 1.333334,
                videoConstraints: {
                    width: { ideal: 1280, min: 640 },
                    height: { ideal: 720, min: 480 },
                    facingMode: "environment"
                }
            };

            html5QrCode.start(
                cameraSource,
                scanConfig,
                onQrScanSuccess,
                function(err) {}
            ).then(function() {
                isCameraRunning = true;
                btnToggleCam.innerHTML = '<i class="bi bi-camera-video-off me-1"></i> Dừng Camera';
                btnToggleCam.classList.replace('btn-dark', 'btn-outline-danger');
            }).catch(function(err) {
                // Fallback nếu camera không hỗ trợ HD video constraints
                html5QrCode.start(
                    { facingMode: "environment" },
                    { fps: 15, qrbox: qrboxFunction },
                    onQrScanSuccess,
                    function(err) {}
                ).then(function() {
                    isCameraRunning = true;
                    btnToggleCam.innerHTML = '<i class="bi bi-camera-video-off me-1"></i> Dừng Camera';
                    btnToggleCam.classList.replace('btn-dark', 'btn-outline-danger');
                }).catch(function(e) {
                    alert('Không thể mở camera: ' + e);
                });
            });
        }

        function stopCamera() {
            if (html5QrCode && isCameraRunning) {
                return html5QrCode.stop().then(function() {
                    isCameraRunning = false;
                    btnToggleCam.innerHTML = '<i class="bi bi-camera-video me-1"></i> Bật Camera quét';
                    btnToggleCam.classList.replace('btn-outline-danger', 'btn-dark');
                });
            }
            return Promise.resolve();
        }

        // ── 2. Xử lý khi Quét QR thành công ──
        function onQrScanSuccess(decodedText) {
            var now = Date.now();
            if (decodedText === lastScannedCode && (now - lastScannedTime) < 3000) {
                return; // Tránh quét lặp lại trong 3s
            }
            lastScannedCode = decodedText;
            lastScannedTime = now;

            verifyMember(decodedText, 'QrScan');
        }

        // ── 3. Chế độ Súng quét USB ──
        var usbInput = document.getElementById('usbScannerInput');
        usbInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                var code = usbInput.value.trim();
                if (code) {
                    verifyMember(code, 'UsbScanner');
                    usbInput.value = '';
                }
            }
        });

        // ── 4. Chế độ Tra cứu SĐT thủ công ──
        var manualPhoneInput = document.getElementById('manualPhoneInput');
        var btnSearchManual = document.getElementById('btnSearchManual');
        btnSearchManual.addEventListener('click', function() {
            var val = manualPhoneInput.value.trim();
            if (val) {
                verifyMember(val, 'ManualPhone');
            }
        });
        manualPhoneInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                btnSearchManual.click();
            }
        });

        // ── 5. Hàm AJAX Xác thực Hội viên ──
        function verifyMember(query, method) {
            fetch('/OwnerCheckin/VerifyMember', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({
                    'gymId': currentGymId,
                    'query': query
                })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                displayVerificationResult(data, method);
            })
            .catch(function(err) {
                alert('Lỗi kết nối kiểm tra hội viên: ' + err);
            });
        }

        // ── 6. Hiển thị kết quả lên giao diện ──
        function displayVerificationResult(data, method) {
            var card = document.getElementById('verifyResultCard');
            var placeholder = document.getElementById('verifyPlaceholder');
            var btnConfirm = document.getElementById('btnConfirmCheckin');
            placeholder.classList.add('d-none');
            card.classList.remove('d-none', 'valid', 'invalid', 'warning');

            currentVerifyData = data;
            currentVerifyData.method = method;

            // Đảm bảo ẩn dropdown nhiều gói nếu lần quét trước đó có hiển thị
            var singleWrap = document.getElementById('resSinglePackageWrap');
            var multiWrap = document.getElementById('resMultiPackageWrap');
            if (multiWrap) multiWrap.classList.add('d-none');
            if (singleWrap) singleWrap.classList.remove('d-none');

            if (data.isWrongGym) {
                // SAI CƠ SỞ / PHÒNG TẬP
                playBeep(false);
                card.classList.add('invalid');
                document.getElementById('resFullName').innerText = data.fullName || 'Hội viên';
                document.getElementById('resVipBadge').innerText = data.vipTierName || 'Standard';
                document.getElementById('resVipBadge').style.backgroundColor = data.vipBadgeColor || '#64748b';
                document.getElementById('resPhone').innerText = data.phoneNumber || '—';
                document.getElementById('resEmail').innerText = data.email || '—';
                document.getElementById('resStatusBadge').className = 'badge bg-danger';
                document.getElementById('resStatusBadge').innerText = 'Sai cơ sở';
                document.getElementById('resPackageName').innerText = data.targetPackageName || 'Gói cơ sở khác';
                document.getElementById('resPackageValidity').innerText = 'Thuộc: ' + (data.wrongGymName || 'Cơ sở khác');
                document.getElementById('resDaysRemaining').innerText = 'Không áp dụng';

                document.getElementById('resAlertBox').className = 'alert alert-danger p-2 mb-3 small d-flex align-items-start gap-2';
                document.getElementById('resAlertIcon').className = 'bi bi-geo-alt-fill fs-5 text-danger mt-1';
                document.getElementById('resAlertMessage').innerHTML = (data.message || '').replace(/\n/g, '<br>');

                btnConfirm.classList.add('d-none');
                return;
            }

            if (!data.success && !data.isSuspended) {
                // Lỗi không tìm thấy hoặc sai định dạng
                playBeep(false);
                card.classList.add('invalid');
                document.getElementById('resFullName').innerText = 'Không tìm thấy';
                document.getElementById('resVipBadge').innerText = '—';
                document.getElementById('resPhone').innerText = '—';
                document.getElementById('resEmail').innerText = '—';
                document.getElementById('resStatusBadge').className = 'badge bg-danger';
                document.getElementById('resStatusBadge').innerText = 'Không hợp lệ';
                document.getElementById('resPackageName').innerText = '—';
                document.getElementById('resPackageValidity').innerText = '—';
                document.getElementById('resDaysRemaining').innerText = '—';

                document.getElementById('resAlertBox').className = 'alert alert-danger p-2 mb-3 small d-flex align-items-center gap-2';
                document.getElementById('resAlertIcon').className = 'bi bi-x-circle-fill fs-5 text-danger';
                document.getElementById('resAlertMessage').innerHTML = (data.message || '').replace(/\n/g, '<br>');

                btnConfirm.classList.add('d-none');
                return;
            }

            // Điền thông tin hội viên
            document.getElementById('resFullName').innerText = data.fullName;
            document.getElementById('resVipBadge').innerText = data.vipTierName;
            document.getElementById('resVipBadge').style.backgroundColor = data.vipBadgeColor || '#64748b';
            document.getElementById('resPhone').innerText = data.phoneNumber || '—';
            document.getElementById('resEmail').innerText = data.email || '—';

            if (data.canCheckin) {
                // HỢP LỆ VÀO TẬP
                playBeep(true);
                card.classList.add('valid');
                document.getElementById('resStatusBadge').className = 'badge bg-success';
                document.getElementById('resStatusBadge').innerText = 'Hợp lệ vào tập';

                // Kiểm tra nếu có nhiều gói
                var pkgSelect = document.getElementById('resPackageSelect');

                if (data.availableMemberships && data.availableMemberships.length > 1) {
                    singleWrap.classList.add('d-none');
                    multiWrap.classList.remove('d-none');
                    document.getElementById('resMultiPackageCount').innerText = data.availableMemberships.length;

                    pkgSelect.innerHTML = '';
                    data.availableMemberships.forEach(function(m) {
                        var opt = document.createElement('option');
                        opt.value = m.membershipId;
                        opt.textContent = m.packageName + ' (' + m.packageType + ' — Còn ' + m.daysRemaining + ' ngày)';
                        if (m.isSelected || m.membershipId === data.membershipId) {
                            opt.selected = true;
                        }
                        opt.dataset.days = m.daysRemaining;
                        opt.dataset.start = m.startDate;
                        opt.dataset.end = m.endDate;
                        opt.dataset.name = m.packageName;
                        pkgSelect.appendChild(opt);
                    });

                    updateSelectedPackageDisplay();
                } else {
                    multiWrap.classList.add('d-none');
                    singleWrap.classList.remove('d-none');
                    document.getElementById('resPackageName').innerText = data.packageName;
                    document.getElementById('resPackageValidity').innerText = 'Hạn dùng: ' + new Date(data.startDate).toLocaleDateString('vi-VN') + ' → ' + new Date(data.endDate).toLocaleDateString('vi-VN');
                    document.getElementById('resDaysRemaining').innerText = 'Còn ' + data.daysRemaining + ' ngày';
                }

                document.getElementById('resAlertBox').className = 'alert alert-success p-2 mb-3 small d-flex align-items-center gap-2';
                document.getElementById('resAlertIcon').className = 'bi bi-check-circle-fill fs-5 text-success';
                document.getElementById('resAlertMessage').innerHTML = (data.message || '').replace(/\n/g, '<br>');

                btnConfirm.classList.remove('d-none');

                // Tự động xác nhận nếu bật Fast Pass (Auto-Confirm)
                var isAutoConfirm = document.getElementById('autoConfirmCheck').checked;
                if (isAutoConfirm && !data.alreadyCheckedInRecently) {
                    btnConfirm.click();
                }
            } else if (data.isSuspended) {
                // BỊ ĐÌNH CHỈ
                playBeep(false);
                card.classList.add('invalid');
                document.getElementById('resStatusBadge').className = 'badge bg-danger';
                document.getElementById('resStatusBadge').innerText = 'BỊ ĐÌNH CHỈ';
                document.getElementById('resPackageName').innerText = '—';
                document.getElementById('resPackageValidity').innerText = 'Bị cấm vào tập';
                document.getElementById('resDaysRemaining').innerText = 'Khóa quyền';

                document.getElementById('resAlertBox').className = 'alert alert-danger p-2 mb-3 small d-flex align-items-center gap-2';
                document.getElementById('resAlertIcon').className = 'bi bi-shield-x fs-5 text-danger';
                document.getElementById('resAlertMessage').innerHTML = (data.message || '').replace(/\n/g, '<br>');

                btnConfirm.classList.add('d-none');
            } else if (data.isExpired || !data.hasActiveMembership) {
                // HẾT HẠN HOẶC CHƯA CÓ VÉ
                playBeep(false);
                card.classList.add('warning');
                document.getElementById('resStatusBadge').className = 'badge bg-warning text-dark';
                document.getElementById('resStatusBadge').innerText = 'Chưa có vé hợp lệ';
                document.getElementById('resPackageName').innerText = 'Chưa kích hoạt';
                document.getElementById('resPackageValidity').innerText = 'Cần mua hoặc gia hạn gói';
                document.getElementById('resDaysRemaining').innerText = '0 ngày';

                document.getElementById('resAlertBox').className = 'alert alert-warning p-2 mb-3 small d-flex align-items-center gap-2';
                document.getElementById('resAlertIcon').className = 'bi bi-exclamation-triangle-fill fs-5 text-warning';
                document.getElementById('resAlertMessage').innerHTML = (data.message || '').replace(/\n/g, '<br>');
                btnConfirm.classList.add('d-none');
            }
        }

        // Thay đổi gói điểm danh khi hội viên có nhiều gói tại cơ sở này
        function onPackageSelectChange(selectEl) {
            var opt = selectEl.options[selectEl.selectedIndex];
            if (opt && currentVerifyData) {
                currentVerifyData.membershipId = parseInt(opt.value);
                currentVerifyData.packageName = opt.dataset.name;
                document.getElementById('resDaysRemaining').innerText = 'Còn ' + opt.dataset.days + ' ngày';
                document.getElementById('resMultiPackageValidity').innerText = 'Hạn dùng: ' + new Date(opt.dataset.start).toLocaleDateString('vi-VN') + ' → ' + new Date(opt.dataset.end).toLocaleDateString('vi-VN');
            }
        }

        function updateSelectedPackageDisplay() {
            var selectEl = document.getElementById('resPackageSelect');
            if (selectEl && selectEl.selectedIndex >= 0) {
                onPackageSelectChange(selectEl);
            }
        }

        // ── 7. Nút Bấm Xác Nhận Vào Tập ──
        var btnConfirm = document.getElementById('btnConfirmCheckin');
        btnConfirm.addEventListener('click', function() {
            if (!currentVerifyData || !currentVerifyData.canCheckin) return;

            btnConfirm.disabled = true;
            btnConfirm.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang ghi nhận...';

            fetch('/OwnerCheckin/ConfirmCheckin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({
                    'gymId': currentGymId,
                    'memberId': currentVerifyData.memberId,
                    'membershipId': currentVerifyData.membershipId || '',
                    'method': currentVerifyData.method || 'QrScan'
                })
            })
            .then(function(res) { return res.json(); })
            .then(function(res) {
                btnConfirm.disabled = false;
                btnConfirm.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> XÁC NHẬN CHO VÀO TẬP';

                if (res.success) {
                    btnConfirm.classList.add('d-none');
                    document.getElementById('resAlertBox').className = 'alert alert-success p-2 mb-3 small d-flex align-items-center gap-2';
                    document.getElementById('resAlertMessage').innerText = '✅ ' + res.message;

                    // Cập nhật lại Thước đo đám đông Live
                    updateCrowdMeter(res);

                    // Thêm hội viên vào danh sách Live
                    appendLiveMemberRow(res.newMember);
                } else {
                    alert('Lỗi: ' + res.message);
                }
            })
            .catch(function(err) {
                btnConfirm.disabled = false;
                btnConfirm.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> XÁC NHẬN CHO VÀO TẬP';
                alert('Lỗi gửi yêu cầu: ' + err);
            });
        });
    });

    // ── Cập nhật giao diện Thước đo đám đông ──
    function updateCrowdMeter(data) {
        document.getElementById('activeCountDisplay').innerText = data.activeCount;
        document.getElementById('maxCapacityDisplay').innerText = data.maxCapacity;
        document.getElementById('crowdPctDisplay').innerText = data.crowdPercentage + '%';

        var badge = document.getElementById('crowdStatusBadge');
        badge.style.backgroundColor = data.statusColor;
        document.getElementById('crowdStatusText').innerText = data.statusText;
        document.getElementById('crowdStatusIcon').className = 'bi ' + data.statusIcon + ' me-1';
        document.getElementById('crowdRecommendation').innerText = data.recommendation;

        var bar = document.getElementById('crowdProgressBar');
        bar.style.width = data.crowdPercentage + '%';
        bar.style.backgroundColor = data.statusColor;
    }

    // ── Thêm dòng hội viên vào danh sách live ──
    function appendLiveMemberRow(m) {
        var container = document.getElementById('liveMembersContainer');
        var emptyMsg = document.getElementById('emptyLiveMembers');
        if (emptyMsg) emptyMsg.remove();

        var list = document.getElementById('liveMembersList');
        if (!list) {
            list = document.createElement('div');
            list.id = 'liveMembersList';
            container.appendChild(list);
        }

        var tableCount = document.getElementById('liveTableCount');
        tableCount.innerText = parseInt(tableCount.innerText || 0) + 1;

        var initial = (m.memberName || 'H').substring(0, 1).toUpperCase();
        var rowHtml = `
            <div class="live-member-item" id="checkin-row-${m.checkinId}" style="background:#f0fdf4;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:38px; height:38px; border-radius:50%; background:#dcfce7; display:flex; align-items:center; justify-content:center; font-weight:800; color:#16a34a; font-size:0.85rem;">
                        ${initial}
                    </div>
                    <div>
                        <div class="fw-bold text-dark" style="font-size:0.88rem;">
                            ${m.memberName}
                            <span class="badge ms-1" style="background:${m.vipBadgeColor}; font-size:0.65rem;">${m.vipTierName}</span>
                        </div>
                        <div style="font-size:0.74rem; color:#64748b;">
                            ${m.packageName} &bull; Vào lúc <strong>Vừa xong</strong>
                        </div>
                    </div>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" style="font-size:0.72rem; border-radius:4px;" onclick="checkoutEarly(${m.checkinId}, '${m.memberName}')">
                        <i class="bi bi-box-arrow-right me-1"></i> Check-out sớm
                    </button>
                </div>
            </div>
        `;
        list.insertAdjacentHTML('afterbegin', rowHtml);
    }

    // ── Check-out sớm ──
    function checkoutEarly(checkinId, memberName) {
        if (!confirm('Xác nhận hội viên ' + memberName + ' đã rời phòng tập?')) return;

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

        fetch('/OwnerCheckin/CheckoutEarly', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: new URLSearchParams({ 'checkinId': checkinId })
        })
        .then(function(res) { return res.json(); })
        .then(function(res) {
            if (res.success) {
                var row = document.getElementById('checkin-row-' + checkinId);
                if (row) row.remove();

                var tableCount = document.getElementById('liveTableCount');
                tableCount.innerText = Math.max(0, parseInt(tableCount.innerText || 1) - 1);

                updateCrowdMeter(res);
            } else {
                alert('Lỗi: ' + res.message);
            }
        })
        .catch(function(err) {
            alert('Lỗi: ' + err);
        });
    }

    // ═══════════════════════════════════════════════════════
    // V3: FACENET SCANNING AT OWNER RECEPTION DESK
    // ═══════════════════════════════════════════════════════
    var ownerFaceVideo = document.getElementById('ownerFaceVideo');
    var ownerFaceOval = document.getElementById('ownerFaceOval');
    var faceNetStatus = document.getElementById('faceNetStatus');
    var btnToggleFaceNet = document.getElementById('btnToggleFaceNet');
    var facePlaceholder = document.getElementById('facePlaceholder');

    var isFaceCamRunning = false;
    var faceStream = null;
    var faceModelsReady = false;
    var isCheckingFace = false;
    var lastVerifiedFaceId = "";
    var lastVerifiedFaceTime = 0;

    var FACENET_MODEL_URLS = [
        'https://cdn.jsdelivr.net/gh/cgarciagl/face-api.js@master/weights',
        'https://raw.githubusercontent.com/justadudewhohacks/face-api.js/master/weights'
    ];
    var faceModelIndex = 0;

    async function loadOwnerFaceModels() {
        if (faceModelsReady) return true;
        faceNetStatus.innerText = 'Đang nạp mô hình AI FaceNet...';
        var url = FACENET_MODEL_URLS[faceModelIndex];
        try {
            await Promise.all([
                faceapi.nets.tinyFaceDetector.loadFromUri(url),
                faceapi.nets.faceLandmark68Net.loadFromUri(url),
                faceapi.nets.faceRecognitionNet.loadFromUri(url)
            ]);
            faceModelsReady = true;
            return true;
        } catch (err) {
            faceModelIndex++;
            if (faceModelIndex < FACENET_MODEL_URLS.length) {
                return await loadOwnerFaceModels();
            }
            throw err;
        }
    }

    if (btnToggleFaceNet) {
        btnToggleFaceNet.addEventListener('click', async function() {
            if (isFaceCamRunning) {
                stopFaceCam();
            } else {
                await startFaceCam();
            }
        });
    }

    async function startFaceCam() {
        if (isCameraRunning && typeof stopCamera === 'function') {
            await stopCamera();
        }

        btnToggleFaceNet.disabled = true;
        btnToggleFaceNet.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang nạp AI...';

        try {
            await loadOwnerFaceModels();

            faceStream = await navigator.mediaDevices.getUserMedia({
                video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' }
            });

            ownerFaceVideo.srcObject = faceStream;
            facePlaceholder.classList.add('d-none');
            btnToggleFaceNet.disabled = false;
            btnToggleFaceNet.className = 'btn btn-outline-danger btn-sm fw-bold px-3';
            btnToggleFaceNet.innerHTML = '<i class="bi bi-stop-circle me-1"></i> Tắt Camera Face ID';
            isFaceCamRunning = true;
            faceNetStatus.className = 'small text-success fw-bold';
            faceNetStatus.innerText = 'Camera đang hoạt động';

            ownerFaceVideo.onloadedmetadata = function() {
                ownerFaceVideo.play();
                ownerFaceDetectLoop();
            };
        } catch (err) {
            alert('Không thể mở camera hoặc nạp model FaceNet: ' + err.message);
            stopFaceCam();
        }
    }

    function stopFaceCam() {
        isFaceCamRunning = false;
        if (faceStream) {
            faceStream.getTracks().forEach(function(t) { t.stop(); });
            faceStream = null;
        }
        ownerFaceVideo.srcObject = null;
        facePlaceholder.classList.remove('d-none');
        btnToggleFaceNet.className = 'btn btn-dark btn-sm fw-bold px-3';
        btnToggleFaceNet.style.background = '#0f172a';
        btnToggleFaceNet.disabled = false;
        btnToggleFaceNet.innerHTML = '<i class="bi bi-camera-video me-1 text-info"></i> Bật Camera Face ID';
        faceNetStatus.className = 'small text-muted fw-bold';
        faceNetStatus.innerText = 'Đã tắt camera';
        ownerFaceOval.style.borderColor = 'rgba(56,189,248,0.5)';
    }

    async function ownerFaceDetectLoop() {
        if (!isFaceCamRunning) return;

        if (!isCheckingFace) {
            var opts = new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.6 });
            var detection = await faceapi.detectSingleFace(ownerFaceVideo, opts)
                                          .withFaceLandmarks()
                                          .withFaceDescriptor();

            if (detection) {
                ownerFaceOval.style.borderColor = '#10b981';
                var now = Date.now();
                if (now - lastVerifiedFaceTime > 2500) {
                    isCheckingFace = true;
                    faceNetStatus.innerText = 'Đang nhận diện...';
                    await verifyFaceWithServer(detection.descriptor);
                }
            } else {
                ownerFaceOval.style.borderColor = 'rgba(56,189,248,0.5)';
                faceNetStatus.innerText = 'Đang tìm khuôn mặt...';
            }
        }

        if (isFaceCamRunning) {
            requestAnimationFrame(ownerFaceDetectLoop);
        }
    }

    async function verifyFaceWithServer(descriptor) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

        try {
            var res = await fetch('/OwnerCheckin/VerifyFace', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    gymId: currentGymId,
                    descriptor: Array.from(descriptor)
                })
            });

            var data = await res.json();

            if (data.success && data.foundMatch) {
                if (data.memberId === lastVerifiedFaceId && (Date.now() - lastVerifiedFaceTime < 7000)) {
                    isCheckingFace = false;
                    return;
                }

                lastVerifiedFaceTime = Date.now();
                lastVerifiedFaceId = data.memberId;
                playBeep(data.canCheckin || data.isAlreadyInside);

                displayFaceVerifyResult(data);
            } else {
                faceNetStatus.className = 'small text-warning fw-bold';
                faceNetStatus.innerText = 'Chưa nhận diện được hội viên';
                setTimeout(function() { isCheckingFace = false; }, 1200);
            }
        } catch (err) {
            console.error(err);
            isCheckingFace = false;
        }
    }

    function displayFaceVerifyResult(res) {
        currentVerifyData = {
            memberId: res.memberId,
            membershipId: res.membershipId,
            method: 'FaceNet',
            faceMatchScore: res.confidenceScore,
            isAlreadyInside: res.isAlreadyInside,
            activeCheckinId: res.activeCheckinId
        };

        var placeholder = document.getElementById('verifyPlaceholder');
        var card = document.getElementById('verifyResultCard');
        var btnConfirm = document.getElementById('btnConfirmCheckin');

        placeholder.classList.add('d-none');
        card.classList.remove('d-none');

        document.getElementById('resFullName').innerText = res.fullName;
        document.getElementById('resPhone').innerText = res.phoneNumber || '—';
        document.getElementById('resEmail').innerText = res.email || '—';

        var vipBadge = document.getElementById('resVipBadge');
        vipBadge.innerText = res.vipTierName;
        vipBadge.style.backgroundColor = res.vipBadgeColor;

        var statusBadge = document.getElementById('resStatusBadge');
        var alertBox = document.getElementById('resAlertBox');
        var alertMsg = document.getElementById('resAlertMessage');
        var alertIcon = document.getElementById('resAlertIcon');

        // Nếu ĐÃ Ở TRONG PHÒNG -> Check-out sớm
        if (res.isAlreadyInside) {
            card.className = 'member-result-card warning';
            statusBadge.className = 'badge bg-warning text-dark';
            statusBadge.innerText = 'Đang Trong Phòng';
            document.getElementById('resPackageName').innerText = res.packageName;
            document.getElementById('resDaysRemaining').innerText = 'Đã tập ' + res.minutesInside + ' phút';
            document.getElementById('resPackageValidity').innerText = 'Vào lúc: ' + (res.checkinTime ? new Date(res.checkinTime).toLocaleTimeString('vi-VN') : 'Gần đây');

            alertBox.className = 'alert alert-warning p-2 mb-3 small d-flex align-items-center gap-2';
            alertIcon.className = 'bi bi-box-arrow-right fs-5 text-warning';
            alertMsg.innerText = '👤 Hội viên đang trong phòng tập (' + res.minutesInside + ' phút). Bấm nút bên dưới để CHECK-OUT cho hội viên ra về.';

            btnConfirm.className = 'btn btn-warning w-100 fw-bold py-2';
            btnConfirm.innerHTML = '<i class="bi bi-box-arrow-right me-1"></i> XÁC NHẬN CHECK-OUT RA VỀ (FACENET)';
            btnConfirm.classList.remove('d-none');

            btnConfirm.onclick = function() {
                checkoutEarly(res.activeCheckinId, res.fullName);
                card.classList.add('d-none');
                placeholder.classList.remove('d-none');
            };

            isCheckingFace = false;
            return;
        }

        // Nếu HỢP LỆ VÀO TẬP
        if (res.canCheckin) {
            card.className = 'member-result-card valid';
            statusBadge.className = 'badge bg-success';
            statusBadge.innerText = 'Hợp Lệ (Face ID)';
            document.getElementById('resPackageName').innerText = res.packageName;
            document.getElementById('resDaysRemaining').innerText = 'Còn ' + res.daysRemaining + ' ngày';
            document.getElementById('resPackageValidity').innerText = 'FaceNet Khớp: ' + Math.round(res.confidenceScore * 100) + '%';

            alertBox.className = 'alert alert-success p-2 mb-3 small d-flex align-items-center gap-2';
            alertIcon.className = 'bi bi-check-circle-fill fs-5 text-success';
            alertMsg.innerText = res.message;

            btnConfirm.className = 'btn-checkin-confirm';
            btnConfirm.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> XÁC NHẬN CHO VÀO TẬP (FACENET)';
            btnConfirm.classList.remove('d-none');

            btnConfirm.onclick = function() {
                btnConfirm.disabled = true;
                btnConfirm.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xác nhận...';
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

                fetch('/OwnerCheckin/ConfirmFaceCheckin', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: new URLSearchParams({
                        'gymId': currentGymId,
                        'memberId': currentVerifyData.memberId,
                        'membershipId': currentVerifyData.membershipId || '',
                        'faceMatchScore': currentVerifyData.faceMatchScore || 0.95
                    })
                })
                .then(function(r) { return r.json(); })
                .then(function(resp) {
                    btnConfirm.disabled = false;
                    btnConfirm.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> XÁC NHẬN CHO VÀO TẬP (FACENET)';
                    if (resp.success) {
                        btnConfirm.classList.add('d-none');
                        document.getElementById('resAlertBox').className = 'alert alert-success p-2 mb-3 small d-flex align-items-center gap-2';
                        document.getElementById('resAlertMessage').innerText = '✅ ' + resp.message;
                        updateCrowdMeter(resp);
                        appendLiveMemberRow(resp.newMember);
                    } else {
                        alert('Lỗi: ' + resp.message);
                    }
                })
                .catch(function(err) {
                    btnConfirm.disabled = false;
                    alert('Lỗi: ' + err);
                });
            };

            // Nếu bật tự động xác nhận (Fast Pass)
            if (document.getElementById('autoConfirmCheck')?.checked) {
                btnConfirm.click();
            }
        } else {
            card.className = 'member-result-card invalid';
            statusBadge.className = 'badge bg-danger';
            statusBadge.innerText = res.isSuspended ? 'Kỷ Luật' : 'Không Hợp Lệ';

            alertBox.className = 'alert alert-danger p-2 mb-3 small d-flex align-items-center gap-2';
            alertIcon.className = 'bi bi-x-circle-fill fs-5 text-danger';
            alertMsg.innerText = res.message;

            btnConfirm.classList.add('d-none');
        }

        setTimeout(function() { isCheckingFace = false; }, 2000);
    }
</script>
