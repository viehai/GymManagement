@model GymManagement.ViewModels.CreateSuspensionViewModel

@{
    ViewData["Title"] = "Đình chỉ hội viên";
    Layout = "_OwnerAdminLayout";
}

<div class="mb-4">
    <a asp-controller="OwnerMember" asp-action="Index" asp-route-gymId="@Model.GymId" class="text-decoration-none text-muted" style="font-size:0.85rem;">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách hội viên
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <!-- Warning Notice Alert -->
        <div class="alert alert-warning-custom mb-4" style="border-left: 4px solid #ef4444; background: #fff5f5; color: #991b1b;">
            <div class="d-flex align-items-start gap-3">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 1.4rem; color: #ef4444; line-height: 1;"></i>
                <div style="font-size: 0.88rem; line-height: 1.5;">
                    <strong style="display:block; margin-bottom: 2px;">Cảnh báo quy định đình chỉ hội viên:</strong>
                    Sau khi lệnh đình chỉ được ban hành, hội viên sẽ ngay lập tức bị <strong>chặn mua vé mới và gia hạn thẻ tập</strong> tại cơ sở này.
                    Hệ thống sẽ <strong>tự động gửi email thông báo</strong> lý do và thời hạn kỷ luật tới hội viên, đồng thời ghi nhận vào Nhật ký hệ thống (SystemLog).
                </div>
            </div>
        </div>

        <div class="content-card">
            <div class="content-card-header" style="background:#fff; border-bottom:1px solid #f0f0f0; padding:1.4rem 1.8rem;">
                <h5 style="margin:0; font-family:'Montserrat',sans-serif; font-size:1.15rem; font-weight:800; color:#111;">
                    <i class="bi bi-slash-circle text-danger me-2"></i>Quyết định đình chỉ quyền hội viên
                </h5>
            </div>

            <div class="content-card-body" style="padding:1.8rem;">
                <!-- Member & Gym Info Summary Card -->
                <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px; padding:1.2rem; margin-bottom:1.8rem;">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <span style="font-size:0.75rem; color:#6b7280; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">Hội viên vi phạm</span>
                            <div style="font-size:1rem; font-weight:700; color:#111; margin-top:2px;">@Model.MemberName</div>
                            <div style="font-size:0.82rem; color:#4b5563;"><i class="bi bi-envelope me-1"></i>@Model.MemberEmail</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <span style="font-size:0.75rem; color:#6b7280; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">Cơ sở áp dụng</span>
                            <div style="font-size:1rem; font-weight:700; color:#111; margin-top:2px;">
                                <i class="bi bi-building me-1 text-primary"></i>@Model.GymName
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-controller="OwnerMember" asp-action="Suspend" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="GymId" />
                    <input type="hidden" asp-for="MemberId" />
                    <input type="hidden" asp-for="GymName" />
                    <input type="hidden" asp-for="MemberName" />
                    <input type="hidden" asp-for="MemberEmail" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.85rem;"></div>

                    <!-- Hình thức xử phạt -->
                    <div class="owner-form-group mb-4">
                        <label asp-for="SuspensionType" style="font-weight:700; font-size:0.88rem; color:#111; margin-bottom:0.6rem;">
                            Hình thức kỷ luật <span class="text-danger">*</span>
                        </label>
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="suspension-type-card" for="type-temp" id="label-type-temp" style="display:block; padding:1.2rem; border:2px solid #e5e7eb; border-radius:10px; cursor:pointer; transition:all 0.2s;">
                                    <div class="d-flex align-items-center gap-3">
                                        <input type="radio" asp-for="SuspensionType" value="Temporary" id="type-temp" class="form-check-input mt-0" style="width:1.2rem; height:1.2rem;" onchange="handleTypeChange()" checked />
                                        <div>
                                            <div style="font-weight:700; font-size:0.95rem; color:#111;">Tạm đình chỉ có thời hạn</div>
                                            <div style="font-size:0.78rem; color:#6b7280; margin-top:2px;">Chặn mua vé trong khoảng thời gian xác định</div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="suspension-type-card" for="type-perm" id="label-type-perm" style="display:block; padding:1.2rem; border:2px solid #e5e7eb; border-radius:10px; cursor:pointer; transition:all 0.2s;">
                                    <div class="d-flex align-items-center gap-3">
                                        <input type="radio" asp-for="SuspensionType" value="Permanent" id="type-perm" class="form-check-input mt-0" style="width:1.2rem; height:1.2rem;" onchange="handleTypeChange()" />
                                        <div>
                                            <div style="font-weight:700; font-size:0.95rem; color:#991b1b;">Cấm vĩnh viễn (Blacklist)</div>
                                            <div style="font-size:0.78rem; color:#6b7280; margin-top:2px;">Cấm hoàn toàn quyền mua vé và tập luyện tại cơ sở</div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Thời hạn đình chỉ (cho Temporary) -->
                    <div id="durationSection" class="owner-form-group mb-4" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:1.2rem;">
                        <label style="font-weight:700; font-size:0.85rem; color:#1e293b; margin-bottom:0.5rem; display:block;">
                            Thời hạn áp dụng kỷ luật
                        </label>
                        <div class="d-flex gap-2 flex-wrap mb-3">
                            <button type="button" class="btn-owner-secondary duration-preset-btn active" onclick="setDuration(7, this)">
                                7 ngày
                            </button>
                            <button type="button" class="btn-owner-secondary duration-preset-btn" onclick="setDuration(14, this)">
                                14 ngày
                            </button>
                            <button type="button" class="btn-owner-secondary duration-preset-btn" onclick="setDuration(30, this)">
                                30 ngày (1 tháng)
                            </button>
                            <button type="button" class="btn-owner-secondary duration-preset-btn" onclick="setDuration(90, this)">
                                90 ngày (3 tháng)
                            </button>
                        </div>

                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-sm-6">
                                <label asp-for="DurationDays" style="font-size:0.78rem; color:#64748b; font-weight:600; margin-bottom:4px; display:block;">Số ngày đình chỉ:</label>
                                <input type="number" asp-for="DurationDays" id="inputDurationDays" class="form-control" min="1" max="3650" oninput="calculateEndDateFromDays()" />
                                <span asp-validation-for="DurationDays" class="text-danger" style="font-size:0.8rem;"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="EndDate" style="font-size:0.78rem; color:#64748b; font-weight:600; margin-bottom:4px; display:block;">Ngày kết thúc đình chỉ:</label>
                                <input type="date" asp-for="EndDate" id="inputEndDate" class="form-control" onchange="calculateDaysFromEndDate()" />
                                <span asp-validation-for="EndDate" class="text-danger" style="font-size:0.8rem;"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Lý do đình chỉ -->
                    <div class="owner-form-group mb-4">
                        <label asp-for="Reason" style="font-weight:700; font-size:0.88rem; color:#111; margin-bottom:0.4rem;">
                            Lý do kỷ luật / vi phạm <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Nhập chi tiết hành vi vi phạm (ví dụ: Gây gổ đánh nhau, cố tình làm hỏng máy tập, vi phạm nghiêm trọng nội quy an toàn phòng gym...)" required></textarea>
                        <span asp-validation-for="Reason" class="text-danger" style="font-size:0.8rem;"></span>
                        <div style="font-size:0.75rem; color:#6b7280; margin-top:4px;">Lý do này sẽ được đính kèm trong email thông báo gửi trực tiếp đến hội viên.</div>
                    </div>

                    <!-- Submit Actions -->
                    <div class="d-flex align-items-center justify-content-between pt-3" style="border-top:1px solid #f0f0f0;">
                        <a asp-controller="OwnerMember" asp-action="Index" asp-route-gymId="@Model.GymId" class="btn-owner-secondary">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn-owner-danger" style="background:#dc2626; color:#fff; border-color:#dc2626; padding:0.65rem 1.6rem; font-weight:700; font-size:0.88rem;">
                            <i class="bi bi-slash-circle me-1"></i> Xác nhận ban hành lệnh đình chỉ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function handleTypeChange() {
            const isTemp = document.getElementById('type-temp').checked;
            const durationSection = document.getElementById('durationSection');
            const labelTemp = document.getElementById('label-type-temp');
            const labelPerm = document.getElementById('label-type-perm');

            if (isTemp) {
                durationSection.style.display = 'block';
                labelTemp.style.borderColor = '#6366f1';
                labelTemp.style.background = '#f5f3ff';
                labelPerm.style.borderColor = '#e5e7eb';
                labelPerm.style.background = '#fff';
            } else {
                durationSection.style.display = 'none';
                labelPerm.style.borderColor = '#ef4444';
                labelPerm.style.background = '#fef2f2';
                labelTemp.style.borderColor = '#e5e7eb';
                labelTemp.style.background = '#fff';
            }
        }

        function setDuration(days, btn) {
            document.getElementById('inputDurationDays').value = days;
            calculateEndDateFromDays();

            document.querySelectorAll('.duration-preset-btn').forEach(b => {
                b.classList.remove('active');
                b.style.borderColor = '#d1d5db';
                b.style.background = '#fff';
                b.style.color = '#374151';
            });

            if (btn) {
                btn.classList.add('active');
                btn.style.borderColor = '#6366f1';
                btn.style.background = '#6366f1';
                btn.style.color = '#fff';
            }
        }

        function calculateEndDateFromDays() {
            const days = parseInt(document.getElementById('inputDurationDays').value) || 0;
            if (days > 0) {
                const targetDate = new Date();
                targetDate.setDate(targetDate.getDate() + days);
                const yyyy = targetDate.getFullYear();
                const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
                const dd = String(targetDate.getDate()).padStart(2, '0');
                document.getElementById('inputEndDate').value = `${yyyy}-${mm}-${dd}`;
            }
        }

        function calculateDaysFromEndDate() {
            const dateVal = document.getElementById('inputEndDate').value;
            if (dateVal) {
                const endDate = new Date(dateVal);
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                endDate.setHours(0, 0, 0, 0);
                const diffTime = endDate.getTime() - today.getTime();
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (diffDays > 0) {
                    document.getElementById('inputDurationDays').value = diffDays;
                }
            }
        }

        // Init on load
        document.addEventListener('DOMContentLoaded', function () {
            handleTypeChange();
            if (!document.getElementById('inputEndDate').value) {
                calculateEndDateFromDays();
            }
        });
    </script>
}
