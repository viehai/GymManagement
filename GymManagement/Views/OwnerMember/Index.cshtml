<!-- Đường dẫn file: Views/OwnerMember/Index.cshtml -->
@model GymManagement.ViewModels.OwnerMemberListViewModel

@{
    ViewData["Title"] = "Quản lý hội viên";
    Layout = "_OwnerAdminLayout";
}

<!-- Filter Bar & Quick Stats -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 style="font-family:'Montserrat',sans-serif; font-size:1.25rem; font-weight:800; color:#111; margin:0 0 4px;">
            Danh sách hội viên
        </h2>
        <p style="margin:0; font-size:0.85rem; color:#888;">
            Theo dõi tất cả thành viên đã và đang đăng ký tập tại các cơ sở của bạn.
        </p>
    </div>

    <!-- Dropdown lọc theo phòng Gym -->
    @if (Model.MyGyms.Any())
    {
        <form method="get" class="d-flex align-items-center gap-2">
            <label style="font-size:0.8rem; font-weight:600; color:#555; white-space:nowrap;">Lọc theo Gym:</label>
            <select name="gymId" class="form-select form-select-sm" style="border-radius:6px; min-width:200px;" onchange="this.form.submit()">
                <option value="">-- Tất cả cơ sở (@Model.MyGyms.Count) --</option>
                @foreach (var g in Model.MyGyms)
                {
                    <option value="@g.Id" selected="@(Model.SelectedGymId == g.Id)">@g.Name</option>
                }
            </select>
        </form>
    }
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4">
        <div class="content-card" style="padding:1.2rem; border-left:4px solid var(--accent);">
            <div style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:1px;">Tổng hội viên</div>
            <div style="font-family:'Montserrat',sans-serif; font-size:1.8rem; font-weight:900; color:#111; margin-top:4px;">
                @Model.TotalMembers
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="content-card" style="padding:1.2rem; border-left:4px solid #10b981;">
            <div style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:1px;">Đang tập (Active)</div>
            <div style="font-family:'Montserrat',sans-serif; font-size:1.8rem; font-weight:900; color:#10b981; margin-top:4px;">
                @Model.ActiveMembersCount
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="content-card" style="padding:1.2rem; border-left:4px solid #ef4444;">
            <div style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:1px;">Đã hết hạn</div>
            <div style="font-family:'Montserrat',sans-serif; font-size:1.8rem; font-weight:900; color:#ef4444; margin-top:4px;">
                @Model.ExpiredMembersCount
            </div>
        </div>
    </div>
</div>

<!-- Table Danh sách hội viên -->
<div class="content-card">
    <div class="content-card-header">
        <h5 class="content-card-title"><i class="bi bi-people me-2"></i>Hội viên phòng Gym (@Model.Members.Count bản ghi)</h5>
    </div>

    @if (!Model.Members.Any())
    {
        <div style="padding:3.5rem 1.5rem; text-align:center; color:#999;">
            <i class="bi bi-person-x" style="font-size:2.8rem; color:#d1d5db; display:block; margin-bottom:0.8rem;"></i>
            <p style="font-size:0.92rem; margin:0;">Chưa có hội viên nào đăng ký gói tập tại cơ sở này.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Hội viên</th>
                        <th>Cơ sở Gym</th>
                        <th>Gói dịch vụ</th>
                        <th>Thời hạn sử dụng</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Members)
                    {
                        <tr id="member-row-@m.MembershipId">
                            <td>
                                <div style="font-weight:700; color:#111;">@m.FullName</div>
                                <div style="font-size:0.78rem; color:#888;">
                                    <i class="bi bi-envelope me-1"></i>@m.Email
                                    @if (!string.IsNullOrEmpty(m.PhoneNumber) && m.PhoneNumber != "—")
                                    {
                                        <span class="ms-2"><i class="bi bi-telephone me-1"></i>@m.PhoneNumber</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span style="font-weight:600; font-size:0.85rem; color:#374151;">@m.GymName</span>
                            </td>
                            <td>
                                <div style="font-weight:600; font-size:0.85rem;">@m.PackageName</div>
                                <div style="font-size:0.75rem; color:#888;">@m.PackageTypeLabel</div>
                            </td>
                            <td>
                                <div style="font-size:0.82rem;">
                                    <span>@m.StartDate.ToString("dd/MM/yyyy")</span> &rarr;
                                    <strong style="color:#111;">@m.EndDate.ToString("dd/MM/yyyy")</strong>
                                </div>
                            </td>
                            <td>
                                <span class="@m.StatusBadgeClass">
                                    @m.StatusLabel
                                </span>
                            </td>
                            <td class="text-end">
                                <a id="btn-view-member-@m.MemberId"
                                   asp-controller="OwnerMember"
                                   asp-action="Details"
                                   asp-route-memberId="@m.MemberId"
                                   asp-route-gymId="@m.GymId"
                                   class="btn-owner-secondary">
                                    <i class="bi bi-eye me-1"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
