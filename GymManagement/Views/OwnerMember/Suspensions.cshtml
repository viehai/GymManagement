@model List<GymManagement.ViewModels.SuspensionItemViewModel>

@{
    ViewData["Title"] = "Quản lý đình chỉ hội viên";
    Layout = "_OwnerAdminLayout";

    var myGyms = ViewBag.MyGyms as List<GymManagement.Models.Gym> ?? new List<GymManagement.Models.Gym>();
    int? selectedGymId = ViewBag.SelectedGymId as int?;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
}

<!-- Top Header & Filters -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 style="font-family:'Montserrat',sans-serif; font-size:1.25rem; font-weight:800; color:#111; margin:0 0 4px;">
            <i class="bi bi-slash-circle text-danger me-2"></i>Danh sách đình chỉ hội viên
        </h2>
        <p style="margin:0; font-size:0.85rem; color:#888;">
            Theo dõi, ban hành và gỡ bỏ các quyết định đình chỉ tại các cơ sở phòng Gym của bạn.
        </p>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <!-- Dropdown lọc theo phòng Gym -->
        @if (myGyms.Any())
        {
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="hidden" name="status" value="@selectedStatus" />
                <label style="font-size:0.8rem; font-weight:600; color:#555; white-space:nowrap;">Lọc theo Gym:</label>
                <select name="gymId" class="form-select form-select-sm" style="border-radius:6px; min-width:200px;" onchange="this.form.submit()">
                    <option value="">-- Tất cả cơ sở (@myGyms.Count) --</option>
                    @foreach (var g in myGyms)
                    {
                        <option value="@g.Id" selected="@(selectedGymId == g.Id)">@g.Name</option>
                    }
                </select>
            </form>
        }

        <a asp-controller="OwnerMember" asp-action="Index" asp-route-gymId="@selectedGymId" class="btn-owner-secondary">
            <i class="bi bi-people me-1"></i> DS Hội viên
        </a>
    </div>
</div>

<!-- Status Filter Tabs -->
<div class="d-flex align-items-center gap-2 mb-4 overflow-auto pb-1">
    <a asp-controller="OwnerMember" asp-action="Suspensions" asp-route-gymId="@selectedGymId" asp-route-status="All"
       class="btn @(selectedStatus == "All" ? "btn-dark text-white" : "btn-light text-muted")"
       style="font-size:0.82rem; font-weight:600; border-radius:8px; padding:0.45rem 1rem;">
        Tất cả
    </a>
    <a asp-controller="OwnerMember" asp-action="Suspensions" asp-route-gymId="@selectedGymId" asp-route-status="Active"
       class="btn @(selectedStatus == "Active" ? "btn-danger text-white" : "btn-light text-muted")"
       style="font-size:0.82rem; font-weight:600; border-radius:8px; padding:0.45rem 1rem;">
        <i class="bi bi-slash-circle-fill me-1"></i> Đang hiệu lực
    </a>
    <a asp-controller="OwnerMember" asp-action="Suspensions" asp-route-gymId="@selectedGymId" asp-route-status="Lifted"
       class="btn @(selectedStatus == "Lifted" ? "btn-success text-white" : "btn-light text-muted")"
       style="font-size:0.82rem; font-weight:600; border-radius:8px; padding:0.45rem 1rem;">
        <i class="bi bi-check-circle-fill me-1"></i> Đã gỡ bỏ
    </a>
    <a asp-controller="OwnerMember" asp-action="Suspensions" asp-route-gymId="@selectedGymId" asp-route-status="Expired"
       class="btn @(selectedStatus == "Expired" ? "btn-secondary text-white" : "btn-light text-muted")"
       style="font-size:0.82rem; font-weight:600; border-radius:8px; padding:0.45rem 1rem;">
        <i class="bi bi-clock-history me-1"></i> Đã hết hạn
    </a>
</div>

<!-- Main Content Card -->
<div class="content-card">
    <div class="content-card-header">
        <h5 class="content-card-title">
            <i class="bi bi-shield-exclamation me-2"></i>Quyết định đình chỉ (@Model.Count bản ghi)
        </h5>
    </div>

    @if (!Model.Any())
    {
        <div style="padding:4rem 1.5rem; text-align:center; color:#999;">
            <i class="bi bi-shield-check" style="font-size:3rem; color:#10b981; display:block; margin-bottom:0.8rem;"></i>
            <p style="font-size:0.95rem; font-weight:600; color:#374151; margin:0 0 4px;">Không có quyết định đình chỉ nào</p>
            <p style="font-size:0.82rem; color:#888; margin:0;">
                Tất cả hội viên tại cơ sở này hiện đang tuân thủ tốt nội quy hoạt động.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Hội viên</th>
                        <th>Cơ sở Gym</th>
                        <th>Hình thức kỷ luật</th>
                        <th>Thời hạn</th>
                        <th>Lý do vi phạm</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr id="suspension-row-@s.Id" style="@(s.IsCurrentlyActive ? "background:#fff8f8;" : "")">
                            <td>
                                <div style="font-weight:700; color:#111;">@s.MemberName</div>
                                <div style="font-size:0.78rem; color:#888;">
                                    <i class="bi bi-envelope me-1"></i>@s.MemberEmail
                                </div>
                            </td>
                            <td>
                                <span style="font-weight:600; font-size:0.85rem; color:#374151;">@s.GymName</span>
                            </td>
                            <td>
                                @if (s.SuspensionType == "Permanent")
                                {
                                    <span class="badge" style="background:#fee2e2; color:#991b1b; border:1px solid #f87171; font-weight:700; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-shield-x me-1"></i> Vĩnh viễn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#fef3c7; color:#92400e; border:1px solid #fcd34d; font-weight:700; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-hourglass-split me-1"></i> Có thời hạn
                                    </span>
                                }
                            </td>
                            <td>
                                <div style="font-size:0.82rem;">
                                    <div><span style="color:#888;">Bắt đầu:</span> <strong>@s.StartDate.ToString("dd/MM/yyyy")</strong></div>
                                    @if (s.SuspensionType == "Permanent")
                                    {
                                        <div class="text-danger" style="font-size:0.75rem; font-weight:600;">Không thời hạn</div>
                                    }
                                    else
                                    {
                                        <div><span style="color:#888;">Hết hạn:</span> <strong style="color:#111;">@(s.EndDate.HasValue ? s.EndDate.Value.ToString("dd/MM/yyyy") : "—")</strong></div>
                                    }
                                </div>
                            </td>
                            <td style="max-width:240px;">
                                <div style="font-size:0.82rem; color:#1f2937; word-break:break-word;" title="@s.Reason">
                                    @s.Reason
                                </div>
                                <div style="font-size:0.72rem; color:#9ca3af; margin-top:3px;">
                                    Bởi: @s.SuspendedByUserName • @s.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td>
                                @if (s.Status == "Lifted")
                                {
                                    <span class="badge" style="background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; font-weight:700; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-check2 me-1"></i> Đã gỡ bỏ
                                    </span>
                                    @if (!string.IsNullOrEmpty(s.LiftedReason))
                                    {
                                        <div style="font-size:0.72rem; color:#6b7280; margin-top:2px;" title="@s.LiftedReason">
                                            Lý do: @(s.LiftedReason.Length > 30 ? s.LiftedReason.Substring(0, 30) + "..." : s.LiftedReason)
                                        </div>
                                    }
                                }
                                else if (!s.IsCurrentlyActive)
                                {
                                    <span class="badge" style="background:#f3f4f6; color:#6b7280; border:1px solid #e5e7eb; font-weight:600; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-clock-history me-1"></i> Đã hết hạn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#ef4444; color:#fff; font-weight:700; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-slash-circle me-1"></i> Đang hiệu lực
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (s.IsCurrentlyActive)
                                {
                                    <button type="button"
                                            class="btn-owner-secondary"
                                            style="border-color:#10b981; color:#047857;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#liftSuspensionModal"
                                            data-suspension-id="@s.Id"
                                            data-member-name="@s.MemberName">
                                        <i class="bi bi-check-circle me-1"></i> Gỡ đình chỉ
                                    </button>
                                }
                                else
                                {
                                    <span style="font-size:0.75rem; color:#9ca3af; font-style:italic;">Hoàn tất</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Gỡ đình chỉ -->
<div class="modal fade" id="liftSuspensionModal" tabindex="-1" aria-labelledby="liftSuspensionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);">
            <form asp-controller="OwnerMember" asp-action="LiftSuspension" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="suspensionId" id="modalSuspensionId" value="" />

                <div class="modal-header" style="border-bottom:1px solid #f0f0f0; padding:1.2rem 1.5rem;">
                    <h5 class="modal-title" id="liftSuspensionModalLabel" style="font-size:1rem; font-weight:700; color:#111;">
                        <i class="bi bi-check2-circle text-success me-2"></i>Gỡ bỏ lệnh đình chỉ
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" style="padding:1.5rem;">
                    <p style="font-size:0.9rem; color:#4b5563; margin-bottom:1rem;">
                        Bạn đang thực hiện gỡ đình chỉ cho hội viên <strong id="modalMemberName" style="color:#111;">—</strong>.
                        Sau khi gỡ, hội viên này sẽ được khôi phục quyền mua vé và sử dụng dịch vụ bình thường tại cơ sở.
                    </p>

                    <div class="owner-form-group">
                        <label for="liftedReason" style="font-size:0.82rem; font-weight:600; color:#374151;">Lý do gỡ đình chỉ (tuỳ chọn):</label>
                        <textarea name="liftedReason" id="liftedReason" class="form-control" rows="3" placeholder="Nhập lý do gỡ đình chỉ (ví dụ: Đã khắc phục vi phạm, cam kết không tái phạm...)"></textarea>
                    </div>
                </div>

                <div class="modal-footer" style="border-top:1px solid #f0f0f0; padding:1rem 1.5rem;">
                    <button type="button" class="btn-owner-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn-owner-primary" style="background:#10b981; border-color:#10b981;">
                        <i class="bi bi-check-lg me-1"></i> Xác nhận gỡ đình chỉ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const liftModal = document.getElementById('liftSuspensionModal');
        if (liftModal) {
            liftModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const suspensionId = button.getAttribute('data-suspension-id');
                const memberName = button.getAttribute('data-member-name');

                document.getElementById('modalSuspensionId').value = suspensionId;
                document.getElementById('modalMemberName').textContent = memberName;
            });
        }
    </script>
}
