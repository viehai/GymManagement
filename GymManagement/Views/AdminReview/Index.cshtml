@model GymManagement.ViewModels.AdminReviewIndexViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Giám sát Đánh giá Toàn sàn";
}

<!-- Header & Quick Actions -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Giám sát Đánh giá &amp; Nhận xét</h4>
        <p class="text-muted small mb-0">Theo dõi toàn bộ đánh giá từ hội viên trên toàn bộ các phòng gym thuộc sàn.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="BannedWords" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
            <i class="bi bi-shield-slash"></i> Cấu hình Từ cấm
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef3c7; color:#d97706;">
                <i class="bi bi-star-fill"></i>
            </div>
            <div class="stat-value">@(Model.TotalReviewsCount > 0 ? Model.SystemAverageRating.ToString("0.0") : "—")</div>
            <div class="stat-label">Điểm trung bình toàn sàn</div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e0e7ff; color:#4f46e5;">
                <i class="bi bi-chat-quote-fill"></i>
            </div>
            <div class="stat-value">@Model.TotalReviewsCount</div>
            <div class="stat-label">Tổng lượt đánh giá</div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fee2e2; color:#dc2626;">
                <i class="bi bi-eye-slash-fill"></i>
            </div>
            <div class="stat-value">@Model.HiddenReviewsCount</div>
            <div class="stat-label">Đánh giá đang bị ẩn</div>
        </div>
    </div>
</div>

<!-- Filters form -->
<div class="content-card mb-4">
    <div class="content-card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Gym filter -->
            <div class="col-12 col-md-3">
                <select name="gymId" class="form-select form-select-sm">
                    <option value="">-- Tất cả Phòng Gym --</option>
                    @foreach (var g in Model.AllGyms)
                    {
                        <option value="@g.Id" selected="@(g.Id == Model.FilterGymId ? "selected" : null)">@g.Name</option>
                    }
                </select>
            </div>

            <!-- Rating filter -->
            <div class="col-6 col-md-2">
                <select name="rating" class="form-select form-select-sm">
                    <option value="">-- Số sao --</option>
                    @for (int s = 5; s >= 1; s--)
                    {
                        <option value="@s" selected="@(Model.FilterRating == s ? "selected" : null)">@s sao</option>
                    }
                </select>
            </div>

            <!-- Status filter -->
            <div class="col-6 col-md-2">
                <select name="isVisible" class="form-select form-select-sm">
                    <option value="">-- Trạng thái --</option>
                    <option value="true" selected="@(Model.FilterVisibility == true ? "selected" : null)">Hiển thị</option>
                    <option value="false" selected="@(Model.FilterVisibility == false ? "selected" : null)">Đang ẩn</option>
                </select>
            </div>

            <!-- Search input -->
            <div class="col-12 col-md-3">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm theo tên hội viên, nội dung..." value="@Model.SearchKeyword" />
            </div>

            <!-- Submit button -->
            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-dark flex-grow-1">
                    <i class="bi bi-search me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Table of reviews -->
<div class="content-card">
    <div class="content-card-header">
        <h5>Danh sách đánh giá (@Model.TotalItems)</h5>
    </div>
    <div class="content-card-body p-0">
        @if (!Model.Reviews.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                Không tìm thấy đánh giá nào.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table data-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th style="width: 60px;">ID</th>
                            <th>Phòng Gym</th>
                            <th>Hội viên</th>
                            <th style="width: 110px;">Đánh giá</th>
                            <th>Nội dung nhận xét</th>
                            <th style="width: 110px;">Trạng thái</th>
                            <th style="width: 140px;">Thời gian</th>
                            <th style="width: 120px;" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Reviews)
                        {
                            <tr>
                                <td class="text-muted small">#@r.Id</td>
                                <td>
                                    <strong class="text-dark">@r.GymName</strong>
                                    <div class="text-muted small" style="font-size:0.75rem;">ID: @r.GymId</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@r.MemberName</div>
                                    <div class="text-muted small" style="font-size:0.75rem;">@r.MemberId[..Math.Min(8, r.MemberId.Length)]…</div>
                                </td>
                                <td>
                                    <div class="text-warning text-nowrap" style="font-size:0.85rem;">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star text-muted")"></i>
                                        }
                                        <span class="ms-1 fw-bold text-dark">@r.Rating</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                                    {
                                        <div style="max-width: 320px; font-size: 0.85rem; line-height: 1.4;">
                                            @r.Comment
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Không có chữ</span>
                                    }

                                    @if (r.HasOwnerReply)
                                    {
                                        <div class="mt-1 p-1 px-2 bg-light border-start border-2 border-primary small" style="font-size: 0.75rem; max-width: 320px;">
                                            <span class="fw-bold text-primary">Chủ phòng:</span> @r.OwnerReply
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (r.IsVisible)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.7rem;">
                                            <i class="bi bi-eye me-1"></i>Hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="font-size: 0.7rem;">
                                            <i class="bi bi-eye-slash me-1"></i>Đang ẩn
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @r.CreatedAt.ToString("dd/MM/yyyy")
                                    <div style="font-size: 0.72rem;">@r.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1">
                                        <!-- Nút Ẩn / Hiện -->
                                        <form method="post" asp-action="ToggleVisibility" asp-route-id="@r.Id" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(r.IsVisible ? "btn-outline-warning" : "btn-outline-success") py-1 px-2" title="@(r.IsVisible ? "Ẩn đánh giá" : "Hiện đánh giá")">
                                                <i class="bi @(r.IsVisible ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>

                                        <!-- Nút Xóa vĩnh viễn -->
                                        <form method="post" asp-action="Delete" asp-route-id="@r.Id" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" onsubmit="return confirm('Bạn có chắc chắn muốn XÓA VĨNH VIỄN đánh giá này khỏi hệ thống?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Xóa vĩnh viễn">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            @if (Model.TotalPages > 1)
            {
                <div class="p-3 border-top d-flex justify-content-center">
                    <nav aria-label="Phân trang">
                        <ul class="pagination pagination-sm mb-0">
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = p, gymId = Model.FilterGymId, rating = Model.FilterRating, isVisible = Model.FilterVisibility, search = Model.SearchKeyword })">
                                        @p
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
