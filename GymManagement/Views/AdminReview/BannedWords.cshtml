@model GymManagement.ViewModels.BannedWordsManagementViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cấu hình Từ ngữ Cấm (Banned Words)";
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Cấu hình Bộ lọc Từ ngữ Cấm</h4>
        <p class="text-muted small mb-0">Hệ thống sẽ tự động quét và chặn các đánh giá, nhận xét chứa từ ngữ trong danh sách này.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại Giám sát Đánh giá
        </a>
        <form method="post" asp-action="SeedDefaultBannedWords" onsubmit="return confirm('Nạp bộ từ cấm mặc định vào hệ thống?');" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-warning">
                <i class="bi bi-lightning-charge me-1"></i> Nạp từ cấm mẫu (Mặc định)
            </button>
        </form>
    </div>
</div>

<div class="row g-4">
    <!-- Form Thêm từ mới -->
    <div class="col-12 col-lg-4">
        <div class="content-card">
            <div class="content-card-header">
                <h5><i class="bi bi-plus-circle me-1"></i> Thêm từ cấm mới</h5>
            </div>
            <div class="content-card-body p-3">
                <form method="post" asp-action="AddBannedWord">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="inputWord" class="form-label small fw-semibold text-dark">Từ hoặc cụm từ bị cấm:</label>
                        <input type="text" id="inputWord" name="word" class="form-control form-control-sm" placeholder="VD: lừa đảo, đm, vô văn hóa..." required maxlength="100" />
                        <small class="text-muted" style="font-size:0.7rem;">Không phân biệt chữ hoa hay chữ thường.</small>
                    </div>

                    <div class="mb-3">
                        <label for="selectCategory" class="form-label small fw-semibold text-dark">Phân loại vi phạm:</label>
                        <select id="selectCategory" name="category" class="form-select form-select-sm">
                            <option value="Thô tục">Thô tục, tục tĩu</option>
                            <option value="Xúc phạm">Lăng mạ, xúc phạm</option>
                            <option value="Lừa đảo">Lừa đảo, gian lận, scam</option>
                            <option value="Quảng cáo">Quảng cáo, spam link</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-sm btn-admin-primary w-100 justify-content-center">
                        <i class="bi bi-plus-lg me-1"></i> Thêm vào danh sách cấm
                    </button>
                </form>
            </div>
        </div>

        <div class="alert alert-info border-0 rounded-3 small p-3" style="background-color: #eff6ff; color: #1e40af;">
            <i class="bi bi-info-circle-fill me-1"></i> <strong>Quy tắc quét tự động:</strong>
            <ul class="mb-0 mt-2 ps-3" style="font-size:0.75rem; line-height: 1.5;">
                <li>Hệ thống áp dụng biểu thức chính quy (Regex) quét theo biên giới từ độc lập để tránh bắt nhầm từ ngữ hợp lệ.</li>
                <li>Khi hội viên gửi bình luận chứa từ cấm, hệ thống sẽ chặn và hiển thị rõ từ ngữ cần chỉnh sửa.</li>
            </ul>
        </div>
    </div>

    <!-- Danh sách từ cấm hiện tại -->
    <div class="col-12 col-lg-8">
        <div class="content-card">
            <div class="content-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5>Danh sách từ ngữ cấm (@Model.BannedWords.Count)</h5>

                <!-- Search & Category filter -->
                <form method="get" asp-action="BannedWords" class="d-flex gap-2">
                    <select name="category" class="form-select form-select-sm" style="width: 140px;" onchange="this.form.submit()">
                        <option value="">Tất cả phân loại</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c" selected="@(c == Model.SelectedCategory ? "selected" : null)">@c</option>
                        }
                    </select>
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm từ..." value="@Model.SearchKeyword" style="width: 140px;" />
                    <button type="submit" class="btn btn-sm btn-dark">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <div class="content-card-body p-0">
                @if (!Model.BannedWords.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-shield-check fs-2 d-block mb-2 text-success"></i>
                        Chưa có từ ngữ cấm nào trong danh mục.
                        <div class="mt-2">
                            <form method="post" asp-action="SeedDefaultBannedWords" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-lightning-charge me-1"></i> Khởi tạo nhanh từ cấm mẫu
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table data-table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Từ ngữ bị cấm</th>
                                    <th style="width: 160px;">Phân loại</th>
                                    <th style="width: 150px;">Ngày thêm</th>
                                    <th style="width: 80px;" class="text-end">Xóa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int idx = 1; }
                                @foreach (var b in Model.BannedWords)
                                {
                                    <tr>
                                        <td class="text-muted small">@idx</td>
                                        <td>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fs-6">
                                                @b.Word
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-dark" style="font-size:0.75rem;">
                                                @(b.Category ?? "Chung")
                                            </span>
                                        </td>
                                        <td class="text-muted small">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <form method="post" asp-action="DeleteBannedWord" asp-route-id="@b.Id" onsubmit="return confirm('Xóa từ cấm này khỏi danh sách?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Xóa từ cấm này">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
