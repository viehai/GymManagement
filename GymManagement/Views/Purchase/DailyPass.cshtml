<!-- Đường dẫn file: Views/Purchase/DailyPass.cshtml -->
@model GymManagement.ViewModels.PurchaseCheckoutViewModel

@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Mua vé ngày — " + Model.GymName;
}

<style>
    .purchase-hero {
        background: var(--ink-dark, #252525);
        padding: 2.5rem 0 2rem;
    }
    .purchase-hero-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
        margin-bottom: 0.4rem;
    }
    .purchase-hero h1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(1.4rem, 3vw, 2rem);
        color: #fff;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .purchase-breadcrumb {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-top: 0.75rem;
    }
    .purchase-breadcrumb a { color: rgba(255,255,255,0.45); text-decoration: none; }
    .purchase-breadcrumb a:hover { color: #fff; }

    .purchase-body { padding: 3rem 0 5rem; }
    .section-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #7D7D7D;
        margin-bottom: 1.2rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid #CFCFCF;
    }

    .gym-preview-card {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        border: 1px solid #CFCFCF;
        padding: 1rem 1.2rem;
        margin-bottom: 2rem;
    }
    .gym-preview-img {
        width: 72px;
        height: 72px;
        object-fit: cover;
        flex-shrink: 0;
        background: #f0f0f0;
    }
    .gym-preview-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 1rem;
        color: #252525;
        margin: 0 0 0.2rem;
    }
    .gym-preview-addr {
        font-size: 0.82rem;
        color: #7D7D7D;
        margin: 0;
    }

    .ticket-card {
        border: 2px solid #252525;
        padding: 1.8rem 2rem;
        position: relative;
        overflow: hidden;
        background: #fff;
    }
    .ticket-card::before {
        content: 'VÉ NGÀY';
        position: absolute;
        top: 1rem; right: 1rem;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 2px;
        color: #CFCFCF;
    }
    .ticket-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 1.1rem;
        color: #252525;
        margin: 0 0 0.3rem;
    }
    .ticket-price {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 2rem;
        color: #252525;
        letter-spacing: -1px;
        margin: 0.5rem 0;
    }
    .ticket-price span {
        font-size: 0.9rem;
        font-weight: 400;
        color: #7D7D7D;
        letter-spacing: 0;
    }
    .ticket-meta {
        font-size: 0.85rem;
        color: #545454;
        margin-top: 0.5rem;
        border-top: 1px solid #CFCFCF;
        padding-top: 0.8rem;
    }
    .ticket-meta .meta-row {
        display: flex;
        justify-content: space-between;
        padding: 0.3rem 0;
    }
    .ticket-meta .meta-label { color: #7D7D7D; font-size: 0.8rem; }
    .ticket-meta .meta-value { font-weight: 600; font-size: 0.8rem; font-family: 'Montserrat', sans-serif; }

    .btn-purchase {
        display: block;
        width: 100%;
        background: #252525;
        color: #fff;
        border: none;
        border-radius: 0;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 1rem;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 1.2rem;
    }
    .btn-purchase:hover { background: #545454; }

    .btn-back {
        display: inline-block;
        margin-top: 1rem;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #7D7D7D;
        text-decoration: none;
    }
    .btn-back:hover { color: #252525; }

    .info-note {
        font-size: 0.78rem;
        color: #7D7D7D;
        border-left: 2px solid #CFCFCF;
        padding-left: 0.8rem;
        margin-top: 1rem;
    }
</style>

<!-- Hero -->
<div class="purchase-hero">
    <div class="container">
        <p class="purchase-hero-label">Mua vé</p>
        <h1>Vé ngày — @Model.GymName</h1>
        <nav class="purchase-breadcrumb" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang Chủ</a> /
            <a asp-controller="Gym" asp-action="Search">Tìm Gym</a> /
            <a asp-controller="Gym" asp-action="Details" asp-route-id="@Model.GymId">@Model.GymName</a> /
            <span style="color:rgba(255,255,255,0.75);">Mua vé ngày</span>
        </nav>
    </div>
</div>

<div class="container purchase-body">
    <div class="row g-5">
        <div class="col-12 col-lg-7">
            <p class="section-label">Thông tin phòng Gym</p>
            <div class="gym-preview-card">
                <img class="gym-preview-img"
                     src="@(string.IsNullOrWhiteSpace(Model.GymImage) ? "https://static.wixstatic.com/media/7e9c4c_5d4a9443f1fd4b7a8f8d0ca05ef2b8a8~mv2.jpg/v1/fill/w_400,h_400,al_c,q_85,enc_avif,quality_auto/7e9c4c_5d4a9443f1fd4b7a8f8d0ca05ef2b8a8~mv2.jpg" : Model.GymImage)"
                     alt="@Model.GymName" />
                <div>
                    <p class="gym-preview-name">@Model.GymName</p>
                    <p class="gym-preview-addr"><i class="bi bi-geo-alt me-1"></i>@Model.GymAddress</p>
                </div>
            </div>

            <p class="section-label">Chi tiết vé ngày</p>
            <div class="ticket-card">
                <p class="ticket-name">@Model.PackageName</p>
                <p class="ticket-price">@Model.Price.ToString("N0") đ <span>/ lượt vào</span></p>
                <div class="ticket-meta">
                    <div class="meta-row">
                        <span class="meta-label">Loại vé</span>
                        <span class="meta-value">Vé ngày (1 lượt)</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Ngày hiệu lực</span>
                        <span class="meta-value">@DateTime.Today.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Hết hiệu lực</span>
                        <span class="meta-value">@DateTime.Today.ToString("dd/MM/yyyy") lúc 23:59</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Thanh toán</span>
                        <span class="meta-value">VietQR (Napas 24/7)</span>
                    </div>
                </div>
            </div>

            <p class="info-note">
                <i class="bi bi-info-circle me-1"></i>
                Vé ngày có hiệu lực đến hết ngày hôm nay. Sau khi thanh toán thành công, hóa đơn sẽ được ghi nhận ngay trong hệ thống.
            </p>
        </div>

        <div class="col-12 col-lg-5">
            <p class="section-label">Xác nhận & Thanh toán</p>

            <form asp-controller="Purchase" asp-action="DailyPass" asp-route-gymId="@Model.GymId" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="GymId"           value="@Model.GymId" />
                <input type="hidden" name="GymName"         value="@Model.GymName" />
                <input type="hidden" name="GymAddress"      value="@Model.GymAddress" />
                <input type="hidden" name="GymImage"        value="@Model.GymImage" />
                <input type="hidden" name="PackageId"       value="@Model.PackageId" />
                <input type="hidden" name="PackageName"     value="@Model.PackageName" />
                <input type="hidden" name="PackageType"     value="@Model.PackageType" />
                <input type="hidden" name="Price"           value="@Model.Price" />

                <div style="border:1px solid #CFCFCF; padding:1.2rem 1.4rem; margin-bottom:1rem;">
                    <div class="meta-row" style="display:flex;justify-content:space-between;padding:0.3rem 0;">
                        <span style="font-size:0.82rem;color:#7D7D7D;">Vé ngày</span>
                        <span style="font-family:'Montserrat',sans-serif;font-weight:700;font-size:0.82rem;">@Model.Price.ToString("N0") đ</span>
                    </div>
                    <div class="meta-row" style="display:flex;justify-content:space-between;padding:0.3rem 0;border-top:1px solid #CFCFCF;margin-top:0.5rem;padding-top:0.7rem;">
                        <span style="font-size:0.82rem;font-weight:700;font-family:'Montserrat',sans-serif;">TỔNG CỘNG</span>
                        <span style="font-family:'Montserrat',sans-serif;font-weight:900;font-size:1.1rem;color:#252525;">@Model.Price.ToString("N0") đ</span>
                    </div>
                </div>

                <button id="btn-confirm-daily-@Model.PackageId" type="submit" class="btn-purchase">
                    <i class="bi bi-credit-card me-2"></i>Xác nhận & Thanh toán
                </button>
            </form>

            <a class="btn-back" asp-controller="Gym" asp-action="Details" asp-route-id="@Model.GymId">
                <i class="bi bi-arrow-left me-1"></i>Quay lại chi tiết gym
            </a>
        </div>
    </div>
</div>
