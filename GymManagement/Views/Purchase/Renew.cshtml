<!-- Đường dẫn file: Views/Purchase/Renew.cshtml -->
@model GymManagement.ViewModels.RenewMembershipViewModel

@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Gia hạn gói tập — " + Model.GymName;
}

<style>
    /* ═══════════════════════════════════════════════
       RENEW MEMBERSHIP — INK WASH PALETTE
    ═══════════════════════════════════════════════ */
    .renew-hero {
        background: #252525;
        padding: 2.8rem 0 2.2rem;
        color: #fff;
    }
    .renew-hero-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
        margin-bottom: 0.4rem;
    }
    .renew-hero h1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(1.4rem, 3vw, 2rem);
        color: #fff;
        margin: 0;
    }
    .renew-breadcrumb {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-top: 0.75rem;
    }
    .renew-breadcrumb a { color: rgba(255,255,255,0.45); text-decoration: none; }
    .renew-breadcrumb a:hover { color: #fff; }

    .renew-body {
        padding: 3rem 0 5rem;
        background: #fafafa;
    }

    .ink-panel {
        background: #fff;
        border: 1px solid #CFCFCF;
        padding: 1.8rem;
        margin-bottom: 1.5rem;
    }
    .ink-panel-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #252525;
        padding-bottom: 0.8rem;
        margin-bottom: 1.2rem;
        border-bottom: 1px solid #CFCFCF;
    }

    /* Option Cards */
    .renew-option-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .renew-option-item {
        border: 1px solid #CFCFCF;
        padding: 1.2rem 1.4rem;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
    }
    .renew-option-item:hover {
        border-color: #7D7D7D;
    }
    .renew-option-item.selected {
        border: 2px solid #252525;
        background: #fff;
    }

    .custom-radio-ink {
        width: 20px;
        height: 20px;
        accent-color: #252525;
        cursor: pointer;
    }

    .option-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 0.95rem;
        color: #252525;
        margin: 0 0 0.2rem;
    }
    .option-price {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 1.15rem;
        color: #252525;
        margin-left: auto;
        text-align: right;
    }
    .option-date-preview {
        font-size: 0.78rem;
        color: #7D7D7D;
        margin: 0;
    }

    .btn-renew-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #252525;
        color: #fff !important;
        border: 1px solid #252525;
        border-radius: 0;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 1rem;
        width: 100%;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 1rem;
    }
    .btn-renew-submit:hover {
        background: #545454;
    }
</style>

<!-- Hero -->
<div class="renew-hero">
    <div class="container">
        <p class="renew-hero-label">Gia hạn vé</p>
        <h1>@Model.GymName</h1>
        <nav class="renew-breadcrumb" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang Chủ</a> /
            <a asp-controller="Member" asp-action="MyMemberships">Gói tập của tôi</a> /
            <span style="color:rgba(255,255,255,0.75);">Gia hạn</span>
        </nav>
    </div>
</div>

<div class="renew-body">
    <div class="container">
        <form asp-controller="Purchase" asp-action="Renew" asp-route-membershipId="@Model.MembershipId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="membershipId" value="@Model.MembershipId" />

            <div class="row g-4">
                <!-- Cột trái: Thông tin & Chọn gói -->
                <div class="col-12 col-lg-8">
                    <!-- Trạng thái vé hiện tại -->
                    <div class="ink-panel">
                        <h2 class="ink-panel-title"><i class="bi bi-info-circle me-2"></i>Vé hiện tại</h2>
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <p style="font-family:'Montserrat',sans-serif; font-weight:800; font-size:1.05rem; margin:0 0 0.2rem; color:#252525;">
                                    @Model.CurrentPackageName
                                </p>
                                <p style="font-size:0.82rem; color:#7D7D7D; margin:0;">
                                    <i class="bi bi-geo-alt me-1"></i>@Model.GymAddress
                                </p>
                            </div>
                            <div class="text-end">
                                <span style="font-size:0.75rem; color:#7D7D7D; display:block;">Hạn sử dụng hiện tại</span>
                                <span style="font-family:'Montserrat',sans-serif; font-weight:800; font-size:1.05rem; color:#252525;">
                                    @Model.CurrentEndDate.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Danh sách các gói gia hạn -->
                    <div class="ink-panel">
                        <h2 class="ink-panel-title"><i class="bi bi-card-checklist me-2"></i>Chọn gói gia hạn</h2>
                        <div class="renew-option-list">
                            @foreach (var pkg in Model.AvailablePackages)
                            {
                                bool isSelected = pkg.Id == Model.SelectedPackageId;
                                <label class="renew-option-item @(isSelected ? "selected" : "")" id="option-label-@pkg.Id">
                                    <input type="radio"
                                           name="selectedPackageId"
                                           value="@pkg.Id"
                                           class="custom-radio-ink"
                                           @(isSelected ? "checked" : "")
                                           onchange="updateSelection(this)" />
                                    <div class="flex-grow-1">
                                        <p class="option-title">@pkg.Name (@pkg.TypeLabel)</p>
                                        <p class="option-date-preview">
                                            <i class="bi bi-calendar-plus me-1"></i>Hạn mới sau khi cộng dồn: <strong>@pkg.CalculatedNewEndDate.ToString("dd/MM/yyyy")</strong>
                                        </p>
                                    </div>
                                    <div class="option-price">
                                        @pkg.Price.ToString("N0") đ
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Xác nhận -->
                <div class="col-12 col-lg-4">
                    <div class="ink-panel">
                        <h2 class="ink-panel-title"><i class="bi bi-credit-card me-2"></i>Thanh toán gia hạn</h2>
                        <p style="font-size:0.82rem; color:#7D7D7D; line-height:1.5; margin-bottom:1.2rem;">
                            Phương thức thanh toán: <strong>VNPay (Mô phỏng Sandbox)</strong>.
                            Hạn sử dụng của gói tập sẽ được tự động cộng dồn ngay sau khi xác nhận.
                        </p>

                        <button id="btn-confirm-renew" type="submit" class="btn-renew-submit">
                            <i class="bi bi-lock me-1"></i> Xác nhận gia hạn
                        </button>

                        <a asp-controller="Member" asp-action="MembershipDetails" asp-route-id="@Model.MembershipId"
                           style="display:block; text-align:center; font-family:'Montserrat',sans-serif; font-weight:600; font-size:0.7rem; letter-spacing:1px; text-transform:uppercase; color:#7D7D7D; text-decoration:none; margin-top:1rem;">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết vé
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function updateSelection(radio) {
        document.querySelectorAll('.renew-option-item').forEach(el => el.classList.remove('selected'));
        radio.closest('.renew-option-item').classList.add('selected');
    }
</script>
