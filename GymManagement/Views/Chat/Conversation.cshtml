@{
    var gym          = ViewBag.Gym          as GymManagement.Models.Gym;
    var conv         = ViewBag.Conversation as GymManagement.Models.ChatConversation;
    var messages     = ViewBag.Messages     as List<GymManagement.Models.ChatMessage> ?? new();
    string currentId = ViewBag.CurrentUserId as string ?? "";
    ViewData["Title"] = $"Chat — {gym?.Name}";
    Layout = "_MemberLayout";
}

<style>
    /* ════════════════════════════════════════════════
       CHAT CONVERSATION — INK WASH PALETTE
    ════════════════════════════════════════════════ */
    .chat-wrap {
        display: flex; flex-direction: column;
        height: calc(100vh - 90px); /* 90px = topbar height */
        max-height: 820px;
        background: #fff;
        border: 1px solid #CFCFCF;
        margin: 1.5rem 0 3rem;
    }

    /* Header bar */
    .chat-header {
        background: #252525; color: #fff;
        padding: .9rem 1.4rem;
        display: flex; align-items: center; gap: 12px;
        flex-shrink: 0; border-bottom: 1px solid #1a1a1a;
    }
    .chat-header-avatar {
        width: 38px; height: 38px;
        background: rgba(255,255,255,.12);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: .88rem;
    }
    .chat-header-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800; font-size: .92rem;
    }
    .chat-header-sub { font-size: .7rem; color: rgba(255,255,255,.5); margin-top: 1px; }
    .chat-header .back-btn {
        margin-left: auto;
        color: rgba(255,255,255,.6);
        font-size: .72rem; font-weight: 700;
        text-decoration: none; text-transform: uppercase; letter-spacing: .5px;
        border: 1px solid rgba(255,255,255,.2);
        padding: 4px 12px;
        transition: color .15s, border-color .15s;
    }
    .chat-header .back-btn:hover { color: #fff; border-color: rgba(255,255,255,.5); }

    /* Messages area */
    #messages-area {
        flex: 1; overflow-y: auto;
        padding: 1.2rem;
        display: flex; flex-direction: column; gap: 10px;
        background: #fafafa;
    }
    #messages-area::-webkit-scrollbar { width: 4px; }
    #messages-area::-webkit-scrollbar-track { background: transparent; }
    #messages-area::-webkit-scrollbar-thumb { background: #CFCFCF; }

    /* Load more */
    #load-more-btn {
        background: none; border: 1px solid #CFCFCF;
        padding: 5px 16px; font-size: .72rem; font-weight: 700;
        color: #7D7D7D; cursor: pointer; align-self: center;
        text-transform: uppercase; letter-spacing: .5px;
        transition: border-color .15s, color .15s;
    }
    #load-more-btn:hover { border-color: #252525; color: #252525; }

    /* Date separator */
    .date-sep {
        text-align: center; font-size: .65rem; color: #7D7D7D;
        font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
        position: relative;
    }
    .date-sep::before, .date-sep::after {
        content: ''; position: absolute; top: 50%;
        width: calc(50% - 60px); height: 1px; background: #CFCFCF;
    }
    .date-sep::before { left: 0; }
    .date-sep::after  { right: 0; }

    /* Message bubble */
    .msg-row {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        margin-bottom: 8px;
    }
    .msg-row.own {
        flex-direction: row-reverse;
    }

    .msg-sender-avatar {
        width: 32px;
        height: 32px;
        background: #7D7D7D;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .68rem;
        font-weight: 900;
        flex-shrink: 0;
        font-family: 'Montserrat', sans-serif;
    }
    .msg-row.own .msg-sender-avatar {
        background: #252525;
    }

    .msg-col {
        display: flex;
        flex-direction: column;
        max-width: 72%;
        min-width: 40px;
    }
    .msg-row.own .msg-col {
        align-items: flex-end;
    }
    .msg-row:not(.own) .msg-col {
        align-items: flex-start;
    }

    .msg-bubble {
        width: fit-content;
        max-width: 100%;
        padding: 0.6rem 0.95rem;
        font-size: 0.88rem;
        line-height: 1.5;
        word-break: break-word;
        white-space: pre-wrap;
    }
    .msg-row:not(.own) .msg-bubble {
        background: #fff;
        border: 1px solid #CFCFCF;
        color: #252525;
    }
    .msg-row.own .msg-bubble {
        background: #252525;
        color: #fff;
    }
    .msg-bubble img {
        max-width: 100%;
        max-height: 320px;
        margin-top: 6px;
        border: 1px solid rgba(255,255,255,.15);
        display: block;
    }
    .msg-time {
        font-size: .62rem;
        color: #7D7D7D;
        margin-top: 3px;
        white-space: nowrap;
    }
    .msg-row.own .msg-time {
        text-align: right;
    }
    .msg-row:not(.own) .msg-time {
        text-align: left;
    }

    /* Typing indicator */
    #typing-indicator {
        font-size: .72rem; color: #7D7D7D; font-style: italic;
        padding: 0 .3rem; min-height: 18px;
    }

    /* Input bar */
    .chat-input-bar {
        border-top: 1px solid #CFCFCF;
        padding: .9rem 1.2rem;
        background: #fff; flex-shrink: 0;
    }
    #image-preview-wrap {
        display: none;
        background: #fafafa; border: 1px solid #CFCFCF;
        padding: .5rem .8rem; margin-bottom: .6rem;
        font-size: .78rem; color: #545454;
        align-items: center; justify-content: space-between; gap: 8px;
    }
    #image-preview-wrap.show { display: flex; }
    .input-row { display: flex; gap: 8px; align-items: flex-end; }
    #msg-input {
        flex: 1; resize: none; overflow: hidden;
        border: 1px solid #CFCFCF; border-radius: 0;
        padding: .55rem .8rem; font-size: .88rem;
        font-family: 'Inter', sans-serif;
        max-height: 120px; min-height: 40px;
        transition: border-color .15s;
        background: #fff;
    }
    #msg-input:focus { outline: none; border-color: #252525; }

    .attach-btn {
        background: none; border: 1px solid #CFCFCF;
        width: 40px; height: 40px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        color: #7D7D7D; font-size: 1rem;
        transition: border-color .15s, color .15s;
    }
    .attach-btn:hover { border-color: #252525; color: #252525; }

    #send-btn {
        background: #252525; color: #fff; border: none;
        padding: 0 20px; height: 40px;
        font-family: 'Montserrat', sans-serif;
        font-size: .72rem; font-weight: 700;
        letter-spacing: .5px; text-transform: uppercase;
        cursor: pointer; transition: background .15s;
        white-space: nowrap;
    }
    #send-btn:hover { background: #545454; }
    #send-btn:disabled { background: #CFCFCF; cursor: not-allowed; }

    /* Image URL modal */
    .img-modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,.55); z-index: 9999;
        align-items: center; justify-content: center;
    }
    .img-modal-overlay.show { display: flex; }
    .img-modal {
        background: #fff; border: 2px solid #252525;
        padding: 1.8rem; width: 100%; max-width: 440px;
    }
    .img-modal h6 {
        font-family: 'Montserrat', sans-serif; font-weight: 900;
        margin-bottom: 1rem; text-transform: uppercase; letter-spacing: .5px;
    }
    .img-modal input {
        width: 100%; border: 1px solid #CFCFCF; border-radius: 0;
        padding: .5rem .7rem; font-size: .85rem;
        font-family: 'Inter', sans-serif;
    }
    .img-modal input:focus { outline: none; border-color: #252525; }
    .img-modal .btn-row { display: flex; gap: 8px; margin-top: 1rem; justify-content: flex-end; }
    .img-modal .btn-confirm {
        background: #252525; color: #fff; border: none;
        padding: 7px 18px; font-weight: 700; font-size: .78rem;
        cursor: pointer; text-transform: uppercase; letter-spacing: .5px;
        font-family: 'Montserrat', sans-serif;
    }
    .img-modal .btn-cancel {
        background: none; border: 1px solid #CFCFCF;
        padding: 7px 18px; font-weight: 700; font-size: .78rem;
        cursor: pointer; color: #545454;
    }
</style>

<div class="container">
    <div class="chat-wrap">

        <!-- HEADER -->
        <div class="chat-header">
            <div class="chat-header-avatar">@(gym?.Name?[0].ToString().ToUpper() ?? "G")</div>
            <div>
                <div class="chat-header-name">@gym?.Name</div>
                <div class="chat-header-sub">@gym?.Address</div>
            </div>
            <a href="/Chat" class="back-btn"><i class="bi bi-arrow-left me-1"></i>Inbox</a>
        </div>

        <!-- MESSAGES -->
        <div id="messages-area">
            <button id="load-more-btn" style="display:none;" onclick="loadMore()">
                <i class="bi bi-arrow-up me-1"></i>Tải thêm tin cũ
            </button>

            <div id="typing-indicator"></div>
            <div id="messages-container"></div>
        </div>

        <!-- INPUT BAR -->
        <div class="chat-input-bar">
            <div id="image-preview-wrap">
                <span><i class="bi bi-image me-1"></i>Ảnh: <span id="img-url-preview" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></span></span>
                <button onclick="clearImage()" style="background:none;border:none;color:#ef4444;cursor:pointer;font-size:.85rem;"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="input-row">
                <button class="attach-btn" onclick="document.getElementById('img-modal').classList.add('show')" title="Đính kèm ảnh URL">
                    <i class="bi bi-image"></i>
                </button>
                <textarea id="msg-input" placeholder="Nhập tin nhắn..." rows="1"
                          onkeydown="handleKeyDown(event)" oninput="autoResize(this)"></textarea>
                <button id="send-btn" onclick="sendMessage()">
                    <i class="bi bi-send-fill me-1"></i>Gửi
                </button>
            </div>
        </div>
    </div>
</div>

<!-- IMAGE URL MODAL -->
<div class="img-modal-overlay" id="img-modal">
    <div class="img-modal">
        <h6><i class="bi bi-image me-2"></i>Đính kèm ảnh qua URL</h6>
        <input type="url" id="img-url-input" placeholder="https://example.com/image.jpg" />
        <div class="btn-row">
            <button class="btn-cancel" onclick="document.getElementById('img-modal').classList.remove('show')">Huỷ</button>
            <button class="btn-confirm" onclick="confirmImage()">Xác nhận</button>
        </div>
    </div>
</div>

<!-- SignalR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const CONV_ID     = @conv?.Id;
    const CURRENT_ID  = '@currentId';
    const GYM_NAME    = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(gym?.Name ?? ""))';

    let pendingImageUrl = null;
    let oldestMsgId     = 0;
    let hasMore         = true;

    // ── Khởi tạo SignalR ──────────────────────────────────────────
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/chat")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveMessage", (msg) => {
        if (msg.conversationId === CONV_ID) {
            appendMessage({ ...msg, isOwn: msg.senderId === CURRENT_ID });
            // Đánh dấu đã đọc
            connection.invoke("MarkRead", CONV_ID).catch(() => {});
        }
    });

    connection.on("ReceiveBroadcast", (msg) => {
        // Nếu là broadcast từ chính gym này, có thể chèn hoặc hiển thị thông báo
        const banner = document.createElement('div');
        banner.style.cssText = 'background:#1e293b; color:#fff; padding:10px 14px; font-size:0.82rem; border-left:4px solid #f59e0b; margin:6px 0; border-radius:4px;';
        banner.innerHTML = `<strong><i class="bi bi-megaphone-fill text-warning me-1"></i>[THÔNG BÁO TỪ PHÒNG GYM]:</strong> ${esc(msg.content)}`;
        const container = document.getElementById('messages-container');
        if (container) {
            container.appendChild(banner);
            scrollToBottom();
        }
    });

    connection.on("MessageSent", (msg) => {
        appendMessage({ ...msg, isOwn: true });
        scrollToBottom();
    });

    async function startConnection() {
        try {
            await connection.start();
        } catch (e) {
            setTimeout(startConnection, 3000);
        }
    }
    startConnection();

    // ── Load lịch sử ban đầu ─────────────────────────────────────
    async function loadInitialMessages() {
        const msgs = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(messages.Select(m => new {
                id         = m.Id,
                senderId   = m.SenderId,
                senderName = m.Sender?.FullName ?? "?",
                senderRole = m.SenderRole,
                content    = m.Content,
                imageUrl   = m.ImageUrl,
                createdAt  = m.CreatedAt.ToString("HH:mm dd/MM/yyyy"),
                isOwn      = m.SenderId == currentId
            }).ToList(), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })
        );

        if (msgs.length === 50) {
            hasMore = true;
            document.getElementById('load-more-btn').style.display = '';
        }

        msgs.forEach(m => appendMessage(m, false));
        if (msgs.length > 0) oldestMsgId = msgs[0].id;
        scrollToBottom();
    }

    async function loadMore() {
        if (!hasMore || oldestMsgId === 0) return;
        const res  = await fetch(`/Chat/GetHistory?conversationId=${CONV_ID}&beforeId=${oldestMsgId}&pageSize=30`);
        const msgs = await res.json();
        if (msgs.length < 30) {
            hasMore = false;
            document.getElementById('load-more-btn').style.display = 'none';
        }
        const container = document.getElementById('messages-container');
        const scrollH   = container.parentElement.scrollHeight;
        msgs.reverse().forEach(m => prependMessage(m));
        if (msgs.length > 0) oldestMsgId = msgs[0].id;
        // Giữ vị trí scroll
        container.parentElement.scrollTop = container.parentElement.scrollHeight - scrollH;
    }

    // ── Render message ────────────────────────────────────────────
    function appendMessage(msg, scroll = true) {
        const container = document.getElementById('messages-container');
        container.appendChild(buildBubble(msg));
        if (scroll) scrollToBottom();
    }

    function prependMessage(msg) {
        const container = document.getElementById('messages-container');
        container.insertBefore(buildBubble(msg), container.firstChild);
    }

    function buildBubble(msg) {
        const isOwn = msg.isOwn || msg.senderId === CURRENT_ID;
        const initial = (msg.senderName || '?')[0].toUpperCase();

        const row = document.createElement('div');
        row.className = `msg-row ${isOwn ? 'own' : ''}`;
        row.dataset.msgId = msg.id;

        const avatar = `<div class="msg-sender-avatar" title="${esc(msg.senderName)}">${initial}</div>`;
        const imgHtml = msg.imageUrl
            ? `<img src="${esc(msg.imageUrl)}" alt="Ảnh" onerror="this.style.display='none'" />`
            : '';
        const bubble = `
            <div class="msg-col">
                <div class="msg-bubble">${esc(msg.content)}${imgHtml}</div>
                <div class="msg-time">${msg.createdAt}</div>
            </div>`;

        row.innerHTML = `${avatar}${bubble}`;
        return row;
    }

    function esc(str) {
        if (!str) return '';
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function scrollToBottom() {
        const area = document.getElementById('messages-area');
        area.scrollTop = area.scrollHeight;
    }

    // ── Gửi tin nhắn ─────────────────────────────────────────────
    async function sendMessage() {
        const input   = document.getElementById('msg-input');
        const content = input.value.trim();
        if (!content || connection.state !== 'Connected') return;

        document.getElementById('send-btn').disabled = true;

        try {
            await connection.invoke("SendMessage", CONV_ID, content, pendingImageUrl ?? null);
            input.value = '';
            input.style.height = '';
            clearImage();
        } catch (e) {
            alert('Không thể gửi tin nhắn. Vui lòng thử lại.');
        } finally {
            document.getElementById('send-btn').disabled = false;
            input.focus();
        }
    }

    function handleKeyDown(e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    }

    function autoResize(el) {
        el.style.height = '';
        el.style.height = Math.min(el.scrollHeight, 120) + 'px';
    }

    // ── Image URL ─────────────────────────────────────────────────
    function confirmImage() {
        const url = document.getElementById('img-url-input').value.trim();
        if (!url) return;
        pendingImageUrl = url;
        document.getElementById('img-url-preview').textContent = url;
        document.getElementById('image-preview-wrap').classList.add('show');
        document.getElementById('img-modal').classList.remove('show');
        document.getElementById('img-url-input').value = '';
    }
    function clearImage() {
        pendingImageUrl = null;
        document.getElementById('image-preview-wrap').classList.remove('show');
        document.getElementById('img-url-preview').textContent = '';
    }

    // Đóng modal khi click ngoài
    document.getElementById('img-modal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('show');
    });

    // Biến Razor
    const currentId = '@currentId';

    // Khởi động
    loadInitialMessages();
</script>
