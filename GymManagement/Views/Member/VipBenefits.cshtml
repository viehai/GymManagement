@model GymManagement.ViewModels.GymVipBenefitsViewModel
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Chính sách VIP — " + Model.GymName;
}

<style>
    .benefits-hero {
        background: #111;
        padding: 3.5rem 0 3rem;
        color: #fff;
    }
    .benefits-hero-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #f59e0b;
        margin-bottom: 0.4rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .benefits-hero h1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        color: #fff;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .tier-roadmap-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .tier-roadmap-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.08);
    }
</style>

<!-- Hero Section -->
<section class="benefits-hero">
    <div class="container">
        <a asp-controller="Gym" asp-action="Details" asp-route-id="@Model.GymId" class="btn btn-sm btn-outline-light mb-3" style="border-radius:6px; font-weight:700;">
            <i class="bi bi-arrow-left me-1"></i> Quay lại phòng Gym
        </a>
        <div class="benefits-hero-label">
            <i class="bi bi-crown-fill"></i> LOYALTY REWARDS ROADMAP
        </div>
        <h1>LỘ TRÌNH ĐẶC QUYỀN VIP</h1>
        <p style="margin:8px 0 0; color:rgba(255,255,255,0.7); font-size:1rem; max-width:700px;">
            Hệ sinh thái quyền lợi dành riêng cho hội viên gắn bó tại <strong>@Model.GymName</strong>. Tích lũy số lần mua vé để nhận ưu đãi thanh toán trọn đời!
        </p>
    </div>
</section>

<!-- Content Body -->
<section style="padding: 3.5rem 0 5rem; background:#fafafa;">
    <div class="container">
        <!-- Gym Info Banner -->
        <div class="bg-white border rounded-3 p-3 p-md-4 mb-5 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(Model.GymImage))
                {
                    <img src="@Model.GymImage" alt="@Model.GymName" style="width:60px; height:60px; border-radius:10px; object-fit:cover;" />
                }
                else
                {
                    <div style="width:60px; height:60px; border-radius:10px; background:#111; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:900;">
                        GYM
                    </div>
                }
                <div>
                    <h4 style="font-family:'Montserrat',sans-serif; font-weight:800; font-size:1.15rem; color:#111; margin:0 0 3px;">
                        @Model.GymName
                    </h4>
                    <p style="margin:0; font-size:0.82rem; color:#666;">
                        <i class="bi bi-geo-alt me-1"></i>@Model.GymAddress
                    </p>
                </div>
            </div>

            <div>
                <a asp-controller="Gym" asp-action="Details" asp-route-id="@Model.GymId" class="btn btn-dark" style="font-weight:700; border-radius:6px; padding:9px 20px;">
                    <i class="bi bi-bag me-1"></i> Mua vé ngay
                </a>
            </div>
        </div>

        @if (!Model.Tiers.Any())
        {
            <div class="text-center py-5 bg-white border rounded-3 p-5 shadow-sm">
                <i class="bi bi-info-circle" style="font-size:2.5rem; color:#9ca3af; display:block; margin-bottom:1rem;"></i>
                <h5 style="font-family:'Montserrat',sans-serif; font-weight:800; color:#111;">Cơ sở này đang cập nhật chính sách VIP</h5>
                <p style="color:#666; font-size:0.9rem; margin:0;">
                    Vui lòng quay lại sau hoặc liên hệ trực tiếp với phòng Gym để biết thêm chi tiết.
                </p>
            </div>
        }
        else
        {
            <div class="text-center mb-4">
                <span style="font-family:'Montserrat',sans-serif; font-size:0.75rem; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#888;">
                    CÁC CẤP BẬC DANH DỰ
                </span>
                <h3 style="font-family:'Montserrat',sans-serif; font-weight:900; font-size:1.4rem; color:#111; margin-top:4px;">
                    Hạng càng cao — Đặc quyền càng lớn
                </h3>
            </div>

            <div class="row g-4 justify-content-center">
                @foreach (var tier in Model.Tiers)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="tier-roadmap-card" style="border-top: 5px solid @tier.BadgeColor;">
                            <!-- Header -->
                            <div class="p-4 pb-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge" style="background:@(tier.BadgeColor)20; color:@tier.BadgeColor; font-weight:800; font-size:0.8rem; border-radius:20px; padding:5px 12px;">
                                        Cấp độ #@tier.DisplayOrder
                                    </span>
                                    <span style="display:inline-block; width:16px; height:16px; border-radius:50%; background:@tier.BadgeColor; border:2px solid #fff; box-shadow:0 0 0 1px @tier.BadgeColor;"></span>
                                </div>

                                <h3 style="font-family:'Montserrat',sans-serif; font-weight:900; font-size:1.4rem; color:#111; margin:0 0 6px;">
                                    @tier.TierName
                                </h3>

                                <div class="d-flex align-items-baseline gap-1 mt-3">
                                    <span style="font-family:'Montserrat',sans-serif; font-size:2rem; font-weight:900; color:#e11d48;">
                                        @(tier.DiscountPercent.HasValue ? $"{tier.DiscountPercent:0.#}%" : "0%")
                                    </span>
                                    <span style="font-size:0.85rem; font-weight:700; color:#666; text-transform:uppercase;">
                                        Giảm thanh toán
                                    </span>
                                </div>
                            </div>

                            <!-- Requirement Box -->
                            <div class="px-4 py-2" style="background:#f9fafb; border-top:1px solid #f3f4f6; border-bottom:1px solid #f3f4f6;">
                                <div style="font-size:0.82rem; color:#374151; font-weight:600;">
                                    <i class="bi bi-shield-check text-primary me-1"></i> Điều kiện:
                                    <strong style="color:#111;">Tích lũy từ @tier.MinPurchaseCount lần mua</strong>
                                </div>
                            </div>

                            <!-- Benefits List -->
                            <div class="p-4 flex-grow-1">
                                <div style="font-size:0.75rem; font-weight:800; text-transform:uppercase; color:#888; letter-spacing:0.5px; margin-bottom:8px;">
                                    Đặc quyền thành viên:
                                </div>
                                <p style="font-size:0.88rem; color:#374151; line-height:1.6; margin:0;">
                                    @(string.IsNullOrWhiteSpace(tier.BenefitDescription) ? "Được áp dụng mức chiết khấu giảm giá trực tiếp cho toàn bộ vé ngày và gói tập." : tier.BenefitDescription)
                                </p>
                            </div>

                            <!-- Card Footer -->
                            <div class="p-3 border-top bg-light text-center">
                                <a asp-controller="Gym" asp-action="Details" asp-route-id="@Model.GymId"
                                   class="btn btn-sm btn-outline-dark w-100" style="font-weight:700; border-radius:6px; font-size:0.82rem; padding:7px 0;">
                                    Tích lũy ngay tại cơ sở này
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
