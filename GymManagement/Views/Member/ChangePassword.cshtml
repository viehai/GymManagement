<!-- Đường dẫn file: Views/Member/ChangePassword.cshtml -->
@model GymManagement.ViewModels.ChangePasswordViewModel

@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    /* ═══════════════════════════════════════════════
       CHANGE PASSWORD — INK WASH PALETTE
    ═══════════════════════════════════════════════ */
    .cp-hero {
        background: #252525;
        padding: 2.8rem 0 2.2rem;
        color: #fff;
    }
    .cp-hero-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
        margin-bottom: 0.4rem;
    }
    .cp-hero h1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(1.4rem, 3vw, 2rem);
        color: #fff;
        margin: 0;
    }
    .cp-breadcrumb {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-top: 0.75rem;
    }
    .cp-breadcrumb a { color: rgba(255,255,255,0.45); text-decoration: none; }
    .cp-breadcrumb a:hover { color: #fff; }

    .cp-body {
        padding: 3.5rem 0 5rem;
        background: #fafafa;
    }

    .cp-card {
        background: #fff;
        border: 1px solid #CFCFCF;
        border-radius: 0;
        padding: 2.5rem;
        max-width: 520px;
        margin: 0 auto;
    }
    .cp-card-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #252525;
        padding-bottom: 0.8rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #CFCFCF;
    }

    .form-group-ink {
        margin-bottom: 1.4rem;
    }
    .form-label-ink {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #252525;
        margin-bottom: 0.5rem;
        display: block;
    }
    .form-control-ink {
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
        border: 1px solid #CFCFCF;
        border-radius: 0;
        background: #fff;
        color: #252525;
        transition: border-color 0.2s;
    }
    .form-control-ink:focus {
        border-color: #252525;
        outline: none;
    }

    .btn-cp-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        background: #252525;
        color: #fff !important;
        border: 1px solid #252525;
        border-radius: 0;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 0.9rem;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 1rem;
    }
    .btn-cp-submit:hover {
        background: #545454;
    }

    .btn-cp-cancel {
        display: block;
        text-align: center;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #7D7D7D;
        text-decoration: none;
        margin-top: 1rem;
        transition: color 0.2s;
    }
    .btn-cp-cancel:hover {
        color: #252525;
    }

    .validation-summary-errors {
        background: #fff;
        border-left: 3px solid #252525;
        border: 1px solid #CFCFCF;
        padding: 0.9rem 1.2rem;
        margin-bottom: 1.5rem;
        font-size: 0.82rem;
        color: #252525;
    }
    .validation-summary-errors ul {
        margin: 0;
        padding-left: 1.2rem;
    }
</style>

<!-- Hero -->
<div class="cp-hero">
    <div class="container">
        <p class="cp-hero-label">Tài khoản & Bảo mật</p>
        <h1>Đổi mật khẩu</h1>
        <nav class="cp-breadcrumb" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang Chủ</a> /
            <a asp-controller="Member" asp-action="Profile">Trang cá nhân</a> /
            <span style="color:rgba(255,255,255,0.75);">Đổi mật khẩu</span>
        </nav>
    </div>
</div>

<div class="cp-body">
    <div class="container">
        <div class="cp-card">
            <h2 class="cp-card-title"><i class="bi bi-shield-lock me-2"></i>Thiết lập mật khẩu mới</h2>

            <form asp-controller="Member" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-group-ink">
                    <label asp-for="CurrentPassword" class="form-label-ink"></label>
                    <input asp-for="CurrentPassword" class="form-control-ink" placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <div class="form-group-ink">
                    <label asp-for="NewPassword" class="form-label-ink"></label>
                    <input asp-for="NewPassword" class="form-control-ink" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <div class="form-group-ink">
                    <label asp-for="ConfirmPassword" class="form-label-ink"></label>
                    <input asp-for="ConfirmPassword" class="form-control-ink" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <button id="btn-submit-change-password" type="submit" class="btn-cp-submit">
                    <i class="bi bi-check2-circle me-1"></i> Cập nhật mật khẩu
                </button>

                <a asp-controller="Member" asp-action="Profile" class="btn-cp-cancel">
                    <i class="bi bi-arrow-left me-1"></i> Hủy & Quay lại hồ sơ
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
