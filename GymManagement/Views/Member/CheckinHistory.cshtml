@model GymManagement.ViewModels.MemberPersonalCheckinHistoryViewModel

@{
    ViewData["Title"] = "Lịch Sử Tập Luyện Của Tôi";
    Layout = "_MemberLayout";
}

<div class="container-fluid py-2">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1 style="font-family:'Montserrat',sans-serif; font-size:1.35rem; font-weight:900; color:#111; margin:0 0 4px; letter-spacing:-0.5px;">
                LỊCH SỬ ĐIỂM DANH & TẬP LUYỆN
            </h1>
            <p style="margin:0; font-size:0.85rem; color:#6b7280;">
                Theo dõi quá trình tập luyện và các lần check-in vào phòng gym của bạn.
            </p>
        </div>
        <a asp-action="MyQrCode" class="btn btn-dark btn-sm fw-bold px-3" style="border-radius:6px;">
            <i class="bi bi-qr-code me-1"></i> Mở mã QR của tôi
        </a>
    </div>

    <!-- 2 Thẻ thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-4">
            <div class="content-card p-3 d-flex align-items-center gap-3">
                <div style="width:46px; height:46px; border-radius:10px; background:#e0f2fe; color:#0284c7; display:flex; align-items:center; justify-content:center; font-size:1.3rem;">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>
                <div>
                    <div style="font-size:0.75rem; font-weight:700; color:#6b7280; text-transform:uppercase;">Tháng này (@DateTime.Now.Month/@DateTime.Now.Year)</div>
                    <div style="font-family:'Montserrat',sans-serif; font-weight:900; font-size:1.4rem; color:#111;">
                        @Model.ThisMonthVisits <span style="font-size:0.8rem; font-weight:600; color:#6b7280;">buổi tập</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4">
            <div class="content-card p-3 d-flex align-items-center gap-3">
                <div style="width:46px; height:46px; border-radius:10px; background:#dcfce7; color:#16a34a; display:flex; align-items:center; justify-content:center; font-size:1.3rem;">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                <div>
                    <div style="font-size:0.75rem; font-weight:700; color:#6b7280; text-transform:uppercase;">Tổng cộng tích lũy</div>
                    <div style="font-family:'Montserrat',sans-serif; font-weight:900; font-size:1.4rem; color:#16a34a;">
                        @Model.TotalVisits <span style="font-size:0.8rem; font-weight:600; color:#6b7280;">buổi tập</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách lần tập -->
    <div class="content-card p-0">
        <div class="content-card-header d-flex align-items-center justify-content-between p-3 border-bottom">
            <h5 class="content-card-title mb-0" style="font-size:0.95rem; font-weight:800;">
                <i class="bi bi-clock-history me-2 text-primary"></i>Nhật ký các buổi tập
            </h5>
            <span class="badge bg-light text-dark border">@Model.Visits.Count lần check-in</span>
        </div>

        @if (!Model.Visits.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                <h6 class="fw-bold text-dark">Chưa có lịch sử tập luyện</h6>
                <p class="small text-muted mb-0">Khi bạn đến phòng gym và check-in bằng mã QR hoặc SĐT, lịch sử sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:0.84rem;">
                    <thead>
                        <tr style="background:#f8fafc; color:#64748b; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.5px;">
                            <th style="width:40px;" class="text-center">#</th>
                            <th>Cơ sở Gym</th>
                            <th>Gói tập sử dụng</th>
                            <th>Thời gian vào</th>
                            <th>Thời gian ra</th>
                            <th>Hình thức</th>
                            <th class="text-end">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (v, idx) in Model.Visits.Select((item, i) => (item, i + 1)))
                        {
                            <tr>
                                <td class="text-center text-muted fw-bold">@idx</td>
                                <td>
                                    <div class="fw-bold text-dark">@v.GymName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@v.PackageName</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@v.CheckinTime.ToString("HH:mm")</div>
                                    <div class="text-muted" style="font-size:0.72rem;">@v.CheckinTime.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    @if (v.CheckoutTime.HasValue)
                                    {
                                        <div class="text-dark">@v.CheckoutTime.Value.ToString("HH:mm")</div>
                                        <div class="text-muted" style="font-size:0.72rem;">Check-out sớm</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:0.78rem;">Tự động (2h)</span>
                                    }
                                </td>
                                <td>
                                    @if (v.CheckinMethod == "QrScan")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" style="font-size:0.7rem;">
                                            <i class="bi bi-qr-code me-1"></i> Quét QR
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border" style="font-size:0.7rem;">
                                            <i class="bi bi-telephone-fill me-1"></i> SĐT
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-success" style="font-size:0.72rem;">
                                        <i class="bi bi-check-circle me-1"></i> Thành công
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
