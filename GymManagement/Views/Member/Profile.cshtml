<!-- Đường dẫn file: Views/Member/Profile.cshtml -->
@using Microsoft.AspNetCore.Identity
@model GymManagement.Models.ApplicationUser

@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Trang cá nhân";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var gyms = ViewBag.Gyms as List<GymManagement.Models.Gym> ?? new List<GymManagement.Models.Gym>();
    int activeMembershipsCount = ViewBag.ActiveMembershipsCount is int amc ? amc : 0;
    int transactionCount = ViewBag.TransactionCount is int tc ? tc : 0;
    bool isOwner = roles.Contains("Owner");
    bool hasPendingGym = gyms.Any(g => g.Status == "Pending");
}

<style>
    /* ═══════════════════════════════════════════════
       PROFILE PAGE — INK WASH PALETTE
       #252525  Xám than   → nền hero / text chính / nút CTA
       #545454  Xám đậm    → hover / border active
       #7D7D7D  Xám trung  → văn bản phụ / nhãn
       #CFCFCF  Xám nhạt  → đường kẻ / viền card
       #FFFFFF  Trắng      → nền trang / nền card
    ═══════════════════════════════════════════════ */

    .profile-hero {
        background: #252525;
        color: #fff;
        padding: 3.5rem 0 3rem;
        border-bottom: 1px solid #CFCFCF;
    }
    .profile-avatar {
        width: 84px;
        height: 84px;
        background: #fff;
        color: #252525;
        border: 2px solid #fff;
        border-radius: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 2rem;
        margin: 0 auto 1rem;
    }
    .profile-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 1.6rem;
        color: #fff;
        letter-spacing: 0.5px;
        margin: 0;
    }
    .profile-email {
        color: rgba(255,255,255,0.6);
        font-size: 0.85rem;
        margin-top: 4px;
    }
    .role-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 0;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin: 0 4px;
        border: 1px solid rgba(255,255,255,0.3);
        background: transparent;
        color: #fff;
    }

    .profile-body {
        padding: 3rem 0 5rem;
        background: #fafafa;
    }

    /* Tiêu đề nhóm trải nghiệm */
    .experience-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 1.2rem;
    }
    .experience-tag {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        background: #252525;
        color: #fff;
        padding: 4px 10px;
    }
    .experience-line {
        flex: 1;
        height: 1px;
        background: #CFCFCF;
    }

    /* Flat Card System */
    .ink-card {
        background: #fff;
        border: 1px solid #CFCFCF;
        border-radius: 0;
        box-shadow: none;
        padding: 1.8rem;
        transition: border-color 0.2s;
    }
    .ink-card:hover {
        border-color: #7D7D7D;
    }
    .ink-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.8rem;
        margin-bottom: 1.2rem;
        border-bottom: 1px solid #CFCFCF;
    }
    .ink-card-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #252525;
        margin: 0;
    }
    .ink-card-sub {
        font-size: 0.75rem;
        color: #7D7D7D;
    }

    /* Thông tin bảng dữ liệu */
    .info-row-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.65rem 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 0.86rem;
    }
    .info-row-item:last-child {
        border-bottom: none;
    }
    .info-row-label {
        color: #7D7D7D;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
    }
    .info-row-val {
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        color: #252525;
        text-align: right;
    }

    /* Thống kê hộp nhỏ */
    .stat-metric-box {
        border: 1px solid #CFCFCF;
        padding: 1rem;
        text-align: center;
        background: #fff;
    }
    .stat-metric-num {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.6rem;
        font-weight: 900;
        color: #252525;
        line-height: 1;
        margin-bottom: 0.3rem;
    }
    .stat-metric-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #7D7D7D;
    }

    /* Buttons */
    .btn-ink-solid {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #252525;
        color: #fff !important;
        border: 1px solid #252525;
        border-radius: 0;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 0.75rem 1.4rem;
        text-decoration: none;
        transition: background 0.2s;
        width: 100%;
    }
    .btn-ink-solid:hover {
        background: #545454;
        border-color: #545454;
    }

    .btn-ink-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: transparent;
        color: #252525 !important;
        border: 1px solid #CFCFCF;
        border-radius: 0;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 0.75rem 1.4rem;
        text-decoration: none;
        transition: border-color 0.2s, background 0.2s;
        width: 100%;
    }
    .btn-ink-outline:hover {
        border-color: #252525;
        background: #f5f5f5;
    }

    /* Business Promo Box */
    .business-promo {
        background: #252525;
        color: #fff;
        padding: 1.5rem;
        border: 1px solid #252525;
    }
    .business-promo-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.05rem;
        font-weight: 900;
        margin-bottom: 0.5rem;
        color: #fff;
    }
    .business-promo-desc {
        color: rgba(255,255,255,0.7);
        font-size: 0.82rem;
        line-height: 1.5;
        margin-bottom: 1.2rem;
    }
    .btn-promo-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #fff;
        color: #252525 !important;
        border: none;
        border-radius: 0;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 0.75rem 1.2rem;
        text-decoration: none;
        transition: background 0.2s;
        width: 100%;
    }
    .btn-promo-cta:hover {
        background: #CFCFCF;
    }

    /* Gym List Items */
    .gym-mini-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0.75rem 0;
        border-bottom: 1px solid #f0f0f0;
    }
    .gym-mini-item:last-child {
        border-bottom: none;
    }
    .gym-mini-img {
        width: 48px;
        height: 48px;
        border-radius: 0;
        object-fit: cover;
        flex-shrink: 0;
        border: 1px solid #CFCFCF;
        background: #f0f0f0;
    }
    .gym-mini-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.85rem;
        color: #252525;
        margin: 0;
    }
    .gym-mini-addr {
        font-size: 0.75rem;
        color: #7D7D7D;
        margin: 0;
    }

    /* Status Badges */
    .status-badge-ink {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 0;
        white-space: nowrap;
    }
    .status-approved {
        background: #252525;
        color: #fff;
        border: 1px solid #252525;
    }
    .status-pending {
        background: #fff;
        color: #7D7D7D;
        border: 1px solid #CFCFCF;
    }
    .status-rejected {
        background: #fff;
        color: #252525;
        border: 1px dashed #7D7D7D;
    }

    /* Empty state */
    .empty-box {
        text-align: center;
        padding: 2.5rem 1rem;
        border: 1px dashed #CFCFCF;
        color: #7D7D7D;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
    }
    .empty-box i {
        font-size: 2rem;
        color: #CFCFCF;
        margin-bottom: 0.6rem;
    }
</style>

<!-- Hero Section -->
<div class="profile-hero">
    <div class="container text-center">
        <div class="profile-avatar">
            @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
        </div>
        <h1 class="profile-name">@Model.FullName</h1>
        <p class="profile-email"><i class="bi bi-envelope me-1"></i>@Model.Email</p>
        <div class="mt-2">
            @foreach (var role in roles)
            {
                <span class="role-badge-pill">
                    <i class="bi bi-shield-check me-1"></i>@role
                </span>
            }
        </div>
    </div>
</div>

<!-- Profile Main Content -->
<div class="profile-body">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div style="background:#fff; border-left:4px solid #252525; border:1px solid #CFCFCF; padding:1rem 1.2rem; margin-bottom:2rem; display:flex; align-items:center; gap:10px; font-size:0.88rem;">
                <i class="bi bi-check-circle-fill text-dark fs-5"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        <!-- ═══════════════════════════════════════════════════════
             HÀNG 1: TRẢI NGHIỆM HỘI VIÊN (CÁ NHÂN + MUA SẮM)
             ═══════════════════════════════════════════════════════ -->
        <div class="experience-header">
            <span class="experience-tag">Trải nghiệm Hội viên</span>
            <div class="experience-line"></div>
        </div>

        <div class="row g-4 mb-5 align-items-stretch">
            <!-- Cột 1: Thông tin tài khoản -->
            <div class="col-12 col-md-6 d-flex">
                <div class="ink-card w-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="ink-card-header">
                            <h2 class="ink-card-title"><i class="bi bi-person-badge me-2"></i>Hồ sơ cá nhân</h2>
                            <span class="ink-card-sub">Thông tin cơ bản</span>
                        </div>
                        <div class="info-row-item">
                            <span class="info-row-label"><i class="bi bi-person"></i> Họ và tên</span>
                            <span class="info-row-val">@Model.FullName</span>
                        </div>
                        <div class="info-row-item">
                            <span class="info-row-label"><i class="bi bi-envelope"></i> Email</span>
                            <span class="info-row-val">@Model.Email</span>
                        </div>
                        <div class="info-row-item">
                            <span class="info-row-label"><i class="bi bi-telephone"></i> Điện thoại</span>
                            <span class="info-row-val">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</span>
                        </div>
                        <div class="info-row-item">
                            <span class="info-row-label"><i class="bi bi-patch-check"></i> Xác thực Email</span>
                            <span class="info-row-val">
                                @if (Model.EmailConfirmed)
                                {
                                    <span style="color:#252525;"><i class="bi bi-check-circle-fill me-1"></i>Đã kích hoạt</span>
                                }
                                else
                                {
                                    <span style="color:#7D7D7D;"><i class="bi bi-clock me-1"></i>Chưa kích hoạt</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="mt-4 pt-2">
                        <a id="btn-change-password-profile" asp-controller="Member" asp-action="ChangePassword" class="btn-ink-outline">
                            <i class="bi bi-key me-1"></i> Đổi mật khẩu
                        </a>
                    </div>
                </div>
            </div>

            <!-- Cột 2: Hoạt động & Mua sắm -->
            <div class="col-12 col-md-6 d-flex">
                <div class="ink-card w-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="ink-card-header">
                            <h2 class="ink-card-title"><i class="bi bi-bag-check me-2"></i>Hoạt động & Mua sắm</h2>
                            <span class="ink-card-sub">Tổng quan dịch vụ</span>
                        </div>

                        <!-- 2 ô thống kê số liệu ngang nhau -->
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <a asp-controller="Member" asp-action="MyMemberships" style="text-decoration:none; display:block;">
                                    <div class="stat-metric-box" style="cursor:pointer; transition:border-color 0.2s;">
                                        <div class="stat-metric-num">@activeMembershipsCount</div>
                                        <div class="stat-metric-label">Vé đang hiệu lực <i class="bi bi-chevron-right ms-1"></i></div>
                                    </div>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-controller="Member" asp-action="TransactionHistory" style="text-decoration:none; display:block;">
                                    <div class="stat-metric-box" style="cursor:pointer; transition:border-color 0.2s;">
                                        <div class="stat-metric-num">@transactionCount</div>
                                        <div class="stat-metric-label">Lịch sử giao dịch <i class="bi bi-chevron-right ms-1"></i></div>
                                    </div>
                                </a>
                            </div>
                        </div>

                        <p style="font-size:0.8rem; color:#7D7D7D; margin-bottom:1rem; line-height:1.4;">
                            Quản lý các gói tập đã mua, theo dõi hạn sử dụng, gia hạn trực tuyến và xem lại hóa đơn điện tử.
                        </p>
                    </div>

                    <div class="d-flex flex-column gap-2 mt-auto">
                        <a id="btn-view-memberships-profile" asp-controller="Member" asp-action="MyMemberships" class="btn-ink-solid">
                            <i class="bi bi-card-checklist me-1"></i> Quản lý gói tập của tôi
                        </a>
                        <a id="btn-view-transactions-profile" asp-controller="Member" asp-action="TransactionHistory" class="btn-ink-outline">
                            <i class="bi bi-clock-history me-1"></i> Xem lịch sử giao dịch & Hóa đơn
                        </a>
                    </div>
                </div>
            </div>
        </div>


        <!-- ═══════════════════════════════════════════════════════
             HÀNG 2: TRẢI NGHIỆM KINH DOANH (MỞ PHÒNG + QUẢN LÝ)
             ═══════════════════════════════════════════════════════ -->
        <div class="experience-header">
            <span class="experience-tag">Trải nghiệm Kinh doanh</span>
            <div class="experience-line"></div>
        </div>

        <div class="row g-4 align-items-stretch">
            <!-- Cột 1: Cơ hội đối tác / Quản lý kinh doanh -->
            <div class="col-12 col-md-6 d-flex">
                <div class="ink-card w-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="ink-card-header">
                            <h2 class="ink-card-title"><i class="bi bi-briefcase me-2"></i>Đối tác GymPro</h2>
                            <span class="ink-card-sub">Hợp tác & Vận hành</span>
                        </div>

                        @if (!isOwner && !hasPendingGym)
                        {
                            <div class="business-promo">
                                <div class="business-promo-title"><i class="bi bi-award me-1"></i> Trở thành đối tác GymPro</div>
                                <p class="business-promo-desc">
                                    Đăng ký mở phòng Gym của bạn trên nền tảng để tiếp cận hàng nghìn hội viên tiềm năng và tối ưu doanh thu.
                                </p>
                                <a id="btn-register-gym-profile" asp-controller="Member" asp-action="RegisterGym" class="btn-promo-cta">
                                    <i class="bi bi-plus-circle me-1"></i> Đăng ký mở phòng Gym
                                </a>
                            </div>
                        }
                        else if (hasPendingGym)
                        {
                            <div style="border:1px solid #252525; padding:1.4rem; background:#fff;">
                                <p style="font-family:'Montserrat',sans-serif; font-size:0.75rem; font-weight:800; color:#252525; letter-spacing:1px; text-transform:uppercase; margin-bottom:0.4rem;">
                                    <i class="bi bi-hourglass-split me-1"></i> Đang chờ ban quản trị phê duyệt
                                </p>
                                <p style="font-size:0.82rem; color:#7D7D7D; margin:0; line-height:1.5;">
                                    Hồ sơ đăng ký phòng Gym của bạn đang được duyệt. Sau khi được duyệt, quyền <strong>Owner</strong> sẽ tự động được kích hoạt trên tài khoản của bạn.
                                </p>
                            </div>
                        }
                        else if (isOwner)
                        {
                            <div style="border:1px solid #252525; padding:1.4rem; background:#fff;">
                                <p style="font-family:'Montserrat',sans-serif; font-size:0.75rem; font-weight:800; color:#252525; letter-spacing:1px; text-transform:uppercase; margin-bottom:0.4rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i> Quyền Chủ phòng Gym (Owner)
                                </p>
                                <p style="font-size:0.82rem; color:#7D7D7D; margin-bottom:1rem; line-height:1.5;">
                                    Bạn có toàn quyền thêm cơ sở phòng tập, cấu hình thiết bị và thiết lập các gói tập cho khách hàng.
                                </p>
                            </div>
                        }
                    </div>

                    @if (isOwner)
                    {
                        <div class="mt-4 pt-2">
                            <a id="btn-owner-dashboard-profile" asp-controller="OwnerGym" asp-action="Index" class="btn-ink-solid">
                                <i class="bi bi-speedometer2 me-1"></i> Vào bảng điều khiển quản lý Gym
                            </a>
                        </div>
                    }
                    else if (!isOwner && !hasPendingGym)
                    {
                        <div class="mt-3">
                            <span style="font-size:0.72rem; color:#7D7D7D;">
                                <i class="bi bi-shield-check me-1"></i> Hỗ trợ nhanh chóng & duyệt hồ sơ trong 24h.
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Cột 2: Phòng Gym của tôi -->
            <div class="col-12 col-md-6 d-flex">
                <div class="ink-card w-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="ink-card-header">
                            <h2 class="ink-card-title"><i class="bi bi-building me-2"></i>Phòng Gym của tôi</h2>
                            <span class="ink-card-sub">(@gyms.Count cơ sở)</span>
                        </div>

                        @if (!gyms.Any())
                        {
                            <div class="empty-box">
                                <i class="bi bi-building"></i>
                                <p class="mb-0" style="font-size:0.85rem;">Bạn chưa sở hữu phòng Gym nào trên hệ thống.</p>
                            </div>
                        }
                        else
                        {
                            <div class="gym-mini-list">
                                @foreach (var gym in gyms)
                                {
                                    <div class="gym-mini-item">
                                        <img src="@(string.IsNullOrEmpty(gym.ImageUrl) ? "https://static.wixstatic.com/media/7e9c4c_5d4a9443f1fd4b7a8f8d0ca05ef2b8a8~mv2.jpg/v1/fill/w_120,h_120,al_c,q_85,enc_avif,quality_auto/7e9c4c_5d4a9443f1fd4b7a8f8d0ca05ef2b8a8~mv2.jpg" : gym.ImageUrl)"
                                             class="gym-mini-img"
                                             alt="@gym.Name" />
                                        <div class="flex-grow-1">
                                            <p class="gym-mini-name">@gym.Name</p>
                                            <p class="gym-mini-addr"><i class="bi bi-geo-alt me-1"></i>@gym.Address</p>
                                        </div>
                                        @{
                                            string statusClass = gym.Status switch {
                                                "Approved" => "status-approved",
                                                "Rejected" => "status-rejected",
                                                _ => "status-pending"
                                            };
                                            string statusText = gym.Status switch {
                                                "Approved" => "Đã duyệt",
                                                "Rejected" => "Từ chối",
                                                "Pending" => "Chờ duyệt",
                                                _ => gym.Status
                                            };
                                        }
                                        <span class="status-badge-ink @statusClass">@statusText</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (isOwner)
                    {
                        <div class="mt-4 pt-2">
                            <a id="btn-create-new-gym-profile" asp-controller="OwnerGym" asp-action="Create" class="btn-ink-outline">
                                <i class="bi bi-plus-lg me-1"></i> Thêm phòng Gym mới
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
