@using Microsoft.AspNetCore.Identity
@model GymManagement.Models.ApplicationUser

@{
    ViewData["Title"] = "Trang cá nhân";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var gyms = ViewBag.Gyms as List<GymManagement.Models.Gym> ?? new List<GymManagement.Models.Gym>();
    bool isOwner = roles.Contains("Owner");
    bool hasPendingGym = gyms.Any(g => g.Status == "Pending");
}

<style>
    .profile-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f172a 100%);
        padding: 4rem 0 3rem;
        position: relative;
        overflow: hidden;
    }
    .profile-hero::before {
        content: '';
        position: absolute;
        top: -50%; left: -20%;
        width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(99,102,241,0.12) 0%, transparent 70%);
        pointer-events: none;
    }
    .profile-avatar {
        width: 96px; height: 96px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Montserrat', sans-serif;
        font-weight: 900; font-size: 2.2rem; color: #fff;
        margin: 0 auto 1.2rem;
        box-shadow: 0 0 0 4px rgba(99,102,241,0.3);
    }
    .profile-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800; font-size: 1.6rem; color: #fff; margin: 0;
    }
    .profile-email {
        color: rgba(255,255,255,0.55); font-size: 0.88rem; margin-top: 4px;
    }
    .role-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 20px;
        font-size: 0.7rem; font-weight: 700; letter-spacing: 1px;
        text-transform: uppercase; margin: 0 3px;
    }
    .role-member { background: rgba(99,102,241,0.2); color: #a5b4fc; }
    .role-owner { background: rgba(16,185,129,0.2); color: #6ee7b7; }
    .role-admin { background: rgba(239,68,68,0.2); color: #fca5a5; }

    .profile-section { padding: 3rem 0; }
    .info-card {
        background: #fff; border-radius: 14px;
        border: 1px solid #e8eaed; padding: 1.8rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }
    .info-card h5 {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.75rem; font-weight: 700;
        letter-spacing: 1.5px; text-transform: uppercase;
        color: #888; margin-bottom: 1.2rem;
    }
    .info-row {
        display: flex; align-items: center;
        padding: 0.65rem 0; border-bottom: 1px solid #f5f5f5;
    }
    .info-row:last-child { border-bottom: none; }
    .info-icon { width: 32px; color: #6366f1; font-size: 1rem; flex-shrink: 0; }
    .info-label { width: 120px; font-size: 0.78rem; color: #999; font-weight: 500; flex-shrink: 0; }
    .info-value { font-size: 0.88rem; color: #111; font-weight: 500; flex: 1; }

    /* Gym registration CTA */
    .gym-cta-card {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        border-radius: 14px; padding: 2.2rem;
        border: 1px solid rgba(99,102,241,0.3);
        position: relative; overflow: hidden;
    }
    .gym-cta-card::before {
        content: '';
        position: absolute;
        right: -40px; top: -40px;
        width: 200px; height: 200px;
        background: radial-gradient(circle, rgba(99,102,241,0.15), transparent 70%);
        pointer-events: none;
    }
    .gym-cta-card .cta-label {
        font-size: 0.65rem; font-weight: 700; letter-spacing: 2px;
        text-transform: uppercase; color: #a5b4fc; margin-bottom: 0.5rem;
    }
    .gym-cta-card h3 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800; font-size: 1.25rem; color: #fff; margin-bottom: 0.6rem;
    }
    .gym-cta-card p { color: rgba(255,255,255,0.55); font-size: 0.85rem; margin-bottom: 1.4rem; }
    .btn-cta-register {
        display: inline-flex; align-items: center; gap: 8px;
        background: #6366f1; color: #fff;
        padding: 0.65rem 1.5rem; border-radius: 8px;
        font-family: 'Montserrat', sans-serif; font-weight: 700;
        font-size: 0.82rem; letter-spacing: 0.5px;
        text-decoration: none; transition: background 0.18s, transform 0.18s;
    }
    .btn-cta-register:hover { background: #4f46e5; color: #fff; transform: translateX(2px); }

    /* Gym list */
    .gym-item {
        display: flex; align-items: center; gap: 14px;
        padding: 1rem 0; border-bottom: 1px solid #f5f5f5;
    }
    .gym-item:last-child { border-bottom: none; }
    .gym-item-img {
        width: 56px; height: 56px; border-radius: 10px;
        object-fit: cover; flex-shrink: 0; background: #f0f0f0;
    }
    .gym-item-img-ph {
        width: 56px; height: 56px; border-radius: 10px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; color: rgba(255,255,255,0.6); flex-shrink: 0;
    }
    .gym-item-name { font-weight: 700; font-size: 0.88rem; color: #111; }
    .gym-item-address { font-size: 0.75rem; color: #999; }
    .badge-gym-status {
        padding: 3px 9px; border-radius: 20px;
        font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px;
        text-transform: uppercase; white-space: nowrap;
    }
    .bg-pending { background: #fef3c7; color: #92400e; }
    .bg-approved { background: #d1fae5; color: #065f46; }
    .bg-rejected { background: #fee2e2; color: #991b1b; }
</style>

<!-- Hero -->
<div class="profile-hero">
    <div class="container text-center">
        <div class="profile-avatar">@Model.FullName.Substring(0,1).ToUpper()</div>
        <h1 class="profile-name">@Model.FullName</h1>
        <p class="profile-email"><i class="bi bi-envelope me-1"></i>@Model.Email</p>
        <div class="mt-3">
            @foreach (var role in roles)
            {
                string cls = role == "Owner" ? "role-owner" : role == "Admin" ? "role-admin" : "role-member";
                <span class="role-badge @cls">
                    <i class="bi bi-shield-check"></i> @role
                </span>
            }
        </div>
    </div>
</div>

<!-- Content -->
<div class="profile-section">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div style="background:#d1fae5;border-left:4px solid #10b981;color:#065f46;border-radius:8px;padding:0.9rem 1.2rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:8px;">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            </div>
        }

        <div class="row g-4">
            <!-- Left: Thông tin cá nhân -->
            <div class="col-lg-5">
                <div class="info-card">
                    <h5>Thông tin tài khoản</h5>
                    <div class="info-row">
                        <span class="info-icon"><i class="bi bi-person"></i></span>
                        <span class="info-label">Họ tên</span>
                        <span class="info-value">@Model.FullName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-icon"><i class="bi bi-envelope"></i></span>
                        <span class="info-label">Email</span>
                        <span class="info-value">@Model.Email</span>
                    </div>
                    <div class="info-row">
                        <span class="info-icon"><i class="bi bi-telephone"></i></span>
                        <span class="info-label">Điện thoại</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</span>
                    </div>
                    <div class="info-row">
                        <span class="info-icon"><i class="bi bi-patch-check"></i></span>
                        <span class="info-label">Email xác nhận</span>
                        <span class="info-value">
                            @if (Model.EmailConfirmed)
                            {
                                <span style="color:#10b981;font-weight:600;"><i class="bi bi-check-circle-fill me-1"></i>Đã xác nhận</span>
                            }
                            else
                            {
                                <span style="color:#f59e0b;"><i class="bi bi-clock me-1"></i>Chưa xác nhận</span>
                            }
                        </span>
                    </div>
                </div>

                <!-- CTA: Đăng ký mở Gym (chỉ hiện với Member chưa có gym pending) -->
                @if (!isOwner && !hasPendingGym)
                {
                    <div class="gym-cta-card">
                        <p class="cta-label"><i class="bi bi-star-fill me-1"></i> Cơ hội kinh doanh</p>
                        <h3>Trở thành đối tác GymPro</h3>
                        <p>Đăng ký mở phòng Gym của bạn trên nền tảng và tiếp cận hàng nghìn thành viên tiềm năng.</p>
                        <a asp-controller="Member" asp-action="RegisterGym" class="btn-cta-register">
                            <i class="bi bi-building-add"></i> Đăng ký mở phòng Gym
                        </a>
                    </div>
                }
                else if (hasPendingGym)
                {
                    <div style="background:#fffbeb;border:1px solid #fcd34d;border-radius:12px;padding:1.4rem;">
                        <p style="font-size:0.8rem;font-weight:700;color:#92400e;letter-spacing:1px;text-transform:uppercase;margin-bottom:0.4rem;">
                            <i class="bi bi-hourglass-split me-1"></i> Đang chờ phê duyệt
                        </p>
                        <p style="font-size:0.85rem;color:#78350f;margin:0;">
                            Đơn đăng ký phòng Gym của bạn đang được xem xét. Chúng tôi sẽ thông báo qua email khi có kết quả.
                        </p>
                    </div>
                }
                else if (isOwner)
                {
                    <div style="background:#f0fdf4;border:1px solid #86efac;border-radius:12px;padding:1.4rem;">
                        <p style="font-size:0.8rem;font-weight:700;color:#166534;letter-spacing:1px;text-transform:uppercase;margin-bottom:0.4rem;">
                            <i class="bi bi-check-circle-fill me-1"></i> Bạn là Gym Owner
                        </p>
                        <a asp-controller="OwnerGym" asp-action="Index"
                           style="display:inline-flex;align-items:center;gap:6px;color:#166534;font-weight:700;font-size:0.85rem;text-decoration:none;">
                            Vào bảng điều khiển Owner <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                }
            </div>

            <!-- Right: Danh sách Gym -->
            <div class="col-lg-7">
                <div class="info-card">
                    <h5>Phòng Gym của tôi (@gyms.Count)</h5>
                    @if (!gyms.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-building" style="font-size:2.5rem;color:#e0e0e0;"></i>
                            <p style="color:#bbb;font-size:0.85rem;margin-top:0.8rem;">Bạn chưa có phòng Gym nào.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var gym in gyms)
                        {
                            <div class="gym-item">
                                @if (!string.IsNullOrEmpty(gym.ImageUrl))
                                {
                                    <img src="@gym.ImageUrl" class="gym-item-img" alt="@gym.Name" />
                                }
                                else
                                {
                                    <div class="gym-item-img-ph"><i class="bi bi-building"></i></div>
                                }
                                <div class="flex-grow-1">
                                    <div class="gym-item-name">@gym.Name</div>
                                    <div class="gym-item-address"><i class="bi bi-geo-alt me-1"></i>@gym.Address</div>
                                </div>
                                @{
                                    string statusClass = gym.Status switch {
                                        "Approved" => "bg-approved",
                                        "Rejected" => "bg-rejected",
                                        _ => "bg-pending"
                                    };
                                    string statusText = gym.Status switch {
                                        "Approved" => "Đã duyệt",
                                        "Rejected" => "Từ chối",
                                        "Pending" => "Chờ duyệt",
                                        _ => gym.Status
                                    };
                                }
                                <span class="badge-gym-status @statusClass">@statusText</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
