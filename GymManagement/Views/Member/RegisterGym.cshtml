@model GymManagement.ViewModels.RegisterGymViewModel
@{
    ViewData["Title"] = "Đăng ký mở phòng Gym";
}

<style>
    .register-gym-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        padding: 3.5rem 0 2rem;
    }
    .register-gym-hero h1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900; font-size: 2rem; color: #fff;
        letter-spacing: -0.5px;
    }
    .register-gym-hero p { color: rgba(255,255,255,0.55); font-size: 0.9rem; }

    .form-section { padding: 3rem 0 5rem; }

    .form-card {
        background: #fff; border-radius: 16px;
        border: 1px solid #e8eaed;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        overflow: hidden;
    }
    .form-card-header {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        padding: 1.5rem 2rem;
    }
    .form-card-header h4 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800; font-size: 1rem;
        letter-spacing: 0.5px; color: #fff; margin: 0;
    }
    .form-card-header p { color: rgba(255,255,255,0.7); font-size: 0.8rem; margin: 4px 0 0; }
    .form-card-body { padding: 2rem; }

    .form-group-custom { margin-bottom: 1.4rem; }
    .form-group-custom label {
        display: block; font-size: 0.8rem; font-weight: 700;
        color: #374151; margin-bottom: 0.5rem; letter-spacing: 0.3px;
    }
    .form-group-custom label span.required { color: #ef4444; margin-left: 2px; }
    .form-group-custom .form-control {
        border: 1.5px solid #d1d5db; border-radius: 10px;
        padding: 0.75rem 1rem; font-size: 0.88rem; color: #111;
        transition: border-color 0.2s, box-shadow 0.2s; width: 100%;
        background: #fafafa;
    }
    .form-group-custom .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,0.12);
        outline: none; background: #fff;
    }
    .form-group-custom textarea.form-control { resize: vertical; min-height: 110px; }
    .form-group-custom .text-danger { font-size: 0.78rem; margin-top: 4px; }

    /* Upload zone */
    .upload-zone {
        border: 2px dashed #d1d5db; border-radius: 12px;
        padding: 2.5rem 1rem; text-align: center;
        cursor: pointer; transition: border-color 0.2s, background 0.2s;
        position: relative; background: #fafafa;
    }
    .upload-zone:hover { border-color: #6366f1; background: #f5f3ff; }
    .upload-zone.has-file { border-color: #10b981; background: #f0fdf4; }
    .upload-zone input[type="file"] {
        position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
    }
    .upload-zone .upload-icon { font-size: 2.5rem; color: #cbd5e1; margin-bottom: 0.6rem; }
    .upload-zone .upload-text { font-size: 0.82rem; color: #64748b; }
    .upload-zone .upload-hint { font-size: 0.72rem; color: #94a3b8; margin-top: 4px; }
    #imagePreview {
        max-width: 100%; max-height: 200px;
        border-radius: 8px; margin-top: 1rem;
        display: none; object-fit: cover;
    }

    /* Steps guide */
    .steps-card {
        background: #0f172a; border-radius: 14px;
        padding: 1.8rem;
    }
    .steps-card h5 {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.75rem; font-weight: 700;
        letter-spacing: 2px; text-transform: uppercase;
        color: rgba(255,255,255,0.45); margin-bottom: 1.2rem;
    }
    .step-item { display: flex; gap: 12px; margin-bottom: 1.1rem; }
    .step-item:last-child { margin-bottom: 0; }
    .step-num {
        width: 28px; height: 28px; border-radius: 50%;
        background: rgba(99,102,241,0.2); border: 1px solid rgba(99,102,241,0.4);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Montserrat', sans-serif; font-weight: 800;
        font-size: 0.75rem; color: #a5b4fc; flex-shrink: 0;
    }
    .step-text { font-size: 0.82rem; color: rgba(255,255,255,0.6); line-height: 1.5; padding-top: 4px; }
    .step-text strong { color: rgba(255,255,255,0.9); display: block; }

    .btn-submit-gym {
        display: inline-flex; align-items: center; gap: 8px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff; border: none; width: 100%;
        padding: 0.85rem 1.5rem; border-radius: 10px;
        font-family: 'Montserrat', sans-serif; font-weight: 800;
        font-size: 0.9rem; letter-spacing: 0.5px;
        cursor: pointer; justify-content: center;
        transition: opacity 0.2s, transform 0.2s;
    }
    .btn-submit-gym:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-cancel-gym {
        display: inline-flex; align-items: center; gap: 6px;
        color: #64748b; font-size: 0.82rem; font-weight: 600;
        text-decoration: none; justify-content: center; width: 100%;
        padding: 0.6rem; border-radius: 8px;
        transition: color 0.18s, background 0.18s; margin-top: 0.6rem;
    }
    .btn-cancel-gym:hover { color: #111; background: #f5f5f5; }
</style>

<!-- Hero -->
<div class="register-gym-hero">
    <div class="container">
        <a asp-controller="Member" asp-action="Profile"
           style="color:rgba(255,255,255,0.5);font-size:0.8rem;text-decoration:none;display:inline-flex;align-items:center;gap:5px;margin-bottom:1.2rem;">
            <i class="bi bi-arrow-left"></i> Quay lại trang cá nhân
        </a>
        <h1>Đăng ký mở phòng Gym</h1>
        <p>Điền thông tin bên dưới để gửi yêu cầu trở thành đối tác GymPro</p>
    </div>
</div>

<!-- Form -->
<div class="form-section">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-lg-7">
                <div class="form-card">
                    <div class="form-card-header">
                        <h4><i class="bi bi-building-add me-2"></i>Thông tin phòng Gym</h4>
                        <p>Vui lòng cung cấp thông tin chính xác để quá trình phê duyệt nhanh hơn</p>
                    </div>
                    <div class="form-card-body">
                        <form asp-action="RegisterGym" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <div class="form-group-custom">
                                <label asp-for="Name">Tên phòng Gym <span class="required">*</span></label>
                                <input asp-for="Name" class="form-control"
                                       placeholder="Ví dụ: Gym Star — Quận 1" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group-custom">
                                <label asp-for="Address">Địa chỉ <span class="required">*</span></label>
                                <input asp-for="Address" class="form-control"
                                       placeholder="Số nhà, đường, quận/huyện, tỉnh/thành phố" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="form-group-custom">
                                <label asp-for="Description">Mô tả</label>
                                <textarea asp-for="Description" class="form-control"
                                          placeholder="Giới thiệu về phòng Gym, thiết bị, dịch vụ nổi bật..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="form-group-custom">
                                <label>Hình ảnh đại diện</label>
                                <div class="upload-zone" id="uploadZone">
                                    <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp"
                                           id="imageInput" onchange="previewImage(event)" />
                                    <div id="uploadPlaceholder">
                                        <div class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                                        <div class="upload-text">Kéo thả hoặc click để chọn ảnh</div>
                                        <div class="upload-hint">JPG, PNG, WebP — Tối đa 5MB</div>
                                    </div>
                                    <img id="imagePreview" src="" alt="Preview" />
                                </div>
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn-submit-gym">
                                <i class="bi bi-send"></i> Gửi yêu cầu đăng ký
                            </button>
                            <a asp-controller="Member" asp-action="Profile" class="btn-cancel-gym">
                                <i class="bi bi-x"></i> Hủy
                            </a>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Steps guide -->
            <div class="col-lg-4">
                <div class="steps-card">
                    <h5>Quy trình phê duyệt</h5>
                    <div class="step-item">
                        <div class="step-num">1</div>
                        <div class="step-text">
                            <strong>Điền thông tin</strong>
                            Cung cấp đầy đủ tên, địa chỉ và mô tả phòng Gym.
                        </div>
                    </div>
                    <div class="step-item">
                        <div class="step-num">2</div>
                        <div class="step-text">
                            <strong>Gửi yêu cầu</strong>
                            Đơn của bạn sẽ được gửi đến đội ngũ quản trị GymPro.
                        </div>
                    </div>
                    <div class="step-item">
                        <div class="step-num">3</div>
                        <div class="step-text">
                            <strong>Chờ phê duyệt</strong>
                            Admin sẽ xem xét thông tin và phê duyệt trong 1–3 ngày làm việc.
                        </div>
                    </div>
                    <div class="step-item">
                        <div class="step-num">4</div>
                        <div class="step-text">
                            <strong>Nhận thông báo</strong>
                            Bạn sẽ nhận email xác nhận. Sau đó đăng nhập lại để truy cập bảng quản lý Owner.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('uploadPlaceholder');
            const zone = document.getElementById('uploadZone');

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    placeholder.style.display = 'none';
                    zone.classList.add('has-file');
                };
                reader.readAsDataURL(file);
            }
        }
    </script>
}
