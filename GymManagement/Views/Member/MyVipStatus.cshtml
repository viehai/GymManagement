@model GymManagement.ViewModels.MyVipOverviewViewModel
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Hạng VIP & Đặc quyền của tôi";
}

<style>
    .vip-hero {
        background: #111;
        padding: 3rem 0 2.5rem;
        color: #fff;
    }
    .vip-hero-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #f59e0b;
        margin-bottom: 0.4rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .vip-hero h1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(1.6rem, 3.5vw, 2.3rem);
        color: #fff;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .vip-body {
        padding: 3rem 0 5rem;
        background: #fafafa;
    }

    .vip-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .vip-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.06);
    }

    .vip-progress-bar-bg {
        background: #e5e7eb;
        border-radius: 100px;
        height: 10px;
        overflow: hidden;
        position: relative;
    }
    .vip-progress-bar-fill {
        height: 100%;
        border-radius: 100px;
        transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>

<!-- Hero Section -->
<section class="vip-hero">
    <div class="container">
        <div class="vip-hero-label">
            <i class="bi bi-crown-fill"></i> LOYALTY PROGRAM
        </div>
        <h1>TIẾN TRÌNH & ĐẶC QUYỀN VIP</h1>
        <p style="margin:8px 0 0; color:rgba(255,255,255,0.7); font-size:0.95rem; max-width:650px;">
            Mỗi lần thanh toán vé ngày hoặc gói tháng thành công sẽ được tích lũy tự động để nâng cấp hạng thành viên và hưởng chiết khấu trực tiếp.
        </p>
    </div>
</section>

<!-- Content Body -->
<section class="vip-body">
    <div class="container">
        @if (!Model.GymVipList.Any())
        {
            <div class="text-center py-5 bg-white border rounded-3 p-5 shadow-sm">
                <div style="width:72px; height:72px; border-radius:50%; background:#fef3c7; color:#f59e0b; display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem; font-size:2.2rem;">
                    <i class="bi bi-crown"></i>
                </div>
                <h4 style="font-family:'Montserrat',sans-serif; font-weight:800; color:#111;">Bạn chưa có tiến trình VIP nào</h4>
                <p style="color:#666; font-size:0.92rem; max-width:500px; margin:0 auto 1.8rem;">
                    Hãy chọn một phòng Gym và mua vé ngày hoặc gói tập đầu tiên để bắt đầu tích lũy nâng cấp hạng hội viên thân thiết!
                </p>
                <a asp-controller="Gym" asp-action="Index" class="btn btn-dark" style="font-weight:700; border-radius:6px; padding:10px 24px;">
                    <i class="bi bi-search me-1"></i> Khám phá phòng Gym
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model.GymVipList)
                {
                    <div class="col-12 col-lg-6">
                        <div class="vip-card" style="border-top: 4px solid @(item.HasVipTier ? item.CurrentTierColor : "#9ca3af");">
                            <!-- Gym Header -->
                            <div class="p-3 border-bottom d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.GymImage))
                                {
                                    <img src="@item.GymImage" alt="@item.GymName" style="width:52px; height:52px; border-radius:8px; object-fit:cover;" />
                                }
                                else
                                {
                                    <div style="width:52px; height:52px; border-radius:8px; background:#111; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:900;">
                                        GYM
                                    </div>
                                }
                                <div class="flex-grow-1 min-w-0">
                                    <h5 style="font-family:'Montserrat',sans-serif; font-weight:800; font-size:1.05rem; color:#111; margin:0 0 2px; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">
                                        @item.GymName
                                    </h5>
                                    <p style="margin:0; font-size:0.78rem; color:#888; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">
                                        <i class="bi bi-geo-alt me-1"></i>@item.GymAddress
                                    </p>
                                </div>
                            </div>

                            <!-- Body: Current Status -->
                            <div class="p-4 flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                                    <div>
                                        <div style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.5px;">Cấp bậc hiện tại</div>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            @if (item.HasVipTier)
                                            {
                                                <span class="badge d-inline-flex align-items-center gap-1"
                                                      style="background-color:@(item.CurrentTierColor)18; color:@item.CurrentTierColor; border:1.5px solid @item.CurrentTierColor; font-size:0.95rem; font-weight:800; padding:6px 14px; border-radius:20px;">
                                                    <i class="bi bi-crown-fill text-warning"></i> @item.CurrentTierName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background:#f3f4f6; color:#6b7280; font-size:0.85rem; font-weight:700; padding:6px 12px; border-radius:20px;">
                                                    Thành viên mới
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="text-end">
                                        <div style="font-size:0.75rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.5px;">Ưu đãi thanh toán</div>
                                        <div style="font-family:'Montserrat',sans-serif; font-size:1.3rem; font-weight:900; color:@(item.HasVipTier ? "#e11d48" : "#6b7280"); margin-top:2px;">
                                            @(item.CurrentDiscountPercent.HasValue ? $"GIẢM {item.CurrentDiscountPercent:0.#}%" : "0%")
                                        </div>
                                    </div>
                                </div>

                                <!-- Current Benefit Description -->
                                @if (item.HasVipTier && !string.IsNullOrEmpty(item.CurrentBenefitDescription))
                                {
                                    <div class="p-3 mb-4 rounded-3" style="background:#f9fafb; border:1px solid #f3f4f6;">
                                        <div style="font-size:0.75rem; font-weight:700; color:#374151; margin-bottom:4px;">
                                            <i class="bi bi-gift text-warning me-1"></i> Đặc quyền đang hưởng:
                                        </div>
                                        <p style="font-size:0.85rem; color:#4b5563; margin:0; line-height:1.5;">
                                            @item.CurrentBenefitDescription
                                        </p>
                                    </div>
                                }

                                <!-- Next Tier Progress -->
                                <div class="mt-3 pt-3 border-top">
                                    @if (item.HasNextTier)
                                    {
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div>
                                                <span style="font-size:0.82rem; font-weight:700; color:#111;">
                                                    Mục tiêu: Hạng <span style="color:@item.NextTierColor;">@item.NextTierName</span>
                                                </span>
                                                @if (item.NextTierDiscountPercent.HasValue)
                                                {
                                                    <span class="badge ms-1" style="background:#fef2f2; color:#ef4444; font-size:0.7rem; font-weight:700;">
                                                        -@($"{item.NextTierDiscountPercent:0.#}")%
                                                    </span>
                                                }
                                            </div>
                                            <span style="font-size:0.8rem; font-weight:700; color:#666;">
                                                @item.TotalPurchases / @item.NextTierMinPurchases lần
                                            </span>
                                        </div>

                                        <div class="vip-progress-bar-bg mb-2">
                                            <div class="vip-progress-bar-fill" style="width: @item.ProgressPercent%; background: @(item.NextTierColor ?? "#111");"></div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center" style="font-size:0.75rem; color:#888;">
                                            <span>Chỉ còn <strong>@item.PurchasesNeededForNextTier lần mua nữa</strong> để thăng hạng!</span>
                                            <span style="font-weight:700; color:#111;">@item.ProgressPercent%</span>
                                        </div>

                                        @if (!string.IsNullOrEmpty(item.NextTierBenefit))
                                        {
                                            <div style="font-size:0.78rem; color:#666; margin-top:8px; line-height:1.4;">
                                                <i class="bi bi-arrow-up-circle-fill text-success me-1"></i>
                                                Sắp mở khóa: @item.NextTierBenefit
                                            </div>
                                        }
                                    }
                                    else if (item.HasVipTier)
                                    {
                                        <div class="p-3 text-center rounded-3" style="background:#fefce8; border:1px solid #fef08a;">
                                            <i class="bi bi-stars text-warning" style="font-size:1.3rem;"></i>
                                            <div style="font-family:'Montserrat',sans-serif; font-weight:800; font-size:0.9rem; color:#854d0e; margin-top:2px;">
                                                CẤP BẬC CAO NHẤT!
                                            </div>
                                            <p style="font-size:0.78rem; color:#a16207; margin:2px 0 0;">
                                                Bạn đang tận hưởng tất cả đặc quyền tối đa tại cơ sở này với tổng cộng <strong>@item.TotalPurchases</strong> lần mua!
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Footer Actions -->
                            <div class="p-3 border-top bg-light d-flex align-items-center justify-content-between">
                                <a asp-controller="Member" asp-action="VipBenefits" asp-route-gymId="@item.GymId"
                                   class="text-decoration-none" style="font-size:0.8rem; font-weight:700; color:#374151;">
                                    <i class="bi bi-info-circle me-1"></i> Xem lộ trình VIP
                                </a>

                                <a asp-controller="Gym" asp-action="Details" asp-route-id="@item.GymId"
                                   class="btn btn-sm btn-dark" style="font-weight:700; border-radius:6px; font-size:0.8rem; padding:5px 14px;">
                                    <i class="bi bi-bag me-1"></i> Mua vé / Gia hạn
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
