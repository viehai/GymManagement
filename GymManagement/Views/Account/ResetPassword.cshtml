<!-- Đường dẫn file: Views/Account/ResetPassword.cshtml -->
@model GymManagement.ViewModels.ResetPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
}

<style>
    .auth-centered {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }
    .auth-box { width: 100%; max-width: 480px; }
    .step-indicator {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 3rem;
    }
    .step-dot {
        width: 28px;
        height: 28px;
        border: 1.5px solid #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        color: #aaa;
        flex-shrink: 0;
    }
    .step-dot.done { background: #333; border-color: #333; color: #fff; }
    .step-dot.active { background: #000; border-color: #000; color: #fff; }
    .step-line { flex: 1; height: 1.5px; background: #e0e0e0; }
    .step-line.done { background: #333; }
    .step-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #aaa;
        display: block;
        text-align: center;
        margin-top: 0.4rem;
    }
    .step-label.done { color: #333; }
    .step-label.active { color: #000; }
    .page-eyebrow {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #bbb;
        margin-bottom: 0.6rem;
    }
    .page-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.9rem;
        font-weight: 900;
        text-transform: uppercase;
        color: #000;
        line-height: 1.1;
        margin-bottom: 0.75rem;
    }
    .page-desc {
        font-size: 0.88rem;
        color: #777;
        line-height: 1.75;
        margin-bottom: 2.5rem;
        border-left: 2px solid #eee;
        padding-left: 1rem;
    }
    .form-label-min {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #555;
        margin-bottom: 0.45rem;
        display: block;
    }
    .form-control-min {
        display: block;
        width: 100%;
        border: 0;
        border-bottom: 1.5px solid #d0d0d0;
        border-radius: 0;
        padding: 0.6rem 0;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
        color: #111;
        background: transparent;
        outline: none;
        transition: border-color 0.2s;
        padding-right: 2rem;
    }
    .form-control-min:focus { border-bottom-color: #000; }
    .form-control-min::placeholder { color: #bbb; }
    .btn-submit-min {
        background: #000;
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: 0;
        border-radius: 0;
        padding: 0.85rem 2.5rem;
        transition: background 0.2s;
        width: 100%;
        margin-top: 0.75rem;
    }
    .btn-submit-min:hover { background: #333; }
    .validation-msg { font-size: 0.72rem; color: #c00; margin-top: 0.3rem; font-family: 'Inter', sans-serif; }
    .alert-min-error {
        background: #fff5f5;
        border: 0;
        border-left: 3px solid #c00;
        border-radius: 0;
        font-size: 0.82rem;
        font-family: 'Inter', sans-serif;
        color: #c00;
        padding: 0.85rem 1rem;
        margin-bottom: 1.75rem;
    }
    /* Requirement checklist */
    .req-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.4rem 1rem;
        margin-top: 0.75rem;
        padding: 0.75rem;
        background: #fafafa;
        border: 1px solid #f0f0f0;
    }
    .req-item {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #bbb;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: color 0.2s;
    }
    .req-item.valid { color: #111; }
    .req-item .req-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #d0d0d0;
        flex-shrink: 0;
        transition: background 0.2s;
    }
    .req-item.valid .req-dot { background: #000; }
</style>

<div class="auth-centered">
    <div class="auth-box">

        <!-- Step indicator -->
        <div class="mb-3">
            <div class="step-indicator">
                <div>
                    <div class="step-dot done">✓</div>
                    <span class="step-label done">Email</span>
                </div>
                <div class="step-line done"></div>
                <div>
                    <div class="step-dot done">✓</div>
                    <span class="step-label done">Xác minh</span>
                </div>
                <div class="step-line done"></div>
                <div>
                    <div class="step-dot active">3</div>
                    <span class="step-label active">Mật khẩu</span>
                </div>
            </div>
        </div>

        <p class="page-eyebrow">Bước 3 / 3</p>
        <h1 class="page-title">Mật Khẩu Mới</h1>
        <p class="page-desc">Tạo mật khẩu mạnh để bảo vệ tài khoản. Mật khẩu phải có ít nhất 6 ký tự.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-min-error" role="alert">
                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
            </div>
        }

        <form id="resetForm" method="post" asp-controller="Account" asp-action="ResetPassword" novalidate>
            @* Hidden fields — giữ lại Email & OtpCode từ bước VerifyOtp *@
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="OtpCode" />

            <div class="mb-4">
                <label asp-for="NewPassword" class="form-label-min"></label>
                <div style="position:relative;">
                    <input asp-for="NewPassword" class="form-control-min"
                           placeholder="••••••••" autocomplete="new-password" id="newPwd"
                           oninput="checkReqs(this.value)" />
                    <button type="button" onclick="togglePwd('newPwd','newPwdIcon')"
                            style="position:absolute;right:0;top:50%;transform:translateY(-50%);background:none;border:0;padding:0;color:#aaa;cursor:pointer;font-size:0.85rem;">
                        <i class="bi bi-eye" id="newPwdIcon"></i>
                    </button>
                </div>
                <div class="req-grid" id="reqGrid">
                    <div class="req-item" id="req-len"><span class="req-dot"></span>Tối thiểu 6 ký tự</div>
                    <div class="req-item" id="req-upper"><span class="req-dot"></span>Chữ hoa (A–Z)</div>
                    <div class="req-item" id="req-num"><span class="req-dot"></span>Chữ số (0–9)</div>
                    <div class="req-item" id="req-sym"><span class="req-dot"></span>Ký tự đặc biệt</div>
                </div>
                <span asp-validation-for="NewPassword" class="validation-msg"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label-min"></label>
                <div style="position:relative;">
                    <input asp-for="ConfirmPassword" class="form-control-min"
                           placeholder="••••••••" autocomplete="new-password" id="confirmPwd" />
                    <button type="button" onclick="togglePwd('confirmPwd','confirmIcon')"
                            style="position:absolute;right:0;top:50%;transform:translateY(-50%);background:none;border:0;padding:0;color:#aaa;cursor:pointer;font-size:0.85rem;">
                        <i class="bi bi-eye" id="confirmIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="validation-msg"></span>
            </div>

            <button type="submit" class="btn-submit-min" id="btnReset">
                Đặt Lại Mật Khẩu
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(inputId, iconId) {
            const i = document.getElementById(inputId);
            const ic = document.getElementById(iconId);
            i.type = i.type === 'password' ? 'text' : 'password';
            ic.className = i.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
        function setReq(id, valid) {
            document.getElementById(id).classList.toggle('valid', valid);
        }
        function checkReqs(val) {
            setReq('req-len', val.length >= 6);
            setReq('req-upper', /[A-Z]/.test(val));
            setReq('req-num', /[0-9]/.test(val));
            setReq('req-sym', /[^A-Za-z0-9]/.test(val));
        }
    </script>
}
