<!-- Đường dẫn file: Views/Account/ForgotPassword.cshtml -->
@model GymManagement.ViewModels.ForgotPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Quên Mật Khẩu";
}

<style>
    .auth-centered {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }
    .auth-box {
        width: 100%;
        max-width: 480px;
    }
    .step-indicator {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 3rem;
    }
    .step-dot {
        width: 28px;
        height: 28px;
        border: 1.5px solid #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        color: #aaa;
        flex-shrink: 0;
    }
    .step-dot.active {
        background: #000;
        border-color: #000;
        color: #fff;
    }
    .step-line {
        flex: 1;
        height: 1.5px;
        background: #e0e0e0;
    }
    .step-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #aaa;
        display: block;
        text-align: center;
        margin-top: 0.4rem;
    }
    .step-label.active { color: #000; }
    .page-eyebrow {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #bbb;
        margin-bottom: 0.6rem;
    }
    .page-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.9rem;
        font-weight: 900;
        text-transform: uppercase;
        color: #000;
        line-height: 1.1;
        margin-bottom: 0.75rem;
    }
    .page-desc {
        font-size: 0.88rem;
        color: #777;
        line-height: 1.75;
        margin-bottom: 2.5rem;
        border-left: 2px solid #eee;
        padding-left: 1rem;
    }
    .form-label-min {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #555;
        margin-bottom: 0.45rem;
        display: block;
    }
    .form-control-min {
        display: block;
        width: 100%;
        border: 0;
        border-bottom: 1.5px solid #d0d0d0;
        border-radius: 0;
        padding: 0.6rem 0;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
        color: #111;
        background: transparent;
        outline: none;
        transition: border-color 0.2s;
    }
    .form-control-min:focus { border-bottom-color: #000; }
    .form-control-min::placeholder { color: #bbb; }
    .btn-submit-min {
        background: #000;
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: 0;
        border-radius: 0;
        padding: 0.85rem 2.5rem;
        transition: background 0.2s;
        width: 100%;
        margin-top: 0.75rem;
    }
    .btn-submit-min:hover { background: #333; }
    .form-link-muted {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.63rem;
        font-weight: 500;
        color: #999;
        text-decoration: none;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: color 0.2s;
    }
    .form-link-muted:hover { color: #000; }
    .validation-msg { font-size: 0.72rem; color: #c00; margin-top: 0.3rem; font-family: 'Inter', sans-serif; }
    .alert-min-error {
        background: #fff5f5;
        border: 0;
        border-left: 3px solid #c00;
        border-radius: 0;
        font-size: 0.82rem;
        font-family: 'Inter', sans-serif;
        color: #c00;
        padding: 0.85rem 1rem;
        margin-bottom: 1.75rem;
    }
</style>

<div class="auth-centered">
    <div class="auth-box">

        <!-- Step indicator -->
        <div class="mb-3">
            <div class="step-indicator">
                <div>
                    <div class="step-dot active">1</div>
                    <span class="step-label active">Email</span>
                </div>
                <div class="step-line"></div>
                <div>
                    <div class="step-dot">2</div>
                    <span class="step-label">Xác minh</span>
                </div>
                <div class="step-line"></div>
                <div>
                    <div class="step-dot">3</div>
                    <span class="step-label">Mật khẩu</span>
                </div>
            </div>
        </div>

        <p class="page-eyebrow">Khôi phục tài khoản</p>
        <h1 class="page-title">Quên mật khẩu</h1>
        <p class="page-desc">
            Nhập địa chỉ email đã đăng ký. Chúng tôi sẽ gửi mã OTP <strong>6 chữ số</strong> để xác minh danh tính của bạn.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-min-error" role="alert">
                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
            </div>
        }

        <form id="forgotForm" method="post" asp-controller="Account" asp-action="ForgotPassword" novalidate>

            <div class="mb-4">
                <label class="form-label-min">Địa chỉ Email</label>
                <input name="Email" type="email" class="form-control-min"
                       placeholder="email@example.com" autocomplete="email"
                       id="forgotEmail" required />
                <div class="validation-msg" id="emailErr"></div>
            </div>

            <button type="submit" class="btn-submit-min" id="btnSendOtp">
                Gửi Mã OTP
            </button>
        </form>

        <div class="mt-4 pt-3" style="border-top:1px solid #f0f0f0;">
            <a asp-controller="Account" asp-action="Login" class="form-link-muted">
                <i class="bi bi-arrow-left" style="font-size:0.7rem;"></i>
                Quay lại đăng nhập
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
