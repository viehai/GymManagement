<!-- Đường dẫn file: Views/Account/VerifyOtp.cshtml -->
@model GymManagement.ViewModels.VerifyOtpViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Xác Minh OTP";
}

<style>
    /* ═══════════════════════════════════════════════
       VERIFY OTP — INK WASH PALETTE
    ═══════════════════════════════════════════════ */
    .auth-wrapper {
        min-height: calc(100vh - 180px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
        background: #fafafa;
    }
    .auth-card {
        width: 100%;
        max-width: 480px;
        background: #fff;
        border: 1px solid #CFCFCF;
        border-radius: 0;
        padding: 2.5rem 2.2rem;
        box-shadow: none;
    }

    /* Step indicator */
    .step-indicator {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 2.2rem;
    }
    .step-dot {
        width: 26px;
        height: 26px;
        border: 1px solid #CFCFCF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        color: #7D7D7D;
        flex-shrink: 0;
    }
    .step-dot.active { background: #252525; border-color: #252525; color: #fff; }
    .step-dot.done { background: #545454; border-color: #545454; color: #fff; }
    .step-line { flex: 1; height: 1px; background: #CFCFCF; }
    .step-line.done { background: #545454; }
    .step-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #7D7D7D;
        display: block;
        text-align: center;
        margin-top: 0.35rem;
    }
    .step-label.done { color: #545454; }
    .step-label.active { color: #252525; }

    .page-eyebrow {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #7D7D7D;
        margin-bottom: 0.4rem;
    }
    .page-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.6rem;
        font-weight: 900;
        text-transform: uppercase;
        color: #252525;
        line-height: 1.2;
        margin-bottom: 0.6rem;
    }
    .email-sent-to {
        font-size: 0.82rem;
        color: #545454;
        border-left: 3px solid #252525;
        padding-left: 0.8rem;
        margin-bottom: 1.8rem;
        line-height: 1.4;
    }
    .email-sent-to strong { color: #252525; }

    /* ── OTP BOXES — CĂN GỌN GÀNG, KÍCH THƯỚC CHUẨN ── */
    .otp-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin: 1.5rem auto;
        max-width: 360px;
    }
    .otp-input {
        width: 48px;
        height: 56px;
        max-width: 48px;
        flex: 0 0 48px;
        border: 1px solid #CFCFCF;
        border-radius: 0;
        background: #fff;
        font-family: 'Montserrat', sans-serif;
        font-size: 1.4rem;
        font-weight: 800;
        text-align: center;
        color: #252525;
        outline: none;
        transition: border-color 0.15s, background 0.15s;
        -moz-appearance: textfield;
        padding: 0;
    }
    .otp-input::-webkit-outer-spin-button,
    .otp-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .otp-input:focus {
        border-color: #252525;
        border-width: 2px;
        background: #fafafa;
    }
    .otp-input.has-val {
        border-color: #252525;
        background: #fff;
    }

    /* Timer */
    .timer-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 1rem 0 1.5rem;
        padding: 0 0.5rem;
    }
    .timer-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #7D7D7D;
    }
    .timer-count {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.85rem;
        font-weight: 800;
        color: #252525;
        letter-spacing: 1px;
    }
    .timer-count.expired { color: #dc2626; }

    .btn-submit-min {
        background: #252525;
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: 1px solid #252525;
        border-radius: 0;
        padding: 0.85rem 1.5rem;
        transition: background 0.2s;
        width: 100%;
        cursor: pointer;
    }
    .btn-submit-min:hover { background: #545454; }
    .btn-submit-min:disabled { background: #CFCFCF; border-color: #CFCFCF; color: #7D7D7D; cursor: not-allowed; }

    .form-link-muted {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        color: #7D7D7D;
        text-decoration: none;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: color 0.2s;
    }
    .form-link-muted:hover { color: #252525; }

    .resend-link {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #252525;
        text-decoration: none;
        border-bottom: 1px solid #252525;
        padding-bottom: 1px;
    }
    .validation-msg {
        font-size: 0.75rem;
        color: #dc2626;
        margin-top: 0.4rem;
        text-align: center;
        display: block;
    }
    .alert-min-error {
        background: #fff;
        border: 1px solid #CFCFCF;
        border-left: 3px solid #252525;
        border-radius: 0;
        font-size: 0.82rem;
        color: #252525;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
    }
</style>

<div class="auth-wrapper">
    <div class="auth-card">

        <!-- Step indicator -->
        <div class="step-indicator">
            <div>
                <div class="step-dot done"><i class="bi bi-check"></i></div>
                <span class="step-label done">Email</span>
            </div>
            <div class="step-line done"></div>
            <div>
                <div class="step-dot active">2</div>
                <span class="step-label active">Xác minh</span>
            </div>
            <div class="step-line"></div>
            <div>
                <div class="step-dot">3</div>
                <span class="step-label">Mật khẩu</span>
            </div>
        </div>

        <p class="page-eyebrow">Bước 2 / 3</p>
        <h1 class="page-title">Nhập Mã OTP</h1>
        <div class="email-sent-to">
            Mã xác minh <strong>6 chữ số</strong> đã được gửi tới<br>
            <strong>@Model.Email</strong>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-min-error" role="alert">
                <asp-validation-summary asp-validation-type="All" class="mb-0" />
            </div>
        }

        <form id="otpForm" method="post" asp-controller="Account" asp-action="VerifyOtp" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            @* Hidden — composed from digit boxes by JS *@
            <input type="hidden" asp-for="OtpCode" id="hiddenOtp" />

            <div class="otp-container" id="otpBoxes">
                <input type="tel" class="otp-input" id="d0" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" autofocus />
                <input type="tel" class="otp-input" id="d1" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                <input type="tel" class="otp-input" id="d2" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                <input type="tel" class="otp-input" id="d3" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                <input type="tel" class="otp-input" id="d4" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                <input type="tel" class="otp-input" id="d5" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
            </div>
            <div class="validation-msg" id="otpErr"></div>
            <span asp-validation-for="OtpCode" class="validation-msg"></span>

            <div class="timer-row">
                <span class="timer-label">Hết hạn sau</span>
                <span class="timer-count" id="countdown">05:00</span>
            </div>

            <button type="submit" class="btn-submit-min" id="btnVerify" onclick="return composeOtp()">
                <i class="bi bi-shield-check me-1"></i> Xác Nhận
            </button>
        </form>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top:1px solid #f0f0f0;">
            <a asp-controller="Account" asp-action="Login" class="form-link-muted">
                <i class="bi bi-arrow-left"></i> Đăng nhập
            </a>
            <a asp-controller="Account" asp-action="ForgotPassword" class="resend-link">
                Gửi lại mã
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const boxes = document.querySelectorAll('.otp-input');

        boxes.forEach((box, i) => {
            box.addEventListener('input', function () {
                this.value = this.value.toString().replace(/\D/g, '').slice(-1);
                this.classList.toggle('has-val', this.value !== '');
                if (this.value && i < boxes.length - 1) {
                    boxes[i + 1].focus();
                }
            });

            box.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace') {
                    if (!this.value && i > 0) {
                        boxes[i - 1].focus();
                        boxes[i - 1].value = '';
                        boxes[i - 1].classList.remove('has-val');
                    } else {
                        this.value = '';
                        this.classList.remove('has-val');
                    }
                }
            });

            box.addEventListener('paste', function (e) {
                e.preventDefault();
                const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
                [...pasted].forEach((ch, idx) => {
                    if (boxes[idx]) {
                        boxes[idx].value = ch;
                        boxes[idx].classList.add('has-val');
                    }
                });
                if (pasted.length > 0) {
                    boxes[Math.min(pasted.length, 5)].focus();
                }
            });
        });

        function composeOtp() {
            const code = [...boxes].map(b => b.value).join('');
            if (code.length < 6) {
                document.getElementById('otpErr').textContent = 'Vui lòng nhập đủ 6 chữ số.';
                return false;
            }
            document.getElementById('hiddenOtp').value = code;
            document.getElementById('otpErr').textContent = '';
            return true;
        }

        let secs = 300;
        const display = document.getElementById('countdown');
        const btn = document.getElementById('btnVerify');
        const timer = setInterval(() => {
            secs--;
            if (secs <= 0) {
                clearInterval(timer);
                display.textContent = '00:00';
                display.classList.add('expired');
                btn.disabled = true;
                btn.textContent = 'Mã đã hết hạn';
                return;
            }
            const m = String(Math.floor(secs / 60)).padStart(2, '0');
            const s = String(secs % 60).padStart(2, '0');
            display.textContent = `${m}:${s}`;
        }, 1000);
    </script>
}
