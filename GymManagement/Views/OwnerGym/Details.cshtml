@model GymManagement.Models.Gym
@{
    ViewData["Title"] = Model.Name;
    Layout = "_OwnerAdminLayout";
}

<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
    <a asp-action="Index" class="btn-owner-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-owner-secondary">
        <i class="bi bi-pencil"></i> Chỉnh sửa &amp; Ảnh
    </a>
    <a asp-controller="OwnerPackage" asp-action="Index" asp-route-gymId="@Model.Id" class="btn-owner-primary">
        <i class="bi bi-card-list"></i> Gói dịch vụ
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="content-card">
            @{
                var coverImage = Model.GymImages?.FirstOrDefault(i => i.IsCover)?.ImageUrl ?? Model.ImageUrl;
            }
            @if (!string.IsNullOrEmpty(coverImage))
            {
                <img src="@coverImage" alt="@Model.Name"
                     style="width:100%;max-height:320px;object-fit:cover;" />
            }
            else
            {
                <div style="width:100%;height:200px;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;">
                    <i class="bi bi-building" style="font-size:4rem;color:rgba(255,255,255,0.4);"></i>
                </div>
            }

            @if (Model.GymImages != null && Model.GymImages.Any())
            {
                <div style="padding:0.85rem 1.4rem;background:#f9fafb;border-bottom:1px solid #f0f0f0;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span style="font-size:0.72rem;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#6b7280;">
                            <i class="bi bi-images me-1" style="color:#6366f1;"></i> Thư viện ảnh (@Model.GymImages.Count ảnh)
                        </span>
                        <a asp-action="Edit" asp-route-id="@Model.Id" style="font-size:0.75rem;color:#6366f1;text-decoration:none;font-weight:600;">
                            <i class="bi bi-pencil-square me-1"></i>Quản lý ảnh
                        </a>
                    </div>
                    <div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;">
                        @foreach (var gImg in Model.GymImages.OrderBy(i => i.DisplayOrder))
                        {
                            <div style="position:relative;width:78px;height:58px;flex-shrink:0;border-radius:4px;overflow:hidden;border:2px solid @(gImg.IsCover ? "#6366f1" : "#e5e7eb");box-shadow:@(gImg.IsCover ? "0 0 0 1px #6366f1" : "none");">
                                <img src="@gImg.ImageUrl" alt="gallery" style="width:100%;height:100%;object-fit:cover;" />
                                @if (gImg.IsCover)
                                {
                                    <span style="position:absolute;bottom:0;left:0;right:0;background:#6366f1;color:#fff;font-size:0.55rem;font-weight:800;text-align:center;line-height:15px;text-transform:uppercase;letter-spacing:0.5px;">BÌA</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="content-card-body">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                    <h2 style="font-family:'Montserrat',sans-serif;font-weight:800;font-size:1.4rem;color:#111;margin:0;">@Model.Name</h2>
                    @{
                        string badgeCls = Model.Status switch {
                            "Approved" => "badge-approved", "Rejected" => "badge-rejected",
                            "Pending" => "badge-pending", _ => "badge-suspended"
                        };
                        string statusText = Model.Status switch {
                            "Approved" => "Đã duyệt", "Rejected" => "Từ chối",
                            "Pending" => "Chờ duyệt", _ => Model.Status
                        };
                    }
                    <span class="badge-status @badgeCls">@statusText</span>
                </div>

                <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:1.4rem;">
                    <div style="font-size:0.85rem;color:#555;">
                        <i class="bi bi-geo-alt me-2" style="color:#6366f1;"></i>@Model.Address
                    </div>
                    <div style="font-size:0.82rem;color:#888;">
                        <i class="bi bi-calendar3 me-2" style="color:#6366f1;"></i>
                        Đăng ký ngày @Model.CreatedAt.ToString("dd/MM/yyyy")
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div style="background:#f8f9fa;border-radius:10px;padding:1.2rem;">
                        <p style="margin:0;font-size:0.88rem;color:#555;line-height:1.7;">@Model.Description</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Packages summary -->
        <div class="content-card">
            <div class="content-card-header">
                <h5><i class="bi bi-card-list me-2" style="color:#6366f1;"></i>Gói dịch vụ</h5>
                <a asp-controller="OwnerPackage" asp-action="Create" asp-route-gymId="@Model.Id"
                   style="font-size:0.78rem;color:#6366f1;text-decoration:none;font-weight:600;">+ Thêm</a>
            </div>
            <div class="content-card-body">
                @if (Model.MembershipPackages?.Any() == true)
                {
                    @foreach (var pkg in Model.MembershipPackages.Take(5))
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:0.7rem 0;border-bottom:1px solid #f5f5f5;">
                            <div>
                                <div style="font-size:0.82rem;font-weight:600;color:#111;">@pkg.Name</div>
                                <div style="font-size:0.72rem;color:#999;">@pkg.PackageType @(pkg.DurationInMonths.HasValue ? $"— {pkg.DurationInMonths} tháng" : "")</div>
                            </div>
                            <div>
                                <span style="font-weight:700;font-size:0.85rem;color:#6366f1;">@String.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N0}", pkg.Price)₫</span>
                            </div>
                        </div>
                    }
                    @if (Model.MembershipPackages.Count > 5)
                    {
                        <div style="font-size:0.78rem;color:#888;text-align:center;padding:0.6rem 0;">
                            +@(Model.MembershipPackages.Count - 5) gói khác
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:0.82rem;color:#bbb;text-align:center;padding:1rem 0;margin:0;">
                        Chưa có gói nào
                    </p>
                }
            </div>
        </div>
    </div>
</div>
