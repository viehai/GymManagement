@model GymManagement.ViewModels.RegisterGymViewModel
@{
    ViewData["Title"] = "Chỉnh sửa phòng Gym";
    Layout = "_OwnerAdminLayout";
    var existingImage = ViewBag.ExistingImage as string;
    var gymId = (int)ViewBag.GymId;
    int usedSlots = Model.ExistingImages.Count;
    int remaining = 10 - usedSlots;
}

<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
    <a asp-action="Index" class="btn-owner-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
    <a asp-action="Details" asp-route-id="@gymId" class="btn-owner-secondary">
        <i class="bi bi-eye"></i> Xem chi tiết
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-0 mb-3" style="border-left:3px solid #1A7F4F!important;font-size:0.85rem;">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 rounded-0 mb-3" style="border-left:3px solid #CF2020!important;font-size:0.85rem;">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
    </div>
}

<form asp-action="Edit" asp-route-id="@gymId" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- ─── LEFT: Form thông tin ─── -->
        <div class="col-lg-7">
            <div class="content-card">
                <div class="content-card-header">
                    <h5><i class="bi bi-pencil-square me-2" style="color:#6366f1;"></i>Thông tin cơ bản</h5>
                </div>
                <div class="content-card-body">
                    <div class="owner-form-group">
                        <label asp-for="Name">Tên phòng Gym <span style="color:#ef4444;">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="owner-form-group">
                        <label asp-for="Address">Địa chỉ <span style="color:#ef4444;">*</span></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="owner-form-group">
                        <label asp-for="Description">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn-owner-primary flex-grow-1">
                            <i class="bi bi-floppy"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn-owner-secondary">Hủy</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ─── RIGHT: Gallery ─── -->
        <div class="col-lg-5">
            <div class="content-card">
                <div class="content-card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">
                        <i class="bi bi-images me-2" style="color:#6366f1;"></i>Gallery ảnh
                    </h5>
                    <span style="font-size:0.72rem;font-weight:600;color:#9ca3af;">
                        @usedSlots / 10 ảnh
                    </span>
                </div>
                <div class="content-card-body" style="padding-top:0.8rem;">

                    <!-- Ảnh hiện tại -->
                    @if (Model.ExistingImages.Any())
                    {
                        <p style="font-size:0.7rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#9ca3af;margin-bottom:0.6rem;">
                            Ảnh hiện tại
                        </p>
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(95px,1fr));gap:8px;margin-bottom:1rem;">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <div style="position:relative;aspect-ratio:1;overflow:hidden;background:#e5e7eb;border-radius:4px;border:2px solid @(img.IsCover ? "#6366f1" : "#e5e7eb");box-shadow:@(img.IsCover ? "0 0 0 1px #6366f1" : "none");">
                                    <img src="@img.ImageUrl" alt="gallery"
                                         style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                                    @if (img.IsCover)
                                    {
                                        <span style="position:absolute;bottom:4px;left:4px;background:#6366f1;
                                                     color:#FFF;font-size:0.58rem;font-weight:800;padding:2px 6px;
                                                     border-radius:2px;text-transform:uppercase;letter-spacing:0.8px;display:flex;align-items:center;gap:3px;">
                                            <i class="bi bi-star-fill" style="font-size:0.55rem;"></i> BÌA
                                        </span>
                                    }
                                    <!-- Nút xóa từng ảnh -->
                                    <button type="button" onclick="deleteGalleryImage(@img.Id)"
                                            title="Xóa ảnh này khỏi thư viện"
                                            style="position:absolute;top:4px;right:4px;width:22px;height:22px;background:rgba(0,0,0,0.75);color:#FFF;
                                                   border:none;border-radius:3px;cursor:pointer;font-size:0.85rem;
                                                   display:flex;align-items:center;justify-content:center;transition:background 0.15s;"
                                            onmouseover="this.style.background='#ef4444';"
                                            onmouseout="this.style.background='rgba(0,0,0,0.75)';">
                                        <i class="bi bi-x"></i>
                                    </button>
                                    @if (!img.IsCover)
                                    {
                                        <!-- Nút đặt bìa -->
                                        <button type="button" onclick="setCoverImage(@img.Id)"
                                                title="Đặt làm ảnh bìa"
                                                style="position:absolute;bottom:4px;right:4px;width:24px;height:24px;background:rgba(30,27,75,0.85);color:#facc15;
                                                       border:1px solid rgba(250,204,21,0.5);border-radius:3px;cursor:pointer;font-size:0.8rem;
                                                       display:flex;align-items:center;justify-content:center;transition:all 0.15s;"
                                                onmouseover="this.style.background='#6366f1';this.style.color='#fff';"
                                                onmouseout="this.style.background='rgba(30,27,75,0.85)';this.style.color='#facc15';">
                                            <i class="bi bi-star"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Upload thêm ảnh -->
                    @if (remaining > 0)
                    {
                        <p style="font-size:0.7rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#9ca3af;margin-bottom:0.6rem;">
                            Thêm ảnh mới (@remaining vị trí trống)
                        </p>
                        <div id="editGalleryDrop"
                             style="border:2px dashed #d1d5db;padding:1.2rem;text-align:center;
                                    cursor:pointer;background:#fafafa;position:relative;transition:all 0.18s;">
                            <input type="file" name="GalleryFiles" id="editGalleryInput"
                                   accept=".jpg,.jpeg,.png,.webp" multiple
                                   style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;" />
                            <i class="bi bi-cloud-arrow-up" style="font-size:1.5rem;color:#cbd5e1;"></i>
                            <p style="font-size:0.78rem;color:#64748b;margin:0.3rem 0 0;">
                                Kéo thả hoặc <strong>click</strong> để chọn ảnh
                            </p>
                            <p style="font-size:0.68rem;color:#94a3b8;margin:0.15rem 0 0;">
                                JPG, PNG, WebP · tối đa 5MB/ảnh
                            </p>
                        </div>

                        <div id="editPreviewGrid"
                             style="display:grid;grid-template-columns:repeat(auto-fill,minmax(72px,1fr));gap:6px;margin-top:8px;"></div>

                        <div id="editCounter" style="font-size:0.72rem;color:#9ca3af;margin-top:6px;display:none;">
                            <span id="editCountNum">0</span> ảnh mới được chọn
                        </div>
                    }
                    else
                    {
                        <div style="border:1px dashed #d1d5db;padding:1rem;text-align:center;color:#9ca3af;font-size:0.78rem;">
                            <i class="bi bi-slash-circle me-1"></i> Đã đạt giới hạn 10 ảnh
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Hidden form cho các action gallery (SetCover, DeleteImage) tách biệt khỏi form chính -->
<form id="galleryActionForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="imageId" id="galleryActionImageId" />
    <input type="hidden" name="returnUrl" value="@Url.Action("Edit", "OwnerGym", new { id = gymId })" />
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function setCoverImage(imageId) {
            const form = document.getElementById('galleryActionForm');
            form.action = '@Url.Action("SetCover", "OwnerGym")';
            document.getElementById('galleryActionImageId').value = imageId;
            form.submit();
        }

        function deleteGalleryImage(imageId) {
            if (!confirm('Bạn có chắc chắn muốn xóa ảnh này khỏi Gallery?')) return;
            const form = document.getElementById('galleryActionForm');
            form.action = '@Url.Action("DeleteImage", "OwnerGym")';
            document.getElementById('galleryActionImageId').value = imageId;
            form.submit();
        }

        (function () {
            const dropZone    = document.getElementById('editGalleryDrop');
            const fileInput   = document.getElementById('editGalleryInput');
            const previewGrid = document.getElementById('editPreviewGrid');
            const counterEl   = document.getElementById('editCounter');
            const countNumEl  = document.getElementById('editCountNum');
            if (!dropZone) return;

            let selectedFiles = [];
            const MAX_NEW = @remaining;

            dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = '#6366f1'; });
            dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = '#d1d5db'; });
            dropZone.addEventListener('drop', e => {
                e.preventDefault(); dropZone.style.borderColor = '#d1d5db';
                addFiles(Array.from(e.dataTransfer.files));
            });
            fileInput.addEventListener('change', () => addFiles(Array.from(fileInput.files)));

            function addFiles(files) {
                const allowed = ['image/jpeg','image/png','image/webp'];
                files.forEach(f => {
                    if (selectedFiles.length >= MAX_NEW) return;
                    if (!allowed.includes(f.type)) return;
                    if (selectedFiles.find(x => x.name === f.name && x.size === f.size)) return;
                    selectedFiles.push(f);
                    renderThumb(f, selectedFiles.length - 1);
                });
                sync();
            }

            function renderThumb(file, idx) {
                const reader = new FileReader();
                reader.onload = e => {
                    const item = document.createElement('div');
                    item.style.cssText = 'position:relative;aspect-ratio:1;overflow:hidden;background:#e5e7eb;';
                    item.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;">
                        <button type="button" data-idx="${idx}" style="position:absolute;top:2px;right:2px;width:18px;height:18px;background:rgba(0,0,0,0.7);color:#FFF;border:none;cursor:pointer;font-size:0.7rem;display:flex;align-items:center;justify-content:center;">×</button>`;
                    item.querySelector('button').addEventListener('click', () => {
                        selectedFiles.splice(idx, 1);
                        rebuildPreviews();
                        sync();
                    });
                    previewGrid.appendChild(item);
                };
                reader.readAsDataURL(file);
            }

            function rebuildPreviews() {
                previewGrid.innerHTML = '';
                selectedFiles.forEach((f, i) => renderThumb(f, i));
            }

            function sync() {
                const dt = new DataTransfer();
                selectedFiles.forEach(f => dt.items.add(f));
                fileInput.files = dt.files;
                counterEl.style.display = selectedFiles.length ? 'block' : 'none';
                countNumEl.textContent = selectedFiles.length;
            }
        })();
    </script>
}
