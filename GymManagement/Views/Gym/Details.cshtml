<!-- Đường dẫn file: Views/Gym/Details.cshtml -->
@model GymManagement.ViewModels.GymDetailsViewModel

@{
    Layout = "_MemberLayout";
    ViewData["Title"] = Model.Name + " — Chi tiết phòng Gym";
}

<style>
    /* ═══════════════════════════════════════════════
       PAGE: GYM DETAILS — INK WASH PALETTE
       Flat Design · No border-radius · No box-shadow
    ═══════════════════════════════════════════════ */

    /* ── Hero banner ── */
    .gym-hero {
        position: relative;
        width: 100%;
        aspect-ratio: 21 / 7;
        overflow: hidden;
        background: #E8E8E8;
    }
    .gym-hero img {
        width: 100%; height: 100%;
        object-fit: cover;
        display: block;
    }
    .gym-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(37,37,37,0.75) 0%, transparent 55%);
    }
    .gym-hero-caption {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        padding: 2rem 2.5rem;
    }
    .gym-hero-caption h1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(1.6rem, 4vw, 2.8rem);
        color: #FFFFFF;
        margin: 0 0 0.4rem;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }
    .gym-hero-caption .gym-address {
        font-size: 0.88rem;
        color: rgba(255,255,255,0.8);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* ── Breadcrumb ── */
    .gym-breadcrumb {
        padding: 1rem 0;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #7D7D7D;
        border-bottom: 1px solid #CFCFCF;
    }
    .gym-breadcrumb a { color: #7D7D7D; text-decoration: none; }
    .gym-breadcrumb a:hover { color: #252525; }
    .gym-breadcrumb span { color: #252525; }

    /* ── Layout chính: content + sidebar ── */
    .gym-details-layout {
        padding: 3rem 0 5rem;
    }

    /* ── Section heading ── */
    .section-heading {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 0.7rem;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #7D7D7D;
        margin-bottom: 1.2rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid #CFCFCF;
    }

    /* ── Description ── */
    .gym-description {
        font-size: 0.95rem;
        color: #545454;
        line-height: 1.8;
        white-space: pre-line;
    }

    /* ── Ink divider ── */
    .ink-divider-v {
        border: none;
        border-top: 1px solid #CFCFCF;
        margin: 2.5rem 0;
    }

    /* ── Equipment Grid ── */
    .equipment-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 1rem;
    }
    .equipment-card {
        border: 1px solid #CFCFCF;
        background: #FFFFFF;
        overflow: hidden;
        text-align: center;
        transition: border-color 0.2s;
    }
    .equipment-card:hover { border-color: #7D7D7D; }
    .equipment-img-wrap {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #F5F5F5;
    }
    .equipment-img-wrap img {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .equipment-card:hover .equipment-img-wrap img { transform: scale(1.06); }
    .equipment-no-img {
        width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        color: #CFCFCF;
        font-size: 2rem;
    }
    .equipment-name {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        color: #252525;
        padding: 0.6rem 0.5rem;
        line-height: 1.3;
    }
    /* ── Equipment Badges & Filters ── */
    .equipment-badge-custom {
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #7D7D7D;
        border: 1px solid #CFCFCF;
        padding: 2px 6px;
        display: inline-block;
        margin-bottom: 0.5rem;
    }

    .eq-filter-pill {
        display: inline-block;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 0.4rem 0.85rem;
        border: 1px solid #CFCFCF;
        background: #FFFFFF;
        color: #7D7D7D;
        cursor: pointer;
        transition: all 0.15s ease;
        border-radius: 0 !important;
    }
    .eq-filter-pill:hover,
    .eq-filter-pill.active {
        border-color: #252525;
        background: #252525;
        color: #FFFFFF !important;
    }

    /* ── Empty equipment state ── */
    .empty-section {
        padding: 2rem 1rem;
        text-align: center;
        border: 1px dashed #CFCFCF;
        color: #7D7D7D;
        font-size: 0.85rem;
    }
    .empty-section .bi { font-size: 2rem; display: block; margin-bottom: 0.5rem; color: #CFCFCF; }

    /* ── Sidebar: sticky container ── */
    .gym-sidebar {
        position: sticky;
        top: 80px;
    }

    /* ── Live Crowd Meter Widget ── */
    .crowd-meter-widget {
        border: 1px solid #252525;
        background: #FFFFFF;
        padding: 1.25rem 1.4rem;
        margin-bottom: 2rem;
    }
    .crowd-widget-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 0.68rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #252525;
    }
    .crowd-status-pill {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        padding: 2px 8px;
        border: 1px solid;
    }
    .crowd-widget-bar-track {
        height: 8px;
        background: #F0F0F0;
        overflow: hidden;
        margin-top: 0.75rem;
    }
    .crowd-widget-bar-fill {
        height: 100%;
        transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .crowd-recommendation-note {
        font-size: 0.76rem;
        color: #64748b;
        line-height: 1.4;
        border-top: 1px dashed #E2E8F0;
        padding-top: 0.5rem;
    }
    .live-pulse-dot {
        animation: livePulse 1.8s infinite;
    }
    @@keyframes livePulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    /* ── Package cards ── */
    .package-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
        margin-bottom: 0.75rem;
    }
    .package-card-link:last-child { margin-bottom: 0; }
    .package-card-link:hover { color: inherit; }

    .package-card {
        border: 1px solid #CFCFCF;
        background: #FFFFFF;
        padding: 1.2rem 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        transition: all 0.2s ease;
        position: relative;
    }
    .package-card:hover {
        border-color: #252525;
        background-color: #FAFAFA;
        transform: translateY(-1px);
    }
    .package-card-action {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #7D7D7D;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: color 0.15s ease;
    }
    .package-card:hover .package-card-action {
        color: #252525;
    }

    .package-type-badge {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        display: inline-block;
        padding: 3px 8px;
        border: 1px solid #CFCFCF;
        color: #7D7D7D;
        width: fit-content;
    }
    .package-type-badge.daily {
        border-color: #252525;
        color: #252525;
    }
    .package-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.9rem;
        color: #252525;
        margin: 0.3rem 0 0;
    }
    .package-price {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 1.3rem;
        color: #252525;
        letter-spacing: -0.5px;
    }
    .package-price span {
        font-size: 0.72rem;
        font-weight: 500;
        color: #7D7D7D;
        letter-spacing: 0;
    }

    /* ── CTA Buttons ── */
    .btn-cta-primary {
        display: block;
        width: 100%;
        text-align: center;
        background: #252525;
        color: #FFFFFF;
        border: none;
        border-radius: 0 !important;
        box-shadow: none !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 0.9rem 1rem;
        text-decoration: none;
        transition: background 0.2s;
        margin-bottom: 0.5rem;
    }
    .btn-cta-primary:hover { background: #545454; color: #FFFFFF; text-decoration: none; }

    .btn-cta-outline {
        display: block;
        width: 100%;
        text-align: center;
        background: transparent;
        color: #252525;
        border: 1px solid #252525;
        border-radius: 0 !important;
        box-shadow: none !important;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 0.9rem 1rem;
        text-decoration: none;
        transition: background 0.2s, color 0.2s;
    }
    .btn-cta-outline:hover { background: #252525; color: #FFFFFF; text-decoration: none; }

    .cta-divider {
        border: none;
        border-top: 1px solid #CFCFCF;
        margin: 1rem 0;
    }

    .cta-note {
        font-size: 0.72rem;
        color: #7D7D7D;
        text-align: center;
        margin-top: 0.75rem;
    }
    .cta-note a { color: #7D7D7D; }
    .cta-note a:hover { color: #252525; }

    /* ── No packages state ── */
    .no-packages {
        border: 1px dashed #CFCFCF;
        padding: 2rem 1rem;
        text-align: center;
        color: #7D7D7D;
        font-size: 0.85rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .gym-hero { aspect-ratio: 16 / 9; }
        .gym-hero-caption { padding: 1.2rem 1rem; }
        .gym-hero-caption h1 { font-size: 1.4rem; }
        .gym-sidebar { position: static; }
    }

    /* ── Gallery Carousel (V2) ── */
    .gallery-hero {
        position: relative;
        width: 100%;
        aspect-ratio: 21 / 7;
        overflow: hidden;
        background: #111;
        cursor: pointer;
    }
    @@media (max-width: 768px) { .gallery-hero { aspect-ratio: 16 / 9; } }

    .gallery-hero .slide {
        position: absolute; inset: 0;
        opacity: 0; transition: opacity 0.5s ease;
    }
    .gallery-hero .slide.active { opacity: 1; }
    .gallery-hero .slide img {
        width: 100%; height: 100%;
        object-fit: cover; display: block;
    }
    .gallery-hero .slide-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(37,37,37,0.75) 0%, transparent 55%);
    }
    .gallery-hero-caption {
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 2rem 2.5rem; pointer-events: none;
    }
    @@media (max-width: 768px) { .gallery-hero-caption { padding: 1.2rem 1rem; } }
    .gallery-hero-caption h1 {
        font-family: 'Montserrat', sans-serif; font-weight: 900;
        font-size: clamp(1.4rem, 4vw, 2.8rem); color: #FFF;
        margin: 0 0 0.4rem; letter-spacing: -0.5px; line-height: 1.1;
    }
    .gallery-hero-caption .gym-address {
        font-size: 0.88rem; color: rgba(255,255,255,0.8);
        display: flex; align-items: center; gap: 5px;
    }
    /* Arrow nav */
    .gallery-nav {
        position: absolute; top: 50%; transform: translateY(-50%);
        background: rgba(37,37,37,0.65); color: #FFF; border: none;
        width: 40px; height: 40px; font-size: 1.1rem;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: background 0.2s; z-index: 5;
        pointer-events: all;
    }
    .gallery-nav:hover { background: rgba(37,37,37,0.9); }
    .gallery-nav.prev { left: 12px; }
    .gallery-nav.next { right: 12px; }
    /* Counter badge */
    .gallery-counter {
        position: absolute; top: 12px; right: 12px;
        background: rgba(37,37,37,0.65); color: #FFF;
        font-family: 'Montserrat', sans-serif; font-size: 0.68rem;
        font-weight: 700; letter-spacing: 1px;
        padding: 0.25rem 0.6rem; z-index: 5;
    }
    /* Expand hint */
    .gallery-expand-hint {
        position: absolute; bottom: 60px; right: 12px;
        background: rgba(37,37,37,0.65); color: rgba(255,255,255,0.9);
        font-family: 'Montserrat', sans-serif; font-size: 0.65rem;
        font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
        padding: 0.3rem 0.7rem; z-index: 5; cursor: pointer;
        transition: background 0.15s;
        pointer-events: all;
    }
    .gallery-expand-hint:hover { background: rgba(37,37,37,0.9); }
    /* Thumbnail strip */
    .gallery-thumbstrip {
        display: flex; gap: 4px; padding: 4px;
        background: #111; overflow-x: auto;
        scrollbar-width: none;
    }
    .gallery-thumbstrip::-webkit-scrollbar { display: none; }
    .gallery-thumbstrip .thumb {
        width: 72px; height: 52px; flex-shrink: 0;
        object-fit: cover; cursor: pointer;
        opacity: 0.5; border: 2px solid transparent;
        transition: opacity 0.2s, border-color 0.2s;
    }
    .gallery-thumbstrip .thumb.active {
        opacity: 1; border-color: #FFF;
    }
    /* Lightbox */
    .gym-lightbox {
        display: none; position: fixed; inset: 0; z-index: 9999;
        background: rgba(0,0,0,0.95);
        align-items: center; justify-content: center;
        flex-direction: column; gap: 12px;
    }
    .gym-lightbox.open { display: flex; }
    .gym-lightbox-img {
        max-width: 92vw; max-height: 82vh;
        object-fit: contain; display: block;
    }
    .gym-lightbox-close {
        position: absolute; top: 16px; right: 20px;
        color: #FFF; font-size: 1.8rem; cursor: pointer;
        background: none; border: none; opacity: 0.8;
    }
    .gym-lightbox-close:hover { opacity: 1; }
    .gym-lightbox-nav {
        position: absolute; top: 50%; transform: translateY(-50%);
        background: rgba(255,255,255,0.12); color: #FFF; border: none;
        width: 48px; height: 48px; font-size: 1.4rem;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: background 0.2s;
    }
    .gym-lightbox-nav:hover { background: rgba(255,255,255,0.25); }
    .gym-lightbox-nav.prev { left: 16px; }
    .gym-lightbox-nav.next { right: 16px; }
    .gym-lightbox-counter {
        color: rgba(255,255,255,0.6); font-family: 'Montserrat', sans-serif;
        font-size: 0.75rem; font-weight: 600; letter-spacing: 1.5px;
    }
</style>

@if (Model.HasGallery)
{
    <!-- ═══════════════ GALLERY HERO (V2) ═══════════════ -->
    <div class="gallery-hero" id="gallery-hero" title="Bấm để xem ảnh lớn">
        @foreach (var img in Model.GalleryImages)
        {
            <div class="slide @(img.IsCover ? "active" : "")" data-src="@img.ImageUrl">
                <img src="@img.ImageUrl" alt="@Model.Name" loading="lazy" />
                <div class="slide-overlay"></div>
            </div>
        }

        <!-- Caption -->
        <div class="gallery-hero-caption">
            <h1>@Model.Name</h1>
            <p class="gym-address">
                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                <span>@Model.Address</span>
            </p>
        </div>

        <!-- Counter -->
        <span class="gallery-counter" id="gallery-counter">1 / @Model.GalleryImages.Count</span>

        <!-- Nav arrows (shown only if >1 image) -->
        @if (Model.GalleryImages.Count > 1)
        {
            <button class="gallery-nav prev" id="gallery-prev" aria-label="Ảnh trước">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="gallery-nav next" id="gallery-next" aria-label="Ảnh kế">
                <i class="bi bi-chevron-right"></i>
            </button>
        }

        <!-- Expand hint -->
        <button class="gallery-expand-hint" id="gallery-expand" aria-label="Xem ảnh lớn">
            <i class="bi bi-arrows-fullscreen me-1"></i>Xem gallery
        </button>
    </div>

    <!-- Thumbnail strip -->
    @if (Model.GalleryImages.Count > 1)
    {
        <div class="gallery-thumbstrip" id="thumb-strip">
            @foreach (var img in Model.GalleryImages)
            {
                <img src="@img.ImageUrl"
                     class="thumb @(img.IsCover ? "active" : "")"
                     alt="Thumbnail"
                     data-src="@img.ImageUrl"
                     loading="lazy" />
            }
        </div>
    }
}
else
{
    <!-- ═══════════════ HERO BANNER (V1 fallback) ═══════════════ -->
    <div class="gym-hero">
        <img src="@Model.DisplayImage"
             alt="Ảnh đại diện @Model.Name"
             onerror="this.src='https://static.wixstatic.com/media/7e9c4c_5d4a9443f1fd4b7a8f8d0ca05ef2b8a8~mv2.jpg/v1/fill/w_1905,h_945,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/7e9c4c_5d4a9443f1fd4b7a8f8d0ca05ef2b8a8~mv2.jpg';" />
        <div class="gym-hero-overlay"></div>
        <div class="gym-hero-caption">
            <h1>@Model.Name</h1>
            <p class="gym-address">
                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                <span>@Model.Address</span>
            </p>
        </div>
    </div>
}

<!-- Lightbox modal -->
<div class="gym-lightbox" id="gym-lightbox" role="dialog" aria-label="Gallery lightbox">
    <button class="gym-lightbox-close" id="lightbox-close" aria-label="Đóng">&times;</button>
    <button class="gym-lightbox-nav prev" id="lightbox-prev" aria-label="Ảnh trước">
        <i class="bi bi-chevron-left"></i>
    </button>
    <img src="" alt="" class="gym-lightbox-img" id="lightbox-img" />
    <span class="gym-lightbox-counter" id="lightbox-counter"></span>
    <button class="gym-lightbox-nav next" id="lightbox-next" aria-label="Ảnh kế">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<!-- Breadcrumb -->
<div class="container">
    <nav class="gym-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
        &nbsp;/&nbsp;
        <a asp-controller="Gym" asp-action="Search">Tìm Phòng Gym</a>
        &nbsp;/&nbsp;
        <span>@Model.Name</span>
    </nav>
</div>

<!-- ═══════════════════════════════════════════════
     MAIN LAYOUT: CONTENT + SIDEBAR
═══════════════════════════════════════════════ -->
<div class="container gym-details-layout">
    <div class="row g-5">

        <!-- ── LEFT: Main content ── -->
        <div class="col-12 col-lg-8">

            <!-- 1. Mô tả -->
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <section aria-label="Giới thiệu phòng Gym">
                    <p class="section-heading">Giới thiệu</p>
                    <p class="gym-description">@Model.Description</p>
                </section>

                <hr class="ink-divider-v" />
            }

            <!-- 2. Thiết bị -->
            <section aria-label="Danh sách thiết bị">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <p class="section-heading mb-0" style="padding-bottom:0; border-bottom:none;">Thiết bị & Máy tập</p>
                    <span class="text-muted small" style="font-size:0.75rem;">(@Model.Equipments.Count thiết bị)</span>
                </div>

                @if (Model.HasEquipments)
                {
                    var eqCategories = Model.Equipments
                        .Select(e => e.Category)
                        .Where(c => !string.IsNullOrEmpty(c))
                        .Distinct()
                        .OrderBy(c => c)
                        .ToList();

                    if (eqCategories.Count > 1)
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-3 pb-1" id="eqFilterPills">
                            <button type="button" class="eq-filter-pill active" onclick="filterGymEquipments('all', this)">
                                Tất cả (@Model.Equipments.Count)
                            </button>
                            @foreach (var cat in eqCategories)
                            {
                                var catCount = Model.Equipments.Count(e => e.Category == cat);
                                <button type="button" class="eq-filter-pill" onclick="filterGymEquipments('@cat', this)">
                                    @cat (@catCount)
                                </button>
                            }
                        </div>
                    }

                    <div class="equipment-grid" id="gymEquipmentGrid">
                        @foreach (var eq in Model.Equipments)
                        {
                            <div class="equipment-card" data-category="@eq.Category">
                                <div class="equipment-img-wrap">
                                    @if (!string.IsNullOrWhiteSpace(eq.DisplayImage))
                                    {
                                        <img src="@eq.DisplayImage"
                                             alt="@eq.DisplayName"
                                             loading="lazy"
                                             onerror="this.parentElement.innerHTML='<div class=\'equipment-no-img\'><i class=\'bi bi-gear\'></i></div>';" />
                                    }
                                    else
                                    {
                                        <div class="equipment-no-img">
                                            <i class="bi bi-gear" aria-hidden="true"></i>
                                        </div>
                                    }
                                </div>
                                <div class="equipment-name">
                                    <div style="font-size:0.6rem; color:#7D7D7D; text-transform:uppercase; margin-bottom:2px; font-weight:700;">
                                        @eq.Category
                                    </div>
                                    @eq.DisplayName
                                    @if (eq.IsCustom)
                                    {
                                        <br />
                                        <span class="equipment-badge-custom">Tự thêm</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-section">
                        <i class="bi bi-gear"></i>
                        Chưa có thông tin thiết bị cho phòng Gym này.
                    </div>
                }
            </section>

        </div>

        <!-- ── RIGHT: Sidebar / Đặt vé ── -->
        <div class="col-12 col-lg-4">
            <aside class="gym-sidebar" aria-label="Đặt vé tập Gym">

                <!-- ── WIDGET THƯỚC ĐO ĐỘ ĐÔNG ĐÚC REALTIME (CROWD METER) ── -->
                <div class="crowd-meter-widget" id="liveCrowdWidget">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="crowd-widget-title">
                            <i class="bi bi-broadcast me-1 text-danger live-pulse-dot"></i> Trực tiếp tại phòng tập
                        </span>
                        <span class="crowd-status-pill" style="color: @Model.CrowdStatusColor; border-color: @Model.CrowdStatusColor; background-color: @(Model.CrowdStatusColor)15;">
                            <i class="bi @Model.CrowdStatusIcon me-1"></i>@Model.CrowdStatusText
                        </span>
                    </div>

                    <div class="crowd-widget-bar-track">
                        <div class="crowd-widget-bar-fill" style="width: @Model.CrowdPercentage%; background-color: @Model.CrowdStatusColor;"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2" style="font-size: 0.8rem;">
                        <span class="text-muted fw-semibold">
                            <strong class="text-dark">@Model.CurrentActiveMembers</strong> / @Model.MaxCapacity người tập
                        </span>
                        <span class="fw-bold" style="color: @Model.CrowdStatusColor;">
                            @Model.CrowdPercentage% công suất
                        </span>
                    </div>

                    <p class="crowd-recommendation-note mb-0 mt-2">
                        <i class="bi bi-info-circle me-1"></i>@Model.CrowdRecommendation
                    </p>
                </div>

                <p class="section-heading">Gói vé & Đặt chỗ</p>

                @if (Model.HasPackages)
                {
                    <!-- Danh sách gói -->
                    <div class="mb-3">
                        @foreach (var pkg in Model.Packages)
                        {
                            var targetUrl = pkg.PackageType == "Daily"
                                ? Url.Action("DailyPass", "Purchase", new { gymId = Model.Id })
                                : Url.Action("Package", "Purchase", new { gymId = Model.Id, packageId = pkg.Id });

                            <a href="@targetUrl" class="package-card-link" title="Chọn mua gói @pkg.Name">
                                <div class="package-card" id="pkg-@pkg.Id">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="package-type-badge @(pkg.PackageType == "Daily" ? "daily" : "")">
                                            @pkg.TypeLabel
                                        </span>
                                        <span class="package-card-action">
                                            Chọn mua <i class="bi bi-arrow-right"></i>
                                        </span>
                                    </div>
                                    <p class="package-name">@pkg.Name</p>
                                    <p class="package-price">
                                        @pkg.Price.ToString("N0") đ
                                        @if (pkg.PackageType == "Monthly")
                                        {
                                            <span>&nbsp;/ @pkg.DurationInMonths tháng</span>
                                        }
                                        else
                                        {
                                            <span>&nbsp;/ lượt</span>
                                        }
                                    </p>
                                </div>
                            </a>
                        }
                    </div>

                    <hr class="cta-divider" />

                    <!-- CTA buttons -->
                    @if (Model.IsOwnerOfThisGym)
                    {
                        <div class="p-3 border border-dark bg-light text-center mb-2">
                            <i class="bi bi-shield-check text-dark fs-3 d-block mb-1"></i>
                            <p class="fw-bold text-uppercase mb-1" style="font-family:'Montserrat',sans-serif; font-size:0.78rem; letter-spacing:1px; color:#252525;">
                                BẠN LÀ CHỦ PHÒNG GYM NÀY
                            </p>
                            <p class="text-muted small mb-3" style="font-size:0.75rem; line-height:1.4;">
                                Bạn có quyền cấu hình gói vé, cập nhật thiết bị và theo dõi doanh thu của cơ sở này.
                            </p>
                            <a asp-controller="OwnerPackage" asp-action="Index" asp-route-gymId="@Model.Id" class="btn btn-dark rounded-0 w-100 fw-bold py-2 text-uppercase" style="font-size:0.72rem; letter-spacing:1.5px;">
                                <i class="bi bi-gear-fill me-1"></i> VÀO TRANG QUẢN TRỊ GYM
                            </a>
                        </div>
                    }
                    else
                    {
                        @if (Model.HasDailyPass)
                        {
                            <a id="btn-daily-pass-@Model.Id"
                               asp-controller="Purchase"
                               asp-action="DailyPass"
                               asp-route-gymId="@Model.Id"
                               class="btn-cta-primary">
                                <i class="bi bi-ticket-perforated me-2"></i>Mua vé ngày
                            </a>
                        }

                        @if (Model.HasMonthlyPackage)
                        {
                            <a id="btn-monthly-package-@Model.Id"
                               asp-controller="Purchase"
                               asp-action="Package"
                               asp-route-gymId="@Model.Id"
                               class="btn-cta-outline">
                                <i class="bi bi-calendar-check me-2"></i>Đăng ký gói tháng
                            </a>
                        }

                        <p class="cta-note">
                            @if (!User.Identity!.IsAuthenticated)
                            {
                                <span>
                                    <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                                    để tiến hành thanh toán.
                                </span>
                            }
                            else
                            {
                                <span>Giá hiển thị chưa bao gồm phí dịch vụ (nếu có).</span>
                            }
                        </p>
                    }
                }
                else
                {
                    <div class="no-packages">
                        <i class="bi bi-ticket-slash d-block mb-2" style="font-size:1.8rem;color:#CFCFCF;"></i>
                        Phòng Gym chưa mở bán vé.
                        <br /><small>Vui lòng quay lại sau.</small>
                    </div>
                }

                <hr class="cta-divider" />

                <!-- Back link -->
                <a asp-controller="Gym" asp-action="Search"
                   style="font-family:'Montserrat',sans-serif;font-size:0.7rem;font-weight:600;
                          letter-spacing:1.5px;text-transform:uppercase;color:#7D7D7D;
                          text-decoration:none;display:flex;align-items:center;gap:5px;">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>

            </aside>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function filterGymEquipments(cat, btn) {
            // Đổi class active trên các nút pill
            document.querySelectorAll('#eqFilterPills .eq-filter-pill').forEach(function(b) {
                b.classList.remove('active');
            });
            if (btn) btn.classList.add('active');

            // Ẩn / hiện các thẻ thiết bị
            document.querySelectorAll('#gymEquipmentGrid .equipment-card').forEach(function(card) {
                var cardCat = card.getAttribute('data-category');
                if (cat === 'all' || cardCat === cat) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // ── Gallery carousel + Lightbox ────────────────────────────────
        (function () {
            const slides    = Array.from(document.querySelectorAll('.gallery-hero .slide'));
            const thumbs    = Array.from(document.querySelectorAll('#thumb-strip .thumb'));
            const counterEl = document.getElementById('gallery-counter');
            const lightbox  = document.getElementById('gym-lightbox');
            const lbImg     = document.getElementById('lightbox-img');
            const lbCounter = document.getElementById('lightbox-counter');

            if (!slides.length) return;

            let current = slides.findIndex(s => s.classList.contains('active'));
            if (current < 0) current = 0;

            function goTo(idx) {
                slides[current].classList.remove('active');
                if (thumbs[current]) thumbs[current].classList.remove('active');

                current = (idx + slides.length) % slides.length;

                slides[current].classList.add('active');
                if (thumbs[current]) thumbs[current].classList.add('active');
                if (counterEl) counterEl.textContent = (current + 1) + ' / ' + slides.length;
            }

            // Arrow nav
            const prevBtn = document.getElementById('gallery-prev');
            const nextBtn = document.getElementById('gallery-next');
            if (prevBtn) prevBtn.addEventListener('click', e => { e.stopPropagation(); goTo(current - 1); });
            if (nextBtn) nextBtn.addEventListener('click', e => { e.stopPropagation(); goTo(current + 1); });

            // Thumbnail clicks
            thumbs.forEach((t, i) => t.addEventListener('click', () => goTo(i)));

            // Auto-play every 4s
            let autoPlay = setInterval(() => goTo(current + 1), 4000);
            const heroEl = document.getElementById('gallery-hero');
            if (heroEl) {
                heroEl.addEventListener('mouseenter', () => clearInterval(autoPlay));
                heroEl.addEventListener('mouseleave', () => {
                    autoPlay = setInterval(() => goTo(current + 1), 4000);
                });
            }

            // ── Lightbox ──
            if (!lightbox) return;

            function getSrc(idx) {
                return slides[idx]?.dataset?.src || slides[idx]?.querySelector('img')?.src || '';
            }

            function openLightbox(idx) {
                current = idx;
                lbImg.src = getSrc(current);
                if (lbCounter) lbCounter.textContent = (current + 1) + ' / ' + slides.length;
                lightbox.classList.add('open');
                document.body.style.overflow = 'hidden';
            }

            function closeLightbox() {
                lightbox.classList.remove('open');
                document.body.style.overflow = '';
            }

            function lbNext() {
                current = (current + 1) % slides.length;
                lbImg.src = getSrc(current);
                if (lbCounter) lbCounter.textContent = (current + 1) + ' / ' + slides.length;
            }

            function lbPrev() {
                current = (current - 1 + slides.length) % slides.length;
                lbImg.src = getSrc(current);
                if (lbCounter) lbCounter.textContent = (current + 1) + ' / ' + slides.length;
            }

            // Open on hero click / expand button
            if (heroEl) heroEl.addEventListener('click', () => openLightbox(current));
            const expandBtn = document.getElementById('gallery-expand');
            if (expandBtn) expandBtn.addEventListener('click', e => { e.stopPropagation(); openLightbox(current); });

            document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
            document.getElementById('lightbox-next')?.addEventListener('click', lbNext);
            document.getElementById('lightbox-prev')?.addEventListener('click', lbPrev);

            // Close on backdrop click
            lightbox.addEventListener('click', e => { if (e.target === lightbox) closeLightbox(); });

            // Keyboard nav
            document.addEventListener('keydown', e => {
                if (!lightbox.classList.contains('open')) return;
                if (e.key === 'ArrowRight') lbNext();
                else if (e.key === 'ArrowLeft') lbPrev();
                else if (e.key === 'Escape') closeLightbox();
            });
        })();
    </script>
}

