@model List<GymManagement.ViewModels.SuspensionItemViewModel>

@{
    ViewData["Title"] = "Giám sát đình chỉ toàn hệ thống";
    Layout = "_AdminLayout";

    var gyms = ViewBag.Gyms as List<GymManagement.Models.Gym> ?? new List<GymManagement.Models.Gym>();
    int? selectedGymId = ViewBag.SelectedGymId as int?;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    string searchTerm = ViewBag.SearchTerm as string ?? "";

    int totalCount = ViewBag.TotalCount ?? 0;
    int activeCount = ViewBag.ActiveCount ?? 0;
    int permanentCount = ViewBag.PermanentCount ?? 0;
    int liftedCount = ViewBag.LiftedCount ?? 0;
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 style="font-family:'Montserrat',sans-serif; font-size:1.35rem; font-weight:900; color:#111; margin:0 0 4px;">
            <i class="bi bi-shield-slash text-danger me-2"></i>Giám sát kỷ luật & đình chỉ hội viên
        </h2>
        <p style="margin:0; font-size:0.85rem; color:#888;">
            Tổng hợp và giám sát tất cả quyết định đình chỉ hội viên trên toàn bộ các phòng Gym của hệ thống.
        </p>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="content-card" style="padding:1.2rem; border-left:4px solid #111;">
            <div style="font-size:0.72rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:1px;">Tổng quyết định</div>
            <div style="font-family:'Montserrat',sans-serif; font-size:1.8rem; font-weight:900; color:#111; margin-top:4px;">
                @totalCount
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="content-card" style="padding:1.2rem; border-left:4px solid #ef4444;">
            <div style="font-size:0.72rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:1px;">Đang hiệu lực</div>
            <div style="font-family:'Montserrat',sans-serif; font-size:1.8rem; font-weight:900; color:#ef4444; margin-top:4px;">
                @activeCount
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="content-card" style="padding:1.2rem; border-left:4px solid #7f1d1d;">
            <div style="font-size:0.72rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:1px;">Cấm vĩnh viễn (Blacklist)</div>
            <div style="font-family:'Montserrat',sans-serif; font-size:1.8rem; font-weight:900; color:#7f1d1d; margin-top:4px;">
                @permanentCount
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="content-card" style="padding:1.2rem; border-left:4px solid #10b981;">
            <div style="font-size:0.72rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:1px;">Đã gỡ bỏ</div>
            <div style="font-family:'Montserrat',sans-serif; font-size:1.8rem; font-weight:900; color:#10b981; margin-top:4px;">
                @liftedCount
            </div>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="content-card mb-4" style="padding:1.2rem;">
    <form method="get" class="row g-2 align-items-center">
        <input type="hidden" name="status" value="@selectedStatus" />

        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@searchTerm" class="form-control border-start-0" placeholder="Tìm theo tên hội viên, email, lý do..." />
            </div>
        </div>

        <div class="col-12 col-md-4">
            <select name="gymId" class="form-select">
                <option value="">-- Tất cả cơ sở phòng Gym (@gyms.Count) --</option>
                @foreach (var g in gyms)
                {
                    <option value="@g.Id" selected="@(selectedGymId == g.Id)">@g.Name</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn-admin-primary flex-grow-1">
                <i class="bi bi-funnel me-1"></i> Lọc
            </button>
            <a asp-controller="AdminSuspension" asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Status Filter Tabs -->
<div class="d-flex align-items-center gap-2 mb-3 overflow-auto pb-1">
    <a asp-controller="AdminSuspension" asp-action="Index" asp-route-gymId="@selectedGymId" asp-route-search="@searchTerm" asp-route-status="All"
       class="btn @(selectedStatus == "All" ? "btn-dark text-white" : "btn-light text-muted")"
       style="font-size:0.82rem; font-weight:600; border-radius:8px; padding:0.45rem 1rem;">
        Tất cả
    </a>
    <a asp-controller="AdminSuspension" asp-action="Index" asp-route-gymId="@selectedGymId" asp-route-search="@searchTerm" asp-route-status="Active"
       class="btn @(selectedStatus == "Active" ? "btn-danger text-white" : "btn-light text-muted")"
       style="font-size:0.82rem; font-weight:600; border-radius:8px; padding:0.45rem 1rem;">
        <i class="bi bi-slash-circle-fill me-1"></i> Đang hiệu lực
    </a>
    <a asp-controller="AdminSuspension" asp-action="Index" asp-route-gymId="@selectedGymId" asp-route-search="@searchTerm" asp-route-status="Lifted"
       class="btn @(selectedStatus == "Lifted" ? "btn-success text-white" : "btn-light text-muted")"
       style="font-size:0.82rem; font-weight:600; border-radius:8px; padding:0.45rem 1rem;">
        <i class="bi bi-check-circle-fill me-1"></i> Đã gỡ bỏ
    </a>
    <a asp-controller="AdminSuspension" asp-action="Index" asp-route-gymId="@selectedGymId" asp-route-search="@searchTerm" asp-route-status="Expired"
       class="btn @(selectedStatus == "Expired" ? "btn-secondary text-white" : "btn-light text-muted")"
       style="font-size:0.82rem; font-weight:600; border-radius:8px; padding:0.45rem 1rem;">
        <i class="bi bi-clock-history me-1"></i> Đã hết hạn
    </a>
</div>

<!-- Main Table Card -->
<div class="content-card">
    <div class="content-card-header">
        <h5 class="content-card-title"><i class="bi bi-card-checklist me-2"></i>Danh sách quyết định (@Model.Count kết quả)</h5>
    </div>

    @if (!Model.Any())
    {
        <div style="padding:4rem 1.5rem; text-align:center; color:#999;">
            <i class="bi bi-check2-circle" style="font-size:3rem; color:#10b981; display:block; margin-bottom:0.8rem;"></i>
            <p style="font-size:0.95rem; font-weight:600; color:#374151; margin:0 0 4px;">Không tìm thấy quyết định đình chỉ nào phù hợp</p>
            <p style="font-size:0.82rem; color:#888; margin:0;">
                Hãy thử thay đổi điều kiện tìm kiếm hoặc chọn cơ sở khác.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Hội viên</th>
                        <th>Cơ sở Gym</th>
                        <th>Hình thức</th>
                        <th>Thời hạn</th>
                        <th>Lý do vi phạm</th>
                        <th>Người ban hành</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Can thiệp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr id="admin-suspension-row-@s.Id" style="@(s.IsCurrentlyActive ? "background:#fff8f8;" : "")">
                            <td>
                                <div style="font-weight:700; color:#111;">@s.MemberName</div>
                                <div style="font-size:0.78rem; color:#888;">
                                    <i class="bi bi-envelope me-1"></i>@s.MemberEmail
                                </div>
                            </td>
                            <td>
                                <span style="font-weight:600; font-size:0.85rem; color:#374151;">@s.GymName</span>
                            </td>
                            <td>
                                @if (s.SuspensionType == "Permanent")
                                {
                                    <span class="badge" style="background:#fee2e2; color:#991b1b; border:1px solid #f87171; font-weight:700; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-shield-x me-1"></i> Vĩnh viễn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#fef3c7; color:#92400e; border:1px solid #fcd34d; font-weight:700; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-hourglass-split me-1"></i> Tạm thời
                                    </span>
                                }
                            </td>
                            <td>
                                <div style="font-size:0.82rem;">
                                    <div><span style="color:#888;">Từ:</span> <strong>@s.StartDate.ToString("dd/MM/yyyy")</strong></div>
                                    @if (s.SuspensionType == "Permanent")
                                    {
                                        <div class="text-danger" style="font-size:0.75rem; font-weight:600;">Không thời hạn</div>
                                    }
                                    else
                                    {
                                        <div><span style="color:#888;">Đến:</span> <strong style="color:#111;">@(s.EndDate.HasValue ? s.EndDate.Value.ToString("dd/MM/yyyy") : "—")</strong></div>
                                    }
                                </div>
                            </td>
                            <td style="max-width:240px;">
                                <div style="font-size:0.82rem; color:#1f2937; word-break:break-word;" title="@s.Reason">
                                    @s.Reason
                                </div>
                            </td>
                            <td>
                                <div style="font-size:0.82rem; font-weight:600; color:#374151;">@s.SuspendedByUserName</div>
                                <div style="font-size:0.72rem; color:#9ca3af;">@s.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                @if (s.Status == "Lifted")
                                {
                                    <span class="badge" style="background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; font-weight:700; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-check2 me-1"></i> Đã gỡ
                                    </span>
                                    @if (!string.IsNullOrEmpty(s.LiftedReason))
                                    {
                                        <div style="font-size:0.7rem; color:#6b7280; margin-top:2px;" title="@s.LiftedReason">
                                            @(s.LiftedReason.Length > 25 ? s.LiftedReason.Substring(0, 25) + "..." : s.LiftedReason)
                                        </div>
                                    }
                                }
                                else if (!s.IsCurrentlyActive)
                                {
                                    <span class="badge" style="background:#f3f4f6; color:#6b7280; border:1px solid #e5e7eb; font-weight:600; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-clock-history me-1"></i> Đã hết hạn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#ef4444; color:#fff; font-weight:700; font-size:0.75rem; padding:4px 8px;">
                                        <i class="bi bi-slash-circle me-1"></i> Hiệu lực
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (s.IsCurrentlyActive)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-success"
                                            data-bs-toggle="modal"
                                            data-bs-target="#adminLiftSuspensionModal"
                                            data-suspension-id="@s.Id"
                                            data-member-name="@s.MemberName"
                                            data-gym-name="@s.GymName"
                                            title="Admin can thiệp gỡ đình chỉ">
                                        <i class="bi bi-unlock me-1"></i> Gỡ
                                    </button>
                                }
                                else
                                {
                                    <span style="font-size:0.75rem; color:#9ca3af; font-style:italic;">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Admin Gỡ đình chỉ -->
<div class="modal fade" id="adminLiftSuspensionModal" tabindex="-1" aria-labelledby="adminLiftSuspensionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 20px 25px -5px rgba(0,0,0,0.1);">
            <form asp-controller="AdminSuspension" asp-action="LiftSuspension" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="suspensionId" id="adminModalSuspensionId" value="" />

                <div class="modal-header" style="border-bottom:1px solid #f0f0f0; padding:1.2rem 1.5rem;">
                    <h5 class="modal-title" id="adminLiftSuspensionModalLabel" style="font-size:1rem; font-weight:700; color:#111;">
                        <i class="bi bi-shield-check text-success me-2"></i>Can thiệp gỡ bỏ lệnh đình chỉ
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" style="padding:1.5rem;">
                    <p style="font-size:0.88rem; color:#4b5563; margin-bottom:1rem;">
                        Bạn đang thực hiện can thiệp cấp Quản trị viên (Admin) để gỡ bỏ quyết định kỷ luật cho hội viên
                        <strong id="adminModalMemberName" style="color:#111;">—</strong> tại cơ sở <strong id="adminModalGymName" style="color:#111;">—</strong>.
                    </p>

                    <div class="mb-3">
                        <label for="adminLiftedReason" style="font-size:0.82rem; font-weight:600; color:#374151; margin-bottom:4px; display:block;">Ghi chú / Căn cứ can thiệp:</label>
                        <textarea name="liftedReason" id="adminLiftedReason" class="form-control" rows="3" placeholder="Nhập căn cứ xử lý (ví dụ: Hội viên khiếu nại thành công, hòa giải thành công...)" required></textarea>
                    </div>
                </div>

                <div class="modal-footer" style="border-top:1px solid #f0f0f0; padding:1rem 1.5rem;">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-check-lg me-1"></i> Xác nhận can thiệp gỡ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const adminLiftModal = document.getElementById('adminLiftSuspensionModal');
        if (adminLiftModal) {
            adminLiftModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const suspensionId = button.getAttribute('data-suspension-id');
                const memberName = button.getAttribute('data-member-name');
                const gymName = button.getAttribute('data-gym-name');

                document.getElementById('adminModalSuspensionId').value = suspensionId;
                document.getElementById('adminModalMemberName').textContent = memberName;
                document.getElementById('adminModalGymName').textContent = gymName;
            });
        }
    </script>
}
