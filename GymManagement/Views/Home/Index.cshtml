@model IEnumerable<GymManagement.Models.Gym>
@{
    Layout = "_MemberLayout";
    ViewData["Title"] = "Trang chủ";

    // Danh sách ảnh mẫu tỷ lệ 4:5 chất lượng cao nếu gym chưa có ảnh
    var fallbackImages = new[]
    {
        "https://images.unsplash.com/photo-1540497077202-7c8a3999166f?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1571902943202-507ec2618e8f?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1593079831268-3381b0db4a77?q=80&w=800&auto=format&fit=crop"
    };

    var gymsList = Model?.ToList() ?? new List<GymManagement.Models.Gym>();
}

<style>
    /* ══════════════════════════════════════════════════════════════
       PHONG CÁCH NIKE (BRUTAL MINIMALISM) — INK WASH PALETTE
       Đen: #252525 | Xám đậm: #545454 | Xám trung: #7D7D7D | Trắng: #FFFFFF
       KHÔNG bo góc (rounded-0) | KHÔNG đổ bóng (box-shadow: none)
    ══════════════════════════════════════════════════════════════ */

    /* Reset & Base Typography */
    body {
        background-color: #FFFFFF;
        color: #252525;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, h6, .nike-headline {
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }

    /* ── KHỐI 1: HERO BANNER (TRÀN VIỀN 85VH) ── */
    .hero-banner-nike {
        height: 85vh;
        min-height: 560px;
        position: relative;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
    }

    .hero-bg-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%) contrast(115%) brightness(65%);
        transform: scale(1.02);
        transition: transform 8s ease-out;
    }
    .hero-banner-nike:hover .hero-bg-img {
        transform: scale(1.06);
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(180deg, rgba(37,37,37,0.3) 0%, rgba(37,37,37,0.85) 100%);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        padding: 0 1.5rem;
        max-width: 1100px;
    }

    .hero-eyebrow {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 4px;
        color: rgba(255, 255, 255, 0.7);
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    .hero-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(2.6rem, 7vw, 5.5rem);
        line-height: 0.95;
        letter-spacing: -2px;
        color: #FFFFFF;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .btn-hero-cta {
        display: inline-block;
        background-color: #FFFFFF;
        color: #252525 !important;
        border: none;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        padding: 1.1rem 3.5rem;
        text-decoration: none;
        box-shadow: none !important;
        transition: all 0.25s ease;
    }
    .btn-hero-cta:hover {
        background-color: #E5E5E5;
        color: #000000 !important;
        transform: translateY(-2px);
    }

    /* ── KHỐI 2: FEATURED GYMS (CARD TÀNG HÌNH) ── */
    .section-title-nike {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: clamp(1.4rem, 3vw, 2rem);
        color: #252525;
        letter-spacing: -0.5px;
        text-transform: uppercase;
    }

    .gym-invisible-card {
        border: none !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 0;
        transition: transform 0.3s ease;
    }

    .gym-img-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background-color: #EAEAEA;
    }

    .gym-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(30%) contrast(105%);
        transition: transform 0.5s cubic-bezier(0.165, 0.84, 0.44, 1), filter 0.3s ease;
    }

    .gym-invisible-card:hover .gym-img-wrapper img {
        transform: scale(1.05);
        filter: grayscale(0%) contrast(105%);
    }

    .gym-meta-box {
        padding-top: 1.2rem;
    }

    .gym-name-nike {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.15rem;
        font-weight: 900;
        color: #252525;
        text-transform: uppercase;
        letter-spacing: -0.3px;
        margin: 0 0 0.35rem 0;
        line-height: 1.25;
    }

    .gym-address-nike {
        font-size: 0.84rem;
        color: #7D7D7D;
        margin: 0 0 1rem 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-gym-view {
        background-color: #252525;
        color: #FFFFFF !important;
        border: 1px solid #252525;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 0.8rem 1rem;
        width: 100%;
        box-shadow: none !important;
        text-decoration: none;
        text-align: center;
        transition: all 0.2s ease;
    }
    .btn-gym-view:hover {
        background-color: #545454;
        border-color: #545454;
        color: #FFFFFF !important;
    }

    /* ── KHỐI 3: THE STATEMENT (TUYÊN NGÔN 50/50) ── */
    .statement-section {
        background-color: #252525;
        margin: 6rem 0 0 0;
    }

    .statement-img-col {
        min-height: 520px;
        background-color: #1a1a1a;
        position: relative;
    }

    .statement-img {
        width: 100%;
        height: 100%;
        min-height: 520px;
        object-fit: cover;
        filter: grayscale(100%) contrast(120%) brightness(85%);
        display: block;
    }

    .statement-content-col {
        background-color: #252525;
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5rem 3.5rem;
    }

    .statement-inner {
        max-width: 580px;
    }

    .statement-eyebrow {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #7D7D7D;
        margin-bottom: 1.2rem;
    }

    .statement-text {
        font-family: 'Montserrat', sans-serif;
        font-size: clamp(1.4rem, 2.6vw, 2.3rem);
        font-weight: 900;
        line-height: 1.2;
        letter-spacing: -1px;
        color: #FFFFFF;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
    }

    .statement-sub {
        font-size: 0.95rem;
        color: #A0A0A0;
        line-height: 1.6;
        margin-bottom: 2.5rem;
    }

    .btn-statement-cta {
        display: inline-block;
        background-color: transparent;
        color: #FFFFFF !important;
        border: 2px solid #FFFFFF;
        border-radius: 0 !important;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        padding: 1rem 2.8rem;
        text-decoration: none;
        box-shadow: none !important;
        transition: all 0.25s ease;
    }
    .btn-statement-cta:hover {
        background-color: #FFFFFF;
        color: #252525 !important;
        border-color: #FFFFFF;
    }

    /* ── KHỐI 4: BRAND PILLARS (TỐI GIẢN BRUTAL) ── */
    .brand-pillars {
        padding: 5rem 0;
        background-color: #FFFFFF;
        border-top: 1px solid #CFCFCF;
    }

    .pillar-num {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 0.8rem;
        color: #7D7D7D;
        letter-spacing: 2px;
        margin-bottom: 0.5rem;
    }

    .pillar-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 1.2rem;
        color: #252525;
        text-transform: uppercase;
        letter-spacing: -0.5px;
        margin-bottom: 0.6rem;
    }

    .pillar-desc {
        font-size: 0.85rem;
        color: #7D7D7D;
        line-height: 1.5;
        margin: 0;
    }

    @@media (max-width: 991px) {
        .statement-content-col {
            padding: 4rem 2rem;
        }
        .statement-img-col {
            min-height: 380px;
        }
        .statement-img {
            min-height: 380px;
        }
    }
</style>

<!-- ══════════════════════════════════════════════════════════════
     KHỐI 1: HERO BANNER (TRÀN VIỀN 85VH)
══════════════════════════════════════════════════════════════ -->
<div class="container-fluid px-0">
    <section class="hero-banner-nike">
        <!-- Background vận động viên Unsplash grayscale dramatic -->
        <img class="hero-bg-img"
             src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=2070&auto=format&fit=crop"
             alt="Athletic Movement - GymPro" />
        <div class="hero-overlay"></div>

        <div class="hero-content">
            <p class="hero-eyebrow">GYMPRO &bull; BRUTAL PERFORMANCE</p>
            <h1 class="hero-title display-3 fw-bolder text-uppercase">VƯỢT QUA GIỚI HẠN</h1>
            <p class="text-white-50 text-uppercase fw-semibold mb-4 d-none d-md-block" style="letter-spacing:2px; font-size:0.9rem;">
                HỆ THỐNG PHÒNG TẬP CAO CẤP &bull; TRANG THIẾT BỊ ĐẠT CHUẨN QUỐC TẾ
            </p>
            <a asp-controller="Gym" asp-action="Search" class="btn-hero-cta">
                TÌM PHÒNG TẬP
            </a>
        </div>
    </section>
</div>

<!-- ══════════════════════════════════════════════════════════════
     KHỐI 2: FEATURED GYMS (KHÁM PHÁ CƠ SỞ - CARD TÀNG HÌNH TỶ LỆ 4:5)
══════════════════════════════════════════════════════════════ -->
<section class="container py-5 my-md-4">
    <div class="d-flex align-items-end justify-content-between mb-4 pb-2 border-bottom border-dark border-2">
        <h2 class="section-title-nike h3 fw-bolder mb-0">CƠ SỞ NỔI BẬT</h2>
        <a asp-controller="Gym" asp-action="Search"
           class="text-decoration-none fw-bold text-uppercase d-inline-flex align-items-center gap-1"
           style="color:#252525; font-size:0.75rem; letter-spacing:1.5px; font-family:'Montserrat',sans-serif;">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row g-4">
        @if (gymsList.Any())
        {
            @for (int i = 0; i < Math.Min(3, gymsList.Count); i++)
            {
                var gym = gymsList[i];
                var imgSrc = !string.IsNullOrEmpty(gym.ImageUrl) ? gym.ImageUrl : fallbackImages[i % fallbackImages.Length];

                <div class="col-12 col-md-4">
                    <div class="gym-invisible-card">
                        <div class="gym-img-wrapper">
                            <img src="@imgSrc" alt="@gym.Name" loading="lazy" />
                        </div>
                        <div class="gym-meta-box">
                            <h3 class="gym-name-nike">@gym.Name</h3>
                            <p class="gym-address-nike">
                                <i class="bi bi-geo-alt me-1"></i>@gym.Address
                            </p>
                            <a asp-controller="Gym" asp-action="Details" asp-route-id="@gym.Id" class="btn-gym-view">
                                XEM CHI TIẾT
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Fallback hiển thị mẫu chuẩn phong cách Nike nếu DB chưa có Gym -->
            <div class="col-12 col-md-4">
                <div class="gym-invisible-card">
                    <div class="gym-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1540497077202-7c8a3999166f?q=80&w=800&auto=format&fit=crop" alt="GymPro Icon Central" />
                    </div>
                    <div class="gym-meta-box">
                        <h3 class="gym-name-nike">GYMPRO CENTRAL ELITE</h3>
                        <p class="gym-address-nike"><i class="bi bi-geo-alt me-1"></i>Số 01 Lê Duẩn, Quận 1, TP. Hồ Chí Minh</p>
                        <a asp-controller="Gym" asp-action="Search" class="btn-gym-view">XEM CHI TIẾT</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="gym-invisible-card">
                    <div class="gym-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1571902943202-507ec2618e8f?q=80&w=800&auto=format&fit=crop" alt="GymPro Power District" />
                    </div>
                    <div class="gym-meta-box">
                        <h3 class="gym-name-nike">GYMPRO POWER LAB</h3>
                        <p class="gym-address-nike"><i class="bi bi-geo-alt me-1"></i>Số 88 Cầu Giấy, Quận Cầu Giấy, Hà Nội</p>
                        <a asp-controller="Gym" asp-action="Search" class="btn-gym-view">XEM CHI TIẾT</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="gym-invisible-card">
                    <div class="gym-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1593079831268-3381b0db4a77?q=80&w=800&auto=format&fit=crop" alt="GymPro Athletic Zone" />
                    </div>
                    <div class="gym-meta-box">
                        <h3 class="gym-name-nike">GYMPRO ATHLETIC ZONE</h3>
                        <p class="gym-address-nike"><i class="bi bi-geo-alt me-1"></i>Số 45 Nguyễn Văn Linh, Hải Châu, Đà Nẵng</p>
                        <a asp-controller="Gym" asp-action="Search" class="btn-gym-view">XEM CHI TIẾT</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- ══════════════════════════════════════════════════════════════
     KHỐI 3: THE STATEMENT (TUYÊN NGÔN 50/50 TRÀN VIỀN)
══════════════════════════════════════════════════════════════ -->
<div class="container-fluid px-0">
    <section class="statement-section">
        <div class="row g-0 align-items-stretch">
            <!-- Cột trái: Ảnh tạ tự do / cutting phase tràn lề -->
            <div class="col-12 col-lg-6 statement-img-col">
                <img class="statement-img"
                     src="https://images.unsplash.com/photo-1526506118085-60ce8714f8c5?q=80&w=1200&auto=format&fit=crop"
                     alt="GymPro Free Weight Strength Training" />
            </div>

            <!-- Cột phải: Nền đen #252525 + Tuyên ngôn màu trắng -->
            <div class="col-12 col-lg-6 statement-content-col">
                <div class="statement-inner">
                    <p class="statement-eyebrow">THE GYMPRO STATEMENT</p>
                    <h2 class="statement-text">
                        KHÔNG GIAN ĐỈNH CAO. TỪ KHU VỰC FREE-WEIGHT CHO ĐẾN LISS CARDIO. CHÚNG TÔI ĐÁP ỨNG MỌI MỤC TIÊU CỦA BẠN.
                    </h2>
                    <p class="statement-sub">
                        Không có đường tắt dẫn đến thành công. Chỉ có sự kiên trì, kỷ luật và một môi trường tập luyện đạt chuẩn quốc tế sẵn sàng đẩy bạn vượt xa mọi giới hạn trước đó.
                    </p>
                    <a asp-controller="Account" asp-action="Register" class="btn-statement-cta">
                        TRỞ THÀNH HỘI VIÊN
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- ══════════════════════════════════════════════════════════════
     KHỐI 4: BRAND PILLARS (GIÁ TRỊ CỐT LÕI TỐI GIẢN)
══════════════════════════════════════════════════════════════ -->
<section class="brand-pillars">
    <div class="container">
        <div class="row g-5">
            <div class="col-12 col-md-4">
                <div class="pillar-num">01 / TRANG THIẾT BỊ</div>
                <h3 class="pillar-title">TIÊU CHUẨN OLYMPIC</h3>
                <p class="pillar-desc">
                    Hệ thống máy tạ khối, tạ tự do Eleiko & Hammer Strength được tuyển chọn nghiêm ngặt cho từng bài tập.
                </p>
            </div>
            <div class="col-12 col-md-4">
                <div class="pillar-num">02 / TIỆN ÍCH</div>
                <h3 class="pillar-title">KHÔNG GIAN TẬP TRUNG</h3>
                <p class="pillar-desc">
                    Thiết kế brutalist tối giản, loại bỏ mọi xao nhãng để bạn hoàn toàn tập trung vào từng hiệp tạ và hơi thở.
                </p>
            </div>
            <div class="col-12 col-md-4">
                <div class="pillar-num">03 / HỆ THỐNG</div>
                <h3 class="pillar-title">MẠNG LƯỚI ĐA CƠ SỞ</h3>
                <p class="pillar-desc">
                    Một tài khoản duy nhất truy cập hàng loạt phòng Gym cao cấp trên toàn quốc với thanh toán trực tuyến linh hoạt.
                </p>
            </div>
        </div>
    </div>
</section>
