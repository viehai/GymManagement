@using GymManagement.Helpers

@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item dropdown notification-bell-wrapper list-unstyled">
        <form id="notificationAntiForgeryForm" style="display:none;">
            @Html.AntiForgeryToken()
        </form>

        <a class="nav-link notification-bell-btn" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo">
            <i class="bi bi-bell-fill fs-5"></i>
            <span id="notificationBadge" class="notification-badge d-none">0</span>
        </a>

        <div class="dropdown-menu dropdown-menu-end notification-dropdown-panel shadow-sm border" aria-labelledby="notificationDropdown">
            <div class="notification-header d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                <span class="notification-title fw-bold">THÔNG BÁO</span>
                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-muted btn-mark-all-read" style="font-size:0.75rem;">
                    <i class="bi bi-check2-all me-1"></i>Đọc tất cả
                </button>
            </div>

            <div id="notificationDropdownList" class="notification-list custom-scrollbar">
                <div class="text-center py-4 text-muted small">
                    <div class="spinner-border spinner-border-sm text-secondary mb-1" role="status"></div>
                    <div>Đang tải thông báo...</div>
                </div>
            </div>

            <div class="notification-footer text-center py-2 border-top bg-light">
                <a asp-controller="Notification" asp-action="Index" class="text-dark fw-bold text-decoration-none" style="font-size:0.78rem; letter-spacing:0.5px;">
                    XEM TẤT CẢ THÔNG BÁO &rarr;
                </a>
            </div>
        </div>

        <!-- Live Floating Toast: Hiện thông báo mới nhất dưới quả chuông -->
        <div id="notificationLiveToast" class="notification-live-toast d-none" role="alert" aria-live="assertive">
            <div class="live-toast-border-accent"></div>
            <div class="live-toast-inner">
                <div class="live-toast-top">
                    <span class="live-toast-tag">
                        <span class="live-toast-pulse"></span> THÔNG BÁO MỚI
                    </span>
                    <button type="button" class="live-toast-close" id="toastCloseBtn" title="Đóng">&times;</button>
                </div>
                <div class="live-toast-main">
                    <div class="live-toast-icon" id="toastIconBox">
                        <i class="bi bi-bell-fill" id="toastIcon"></i>
                    </div>
                    <div class="live-toast-body">
                        <div class="live-toast-title" id="toastTitle">Thông báo</div>
                        <div class="live-toast-desc" id="toastMessage">Nội dung thông báo...</div>
                        <div class="live-toast-footer">
                            <span id="toastTime"><i class="bi bi-clock me-1"></i>Vừa xong</span>
                            <span class="live-toast-hint">Nhấn để xem <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="live-toast-progress-bar" id="toastProgressBar"></div>
        </div>
    </li>

    <style>
        .notification-bell-wrapper { position: relative; display: inline-flex; align-items: center; }
        .notification-bell-btn { position: relative; padding: 0.5rem 0.75rem !important; color: #252525 !important; border-bottom: none !important; transition: color 0.2s; cursor: pointer; }
        .notification-bell-btn:hover { color: #000 !important; }
        .notification-badge { position: absolute; top: 4px; right: 2px; background: #ef4444; color: #fff; font-size: 0.65rem; font-weight: 800; padding: 2px 5px; border-radius: 10px; min-width: 17px; text-align: center; line-height: 1; box-shadow: 0 0 0 2px #fff; transition: transform 0.2s cubic-bezier(.36,.07,.19,.97); }
        .notification-badge.badge-bump { animation: badgeBump 0.35s ease-out; }
        @@keyframes badgeBump { 0%,100% { transform: scale(1); } 40% { transform: scale(1.45); } 70% { transform: scale(0.9); } }

        .notification-dropdown-panel { width: 360px; max-width: 90vw; border-radius: 4px; border-color: #e5e7eb !important; padding: 0; margin-top: 8px; z-index: 1050; }
        .notification-header .notification-title { font-family: 'Montserrat', sans-serif; font-size: 0.75rem; letter-spacing: 1.5px; color: #111; }
        .notification-list { max-height: 360px; overflow-y: auto; }
        .notification-item { display: flex; align-items: flex-start; gap: 12px; padding: 10px 14px; border-bottom: 1px solid #f3f4f6; text-decoration: none; color: #1f2937; transition: background 0.15s; cursor: pointer; }
        .notification-item:hover { background: #f9fafb; color: #111; }
        .notification-item.unread { background: #f8fafc; }
        .notification-item.unread .notification-item-title { font-weight: 700; color: #000; }
        .notification-icon-box { width: 32px; height: 32px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.95rem; flex-shrink: 0; margin-top: 2px; }
        .notification-item-title { font-size: 0.82rem; font-weight: 600; line-height: 1.3; margin-bottom: 2px; }
        .notification-item-desc { font-size: 0.74rem; color: #6b7280; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 4px; }
        .notification-item-time { font-size: 0.68rem; color: #9ca3af; }
        .unread-dot { width: 7px; height: 7px; background: #ef4444; border-radius: 50%; margin-left: auto; flex-shrink: 0; margin-top: 6px; }

        /* ── Live Toast Floating Popup ── */
        .notification-live-toast {
            --t-accent: #6366f1; --t-bg: #e0e7ff; --t-fg: #3730a3;
            position: absolute; top: calc(100% + 8px); right: 0; width: 380px; max-width: calc(100vw - 24px);
            background: #fff; border: 1px solid #e5e7eb; border-radius: 6px;
            box-shadow: 0 12px 30px -4px rgba(0,0,0,0.16), 0 6px 14px -3px rgba(0,0,0,0.08);
            z-index: 1060; cursor: pointer; overflow: hidden; opacity: 0; transform: translateY(-8px);
            transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16,1,0.3,1), box-shadow 0.2s; pointer-events: none;
        }
        .notification-live-toast.type-success { --t-accent: #10b981; --t-bg: #d1fae5; --t-fg: #065f46; }
        .notification-live-toast.type-danger  { --t-accent: #ef4444; --t-bg: #fee2e2; --t-fg: #991b1b; }
        .notification-live-toast.type-warning { --t-accent: #f59e0b; --t-bg: #fef3c7; --t-fg: #92400e; }
        .notification-live-toast.type-info    { --t-accent: #6366f1; --t-bg: #e0e7ff; --t-fg: #3730a3; }

        .notification-live-toast.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
        .notification-live-toast.fading-out { opacity: 0; transform: translateY(-6px); pointer-events: none; transition: opacity 0.8s ease, transform 0.8s ease; }
        .notification-live-toast:hover { box-shadow: 0 16px 36px -4px rgba(0,0,0,0.22), 0 8px 16px -3px rgba(0,0,0,0.1); border-color: #cbd5e1; }

        .live-toast-border-accent { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--t-accent); }
        .live-toast-inner { padding: 12px 14px 12px 18px; display: flex; flex-direction: column; gap: 8px; }
        .live-toast-top { display: flex; align-items: center; justify-content: space-between; }
        .live-toast-tag { font-family: 'Montserrat', sans-serif; font-size: 0.65rem; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; display: inline-flex; align-items: center; gap: 6px; color: #111; }
        .live-toast-pulse { width: 7px; height: 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 2px rgba(16,185,129,0.25); animation: liveToastPulse 1.8s infinite; }
        @@keyframes liveToastPulse { 0%,100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16,185,129,0.5); } 70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16,185,129,0); } }

        .live-toast-close { background: transparent; border: none; color: #9ca3af; font-size: 1.2rem; line-height: 1; padding: 0 4px; cursor: pointer; transition: color 0.15s; }
        .live-toast-close:hover { color: #111; }
        .live-toast-main { display: flex; align-items: flex-start; gap: 12px; }
        .live-toast-icon { width: 36px; height: 36px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; background: var(--t-bg); color: var(--t-fg); }
        .live-toast-body { flex-grow: 1; min-width: 0; }
        .live-toast-title { font-family: 'Montserrat', sans-serif; font-size: 0.84rem; font-weight: 700; color: #111; margin-bottom: 2px; line-height: 1.3; }
        .live-toast-desc { font-size: 0.76rem; color: #4b5563; line-height: 1.35; margin-bottom: 6px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .live-toast-footer { display: flex; align-items: center; justify-content: space-between; font-size: 0.68rem; color: #9ca3af; }
        .live-toast-hint { font-family: 'Montserrat', sans-serif; font-weight: 700; letter-spacing: 0.5px; color: #111; text-transform: uppercase; font-size: 0.68rem; display: inline-flex; align-items: center; gap: 4px; transition: color 0.15s; }
        .notification-live-toast:hover .live-toast-hint { color: #ef4444; }

        .live-toast-progress-bar { position: absolute; bottom: 0; left: 0; height: 3px; width: 100%; background: var(--t-accent); opacity: 0.9; transform-origin: left; }
        .live-toast-progress-bar.animate-progress { animation: liveToastCountdown 5s linear forwards; }
        @@keyframes liveToastCountdown { from { width: 100%; } to { width: 0%; } }
    </style>

    <script src="~/lib/signalr/signalr.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var badgeEl       = document.getElementById('notificationBadge');
            var dropdownEl    = document.getElementById('notificationDropdown');
            var listEl        = document.getElementById('notificationDropdownList');
            var markAllBtn    = document.querySelector('.btn-mark-all-read');
            var liveToastEl   = document.getElementById('notificationLiveToast');
            var toastProgress = document.getElementById('toastProgressBar');
            var currentUnread = 0;
            var currentToastItem = null;
            var liveToastTimer   = null;

            function getCsrfToken() {
                var tokenInput = document.querySelector('#notificationAntiForgeryForm input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            function updateBadge(count) {
                if (!badgeEl) return;
                currentUnread = count;
                if (count > 0) {
                    badgeEl.textContent = count > 99 ? '99+' : count;
                    badgeEl.classList.remove('d-none');
                } else {
                    badgeEl.textContent = '0';
                    badgeEl.classList.add('d-none');
                }
            }

            function bumpBadge() {
                if (!badgeEl) return;
                badgeEl.classList.remove('badge-bump');
                void badgeEl.offsetWidth;
                badgeEl.classList.add('badge-bump');
            }

            // ── Live Floating Toast Logic ────────────────────────────────
            function showLiveToast(item) {
                if (!liveToastEl || !item) return;
                currentToastItem = item;

                liveToastEl.classList.remove('d-none', 'fading-out', 'show', 'type-success', 'type-danger', 'type-warning', 'type-info');
                var typeClass = 'type-' + (item.type ? item.type.toLowerCase() : 'info');
                liveToastEl.classList.add(typeClass);

                var titleEl = document.getElementById('toastTitle');
                var msgEl   = document.getElementById('toastMessage');
                var timeEl  = document.getElementById('toastTime');
                var iconEl  = document.getElementById('toastIcon');

                if (titleEl) titleEl.textContent = item.title || 'Thông báo mới';
                if (msgEl)   msgEl.textContent   = item.message || '';
                if (timeEl)  timeEl.innerHTML     = '<i class="bi bi-clock me-1"></i>' + (item.timeAgo || 'Vừa xong');
                if (iconEl)  iconEl.className     = 'bi ' + (item.categoryIcon || 'bi-bell-fill');

                if (toastProgress) {
                    toastProgress.classList.remove('animate-progress');
                    void toastProgress.offsetWidth;
                    toastProgress.classList.add('animate-progress');
                    toastProgress.style.animationPlayState = 'running';
                }

                void liveToastEl.offsetWidth;
                liveToastEl.classList.add('show');

                if (liveToastTimer) clearTimeout(liveToastTimer);
                liveToastTimer = setTimeout(fadeOutLiveToast, 5000);
            }

            function fadeOutLiveToast() {
                if (!liveToastEl || !liveToastEl.classList.contains('show')) return;
                liveToastEl.classList.add('fading-out');
                liveToastEl.classList.remove('show');
                setTimeout(function() {
                    if (liveToastEl.classList.contains('fading-out')) {
                        liveToastEl.classList.add('d-none');
                        liveToastEl.classList.remove('fading-out');
                    }
                }, 800);
            }

            function hideLiveToastImmediately() {
                if (liveToastTimer) clearTimeout(liveToastTimer);
                if (!liveToastEl) return;
                liveToastEl.classList.remove('show', 'fading-out');
                liveToastEl.classList.add('d-none');
            }

            if (liveToastEl) {
                liveToastEl.addEventListener('mouseenter', function() {
                    if (liveToastTimer) clearTimeout(liveToastTimer);
                    liveToastEl.classList.remove('fading-out');
                    liveToastEl.classList.add('show');
                    if (toastProgress) toastProgress.style.animationPlayState = 'paused';
                });

                liveToastEl.addEventListener('mouseleave', function() {
                    if (toastProgress) toastProgress.style.animationPlayState = 'running';
                    if (liveToastTimer) clearTimeout(liveToastTimer);
                    liveToastTimer = setTimeout(fadeOutLiveToast, 2500);
                });

                liveToastEl.addEventListener('click', function(e) {
                    if (e.target.closest('#toastCloseBtn')) {
                        e.stopPropagation();
                        hideLiveToastImmediately();
                        return;
                    }

                    if (!currentToastItem) return;
                    var notifId = currentToastItem.id;
                    var link    = currentToastItem.linkUrl;
                    hideLiveToastImmediately();

                    var formData = new FormData();
                    formData.append('id', notifId);
                    formData.append('__RequestVerificationToken', getCsrfToken());

                    fetch('/Notification/MarkAsRead', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    }).then(function(res) { return res.json(); })
                    .then(function(resData) {
                        if (resData && typeof resData.remainingUnread === 'number') {
                            updateBadge(resData.remainingUnread);
                        }
                        window.location.href = link || '/Notification/Index';
                    }).catch(function() {
                        window.location.href = link || '/Notification/Index';
                    });
                });
            }

            // ── Khởi tạo: đồng bộ số đếm & kiểm tra hiện popup thông báo mới nhất ──
            function syncNotificationState(showToastIfNew) {
                fetch('/Notification/GetRecent', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data && typeof data.unreadCount === 'number') {
                        updateBadge(data.unreadCount);
                    }
                    if (showToastIfNew && data && data.items && data.items.length > 0) {
                        var latest = data.items[0];
                        var lastShownId = sessionStorage.getItem('gym_last_toast_id');
                        if (!latest.isRead && String(latest.id) !== lastShownId) {
                            sessionStorage.setItem('gym_last_toast_id', String(latest.id));
                            setTimeout(function() { showLiveToast(latest); }, 500);
                        }
                    }
                })
                .catch(function(err) { console.error('Notification sync error:', err); });
            }

            function renderItem(item) {
                var bgMap = {
                    'Success': 'bg-success bg-opacity-10 text-success',
                    'Warning': 'bg-warning bg-opacity-10 text-warning',
                    'Danger':  'bg-danger bg-opacity-10 text-danger'
                };
                var bgClass = bgMap[item.type] || 'bg-light text-secondary';

                return '<div class="notification-item ' + (!item.isRead ? 'unread' : '') + '" data-id="' + item.id + '" data-link="' + (item.linkUrl || '') + '">' +
                       '  <div class="notification-icon-box ' + bgClass + '"><i class="bi ' + (item.categoryIcon || 'bi-bell') + '"></i></div>' +
                       '  <div class="flex-grow-1 overflow-hidden">' +
                       '    <div class="notification-item-title">' + escapeHtml(item.title) + '</div>' +
                       '    <div class="notification-item-desc">' + escapeHtml(item.message) + '</div>' +
                       '    <div class="notification-item-time"><i class="bi bi-clock me-1"></i>' + (item.timeAgo || 'Vừa xong') + '</div>' +
                       '  </div>' +
                       (!item.isRead ? '  <span class="unread-dot" title="Chưa đọc"></span>' : '') +
                       '</div>';
            }

            function loadRecentNotifications() {
                if (!listEl) return;
                listEl.innerHTML = '<div class="text-center py-4 text-muted small"><div class="spinner-border spinner-border-sm text-secondary mb-1"></div><div>Đang tải thông báo...</div></div>';

                fetch('/Notification/GetRecent', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    updateBadge(data.unreadCount || 0);

                    if (!data.items || data.items.length === 0) {
                        listEl.innerHTML = '<div class="text-center py-4 text-muted small"><i class="bi bi-bell-slash fs-3 d-block text-secondary mb-1"></i>Bạn chưa có thông báo nào</div>';
                        return;
                    }

                    listEl.innerHTML = data.items.map(renderItem).join('');
                    bindItemClicks();
                })
                .catch(function() {
                    listEl.innerHTML = '<div class="text-center py-3 text-danger small">Không thể tải thông báo</div>';
                });
            }

            function bindItemClicks() {
                listEl.querySelectorAll('.notification-item').forEach(function(el) {
                    el.addEventListener('click', function(e) {
                        e.preventDefault();
                        var id     = this.getAttribute('data-id');
                        var link   = this.getAttribute('data-link');
                        var isUnread = this.classList.contains('unread');

                        if (isUnread) {
                            var formData = new FormData();
                            formData.append('id', id);
                            formData.append('__RequestVerificationToken', getCsrfToken());

                            fetch('/Notification/MarkAsRead', {
                                method: 'POST',
                                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                                body: formData
                            }).then(function(res) { return res.json(); })
                            .then(function(resData) {
                                if (resData && typeof resData.remainingUnread === 'number') {
                                    updateBadge(resData.remainingUnread);
                                }
                                window.location.href = link || '/Notification/Index';
                            }).catch(function() {
                                window.location.href = link || '/Notification/Index';
                            });
                        } else {
                            window.location.href = link || '/Notification/Index';
                        }
                    });
                });
            }

            function escapeHtml(str) {
                if (!str) return '';
                var div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            if (dropdownEl) {
                dropdownEl.addEventListener('show.bs.dropdown', function() {
                    hideLiveToastImmediately();
                    loadRecentNotifications();
                });
            }

            if (markAllBtn) {
                markAllBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    var formData = new FormData();
                    formData.append('__RequestVerificationToken', getCsrfToken());

                    fetch('/Notification/MarkAllAsRead', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    })
                    .then(function(res) { return res.json(); })
                    .then(function() {
                        updateBadge(0);
                        hideLiveToastImmediately();
                        loadRecentNotifications();
                    });
                });
            }

            // Đồng bộ ban đầu
            syncNotificationState(true);

            // ── SignalR real-time connection ────────────────────────────
            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/notification')
                .withAutomaticReconnect()
                .build();

            var receivedItemIds = new Set();

            connection.on('ReceiveNotification', function(item) {
                if (item && item.id) {
                    if (receivedItemIds.has(item.id)) return;
                    receivedItemIds.add(item.id);
                }

                currentUnread++;
                updateBadge(currentUnread);
                bumpBadge();

                showLiveToast(item);
                if (item && item.id) {
                    sessionStorage.setItem('gym_last_toast_id', String(item.id));
                }

                var dropdownMenu = document.querySelector('.notification-dropdown-panel');
                if (dropdownMenu && dropdownMenu.classList.contains('show')) {
                    var emptyEl = listEl.querySelector('.text-muted');
                    if (emptyEl && listEl.querySelectorAll('.notification-item').length === 0) {
                        listEl.innerHTML = '';
                    }
                    var tempDiv = document.createElement('div');
                    tempDiv.innerHTML = renderItem(item);
                    listEl.prepend(tempDiv.firstElementChild);
                    bindItemClicks();
                }
            });

            function startSignalR() {
                connection.start().catch(function(err) {
                    console.warn('[Notification] SignalR lỗi kết nối:', err);
                    setTimeout(startSignalR, 5000);
                });
            }

            connection.onreconnected(function() {
                syncNotificationState(false);
            });

            startSignalR();
        });
    </script>
}
