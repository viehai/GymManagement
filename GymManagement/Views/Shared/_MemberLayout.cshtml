<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Khám phá và tìm kiếm phòng Gym phù hợp với bạn — GymPro, hệ thống quản lý phòng Gym chuyên nghiệp." />
    <title>@ViewData["Title"] - GymPro</title>

    <!-- Bootstrap 5 CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />

    <style>
        /* ═══════════════════════════════════════════════
           MEMBER LAYOUT — INK WASH PALETTE
           #252525  Xám than   → chữ chính / nút CTA
           #545454  Xám đậm    → hover / icon
           #7D7D7D  Xám trung  → văn bản phụ / placeholder
           #CFCFCF  Xám nhạt  → viền / đường kẻ / nền search
           #FFFFFF  Trắng      → nền trang
        ═══════════════════════════════════════════════ */

        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --ink-dark:    #252525;
            --ink-medium:  #545454;
            --ink-neutral: #7D7D7D;
            --ink-light:   #CFCFCF;
            --ink-white:   #FFFFFF;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--ink-white);
            color: var(--ink-dark);
            -webkit-font-smoothing: antialiased;
            margin: 0;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
        }

        /* ── Announcement bar ── */
        .member-announcement {
            background: var(--ink-dark);
            color: var(--ink-white);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-align: center;
            padding: 0.55rem 1rem;
        }

        /* ── Navbar ── */
        .member-navbar {
            background: var(--ink-white);
            border-bottom: 1px solid var(--ink-light);
            padding: 0;
        }
        .member-navbar .navbar-brand {
            font-family: 'Montserrat', sans-serif;
            font-weight: 900;
            font-size: 1.3rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--ink-dark) !important;
        }
        .member-navbar .nav-link {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--ink-dark) !important;
            padding: 1.5rem 0.9rem !important;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s, color 0.2s;
        }
        .member-navbar .nav-link:hover {
            color: var(--ink-medium) !important;
            border-bottom-color: var(--ink-dark);
        }
        .member-navbar .nav-link.active { border-bottom-color: var(--ink-dark); }

        /* CTA nav button — Đăng Ký
           Dùng selector đủ mạnh để ghi đè .member-navbar .nav-link (padding 1.5rem) */
        .member-navbar .nav-link.btn-nav-cta,
        .member-navbar .nav-link.btn-nav-register {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            background: var(--ink-dark) !important;
            color: var(--ink-white) !important;
            border: 1px solid var(--ink-dark) !important;
            padding: 0.48rem 1.2rem !important;
            border-bottom: 1px solid var(--ink-dark) !important;
            border-radius: 0 !important;
            transition: background 0.2s;
        }
        .member-navbar .nav-link.btn-nav-cta:hover,
        .member-navbar .nav-link.btn-nav-register:hover {
            background: var(--ink-medium) !important;
            border-color: var(--ink-medium) !important;
            border-bottom-color: var(--ink-medium) !important;
        }

        /* Logout nav button */
        .member-navbar .nav-link.btn-nav-logout {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            background: transparent !important;
            color: var(--ink-dark) !important;
            border: 1px solid var(--ink-light) !important;
            padding: 0.45rem 0.9rem !important;
            border-bottom: 1px solid var(--ink-light) !important;
            border-radius: 0 !important;
            transition: border-color 0.2s;
        }
        .member-navbar .nav-link.btn-nav-logout:hover {
            border-color: var(--ink-dark) !important;
            border-bottom-color: var(--ink-dark) !important;
        }

        .nav-user-name {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 1px;
            color: var(--ink-neutral) !important;
        }

        /* ── Footer ── */
        .member-footer {
            background: var(--ink-dark);
            color: rgba(255,255,255,0.5);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.65rem;
            font-weight: 500;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 2.5rem 0;
            margin-top: 5rem;
        }
        .member-footer a { color: rgba(255,255,255,0.5); text-decoration: none; }
        .member-footer a:hover { color: var(--ink-white); }
        .footer-brand {
            font-size: 1.1rem;
            font-weight: 900;
            letter-spacing: 4px;
            color: var(--ink-white);
            display: block;
            margin-bottom: 0.5rem;
        }

        @@media (max-width: 768px) {
            .member-navbar .nav-link { padding: 0.8rem 0.5rem !important; border-bottom: none; }
        }
    </style>

    @await RenderSectionAsync("Head", required: false)
</head>
<body>

    <!-- Announcement bar -->
    <div class="member-announcement">
        Khám phá hàng trăm phòng Gym &nbsp;|&nbsp; Đăng ký thành viên — Ưu đãi tháng đầu
    </div>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-md member-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">GYMPRO</a>
                <button class="navbar-toggler border-0 shadow-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#memberNav"
                        aria-controls="memberNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-4" style="color:var(--ink-dark);"></i>
                </button>
                <div class="collapse navbar-collapse" id="memberNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gym" ? "active" : "")"
                               asp-controller="Gym" asp-action="Search">Tìm Phòng Gym</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-md-0 align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                                       asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-shield-lock me-1"></i>Admin
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Owner"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "OwnerGym" ? "active" : "")"
                                       asp-controller="OwnerGym" asp-action="Index">
                                        <i class="bi bi-building me-1"></i>Quản lý Gym
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Member" ? "active" : "")"
                                       asp-controller="Member" asp-action="Profile">
                                        <i class="bi bi-person-circle me-1"></i>Cá nhân
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <span class="nav-link nav-user-name">
                                    <i class="bi bi-person me-1"></i>@User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                    <button type="submit" class="nav-link btn-nav-logout">Đăng Xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng Nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-nav-register" asp-controller="Account" asp-action="Register">Đăng Ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="member-footer">
        <div class="container text-center">
            <span class="footer-brand">GYMPRO</span>
            <p class="mb-1">&copy; @DateTime.Now.Year GymPro Management &nbsp;&mdash;&nbsp; All rights reserved</p>
            <a asp-controller="Home" asp-action="Privacy">Chính Sách Bảo Mật</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
