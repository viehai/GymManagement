<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hệ thống quản lý phòng Gym chuyên nghiệp — Đăng ký thành viên, quản lý lịch tập và gói dịch vụ." />
    <title>@ViewData["Title"] - GymPro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymManagement.styles.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: #fff;
            color: #111;
            font-weight: 400;
            -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
        }
        /* ── Announcement bar ── */
        .announcement-bar {
            background: #000;
            color: #fff;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-align: center;
            padding: 0.55rem 0;
        }
        /* ── Navbar ── */
        .site-navbar {
            background: #fff;
            border-bottom: 1px solid #e8e8e8;
            padding: 0;
        }
        .site-navbar .navbar-brand {
            font-family: 'Montserrat', sans-serif;
            font-weight: 900;
            font-size: 1.3rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #000 !important;
        }
        .site-navbar .nav-link {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #111 !important;
            padding: 1.5rem 0.9rem !important;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s;
        }
        .site-navbar .nav-link:hover { border-bottom-color: #000; }
        .site-navbar .nav-link.active { border-bottom-color: #000; }
        .site-navbar .nav-link.btn-nav-register {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            background: #000 !important;
            color: #fff !important;
            border: 1px solid #000;
            padding: 0.5rem 1.2rem !important;
            border-radius: 4px;
            border-bottom: 1px solid #000 !important;
            transition: background 0.2s, color 0.2s;
        }
        .site-navbar .nav-link.btn-nav-register:hover {
            background: #333 !important;
            color: #fff !important;
            border-bottom-color: #333 !important;
        }
        .nav-user-name {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 1px;
            color: #555 !important;
        }
        .site-navbar .nav-link.btn-nav-logout {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            background: transparent !important;
            color: #111 !important;
            border: 1px solid #ccc;
            padding: 0.45rem 0.9rem !important;
            border-radius: 4px;
            border-bottom: 1px solid #ccc !important;
            transition: border-color 0.2s, color 0.2s;
        }
        .site-navbar .nav-link.btn-nav-logout:hover {
            border-color: #000;
            border-bottom-color: #000 !important;
        }
        /* ── Footer ── */
        .site-footer {
            background: #000;
            color: rgba(255,255,255,0.55);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.65rem;
            font-weight: 500;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 2.5rem 0;
            margin-top: 4rem;
        }
        .site-footer a { color: rgba(255,255,255,0.55); text-decoration: none; }
        .site-footer a:hover { color: #fff; }
        .footer-brand {
            font-size: 1.1rem;
            font-weight: 900;
            letter-spacing: 4px;
            color: #fff;
            display: block;
            margin-bottom: 0.5rem;
        }
    </style>
</head>
<body>

    <div class="announcement-bar">
        Miễn phí tham quan cơ sở &nbsp;|&nbsp; Đăng ký ngay hôm nay — Nhận ưu đãi tháng đầu
    </div>

    <header>
        <nav class="navbar navbar-expand-md site-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    GYMPRO
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-4 text-dark"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-md-0 align-items-center gap-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link nav-user-name">
                                    <i class="bi bi-person me-1"></i>@User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                    <button type="submit" class="nav-link btn-nav-logout">
                                        Đăng Xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng Nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-nav-register" asp-controller="Account" asp-action="Register">
                                    Đăng Ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container text-center">
            <span class="footer-brand">GYMPRO</span>
            <p class="mb-1">&copy; @DateTime.Now.Year GymPro Management &nbsp;&mdash;&nbsp; All rights reserved</p>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Chính Sách Bảo Mật</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
